<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Syncro.Desktop"
             xmlns:components="clr-namespace:Syncro.Desktop.Components"
             xmlns:pages="clr-namespace:Syncro.Desktop.Components.Pages.Auth"
             x:Class="Syncro.Desktop.LoginPage"
             Title="Login">

    <BlazorWebView HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type pages:Login}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>