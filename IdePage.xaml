<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ide="clr-namespace:Syncro.Desktop.Components.IDE"
             x:Class="Syncro.Desktop.IdePage"
             Title="Syncro Editor">

    <BlazorWebView x:Name="Bvw" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ide:IdeRoot}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
