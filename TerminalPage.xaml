<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Syncro.Desktop"
             xmlns:shared="clr-namespace:Syncro.Desktop.Components.Shared"
             x:Class="Syncro.Desktop.TerminalPage"
             Title="Syncro Terminal">

    <BlazorWebView HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type shared:SyncroTerminal}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
