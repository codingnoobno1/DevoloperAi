@using Syncro.Desktop.Components.Shared
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject Syncro.Desktop.Services.Ide.IdeWindowService IdeWin

<div class="sidebar-logo px-4 py-4 d-flex align-items-center gap-3">
    <div class="brand-icon" style="width: 32px; height: 32px; border-radius: 8px; background: var(--mud-palette-primary); display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(14, 165, 233, 0.4);">
        <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Color="Color.Surface" Size="Size.Small" />
    </div>
    <span style="font-weight: 700; font-size: 16px; letter-spacing: -0.01em; color: var(--mud-palette-text-primary);">SYNCRO AI</span>
</div>

<div class="px-4 py-2 mb-2">
    <MudButton Variant="Variant.Filled" 
               Color="Color.Primary" 
               FullWidth="true" 
               StartIcon="@Icons.Material.Filled.Add" 
               OnClick="CreateNewProject"
               Style="font-weight: 600; text-transform: none; border-radius: 8px; box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);">
        New Project
    </MudButton>
</div>

<div class="nav-scroll-area" style="overflow-y: auto; height: calc(100vh - 160px);">
    <MudNavMenu Color="Color.Primary" Bordered="false" Margin="Margin.Normal">
        
        <MudNavGroup Title="WORKSPACE" Expanded="true" Icon="@Icons.Material.Filled.Workspaces">
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="agent-tasks" Icon="@Icons.Material.Filled.AssignmentInd">AI Tasks</MudNavLink>
            <MudNavLink Href="myprojects" Icon="@Icons.Material.Filled.Folder">Projects</MudNavLink>
            <MudNavLink Href="gitmanager" Icon="@Icons.Material.Filled.Source">Repository</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="DEVELOPMENT" Expanded="false" Icon="@Icons.Material.Filled.DeveloperMode">
            <MudNavLink OnClick="OpenSyncroIde" Icon="@Icons.Material.Filled.Code">Editor</MudNavLink>
            <MudNavLink Href="clitalk" Icon="@Icons.Material.Filled.Terminal">Terminal</MudNavLink>
            <MudNavLink Href="universe-connector" Icon="@Icons.Material.Filled.Hub">Connector</MudNavLink>
            <MudNavLink Href="runtime" Icon="@Icons.Material.Filled.MonitorHeart">Runtime</MudNavLink>
            <MudNavLink OnClick="OpenMobileStore" Icon="@Icons.Material.Filled.PhoneAndroid">Mobile Toolkit</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="INTELLIGENCE" Expanded="false" Icon="@Icons.Material.Filled.Psychology">
            <MudNavLink Href="ast-dashboard" Icon="@Icons.Material.Filled.AccountTree">Architecture</MudNavLink>
            <MudNavLink Href="hindsight" Icon="@Icons.Material.Filled.MenuBook">Knowledge</MudNavLink>
            <MudNavLink OnClick="OpenAnalysis" Icon="@Icons.Material.Filled.Analytics">Insights</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="ECOSYSTEM" Expanded="false" Icon="@Icons.Material.Filled.Language">
            <MudNavLink Href="meetingsandtarget" Icon="@Icons.Material.Filled.CalendarMonth">Planning</MudNavLink>
            <MudNavLink Href="social" Icon="@Icons.Material.Filled.People">Community</MudNavLink>
            <MudNavLink Href="marketplace" Icon="@Icons.Material.Filled.Extension">Extensions</MudNavLink>
        </MudNavGroup>

    </MudNavMenu>
</div>

@code {
    private async Task CreateNewProject()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateProjectDialog>("Create New Project", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            Nav.NavigateTo("myprojects");
        }
    }

    private void OpenSyncroIde() => IdeWin.Open();

    private void OpenAnalysis() => IdeWin.OpenAnalysis();

    private void OpenMobileStore()
    {
        MainThread.BeginInvokeOnMainThread(() => {
            if (Application.Current != null)
            {
                var storeWindow = new Window(new MobileMarketplacePage()) 
                { 
                    Title = "Mobile Toolkit",
                    Width = 1200,
                    Height = 850
                };
                Application.Current.OpenWindow(storeWindow);
            }
        });
    }
}

<style>
    /* Clean Enterprise Sidebar Styling */
    .nav-scroll-area::-webkit-scrollbar {
        width: 6px;
    }
    .nav-scroll-area::-webkit-scrollbar-track {
        background: transparent;
    }
    .nav-scroll-area::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,0.1);
        border-radius: 10px;
    }
    .nav-scroll-area::-webkit-scrollbar-thumb:hover {
        background: rgba(0,0,0,0.2);
    }

    /* Customize MudNavGroup padding for a tighter enterprise feel */
    .mud-nav-group > .mud-nav-link {
        font-weight: 600 !important;
        font-size: 13px !important;
        color: var(--mud-palette-text-secondary) !important;
    }
</style>
