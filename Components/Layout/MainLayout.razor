@inherits LayoutComponentBase
@using Syncro.Desktop.Components.Shared
@using Syncro.Desktop.Services
@inject NetlifyService NetlifySvc

<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <div class="page">
        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Class="arc-sidebar" ClipMode="DrawerClipMode.Never" Variant="@DrawerVariant.Responsive">
            <NavMenu />
        </MudDrawer>

        <main>
            <header class="app-header">
                <div class="header-left">
                    <button class="icon-btn me-3" @onclick="DrawerToggle" title="Toggle Sidebar">
                        <i class="bi bi-list" style="font-size: 24px;"></i>
                    </button>
                    <div class="project-title-container">
                        <h1 class="project-title">Project Syncro</h1>
                        <span class="project-subtitle">Active Workspace</span>
                    </div>
                </div>

                <div class="header-right">
                    <div class="status-pills">
                        <div class="status-pill success frosted-glass">
                            <span class="dot pulse"></span>
                            <span>CLI Ready</span>
                        </div>
                        <div class="status-pill success frosted-glass">
                            <span class="dot pulse"></span>
                            <span>API Online</span>
                        </div>
                        <div class="status-pill primary frosted-glass">
                            <i class="bi bi-lightning-charge-fill me-1"></i>
                            <span>Local Engine</span>
                        </div>
                    </div>
                    
                    <div class="divider"></div>
                    
                    <button class="icon-btn frosted-glass" title="Notifications">
                        <i class="bi bi-bell"></i>
                    </button>
                    
                    <button class="icon-btn frosted-glass" @onclick="OpenTerminal" title="Syncro Terminal">
                        <i class="bi bi-terminal"></i>
                    </button>

                    <div class="divider"></div>
                    
                    <div class="user-profile frosted-glass">
                        <div class="avatar">
                            <img src="images/syncro.jpg" alt="User" />
                        </div>
                        <div class="user-info">
                            <span class="user-name">Tushar</span>
                            <span class="user-role">Admin</span>
                        </div>
                    </div>
                </div>
            </header>

            <article class="content">
                <MudMainContent Class="content-panel-mud">
                    @Body
                </MudMainContent>
            </article>
        </main>
    </div>
</MudLayout>


@code {
    private MudTheme _theme = new();
    private NetlifySite? _netlifySite;
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        _theme = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
                Primary = "#0EA5E9",
                Secondary = "#8B5CF6", // AI Purple
                Background = "#F7F9FC",
                Surface = "#FFFFFF",
                AppbarBackground = "rgba(255, 255, 255, 0.8)",
                DrawerBackground = "rgba(255, 255, 255, 0.8)",
                TextPrimary = "#0F172A",
                TextSecondary = "#475569",
                LinesDefault = "#E2E8F0",
                TableLines = "#E2E8F0",
                Divider = "#E2E8F0",
                ActionDefault = "#64748B",
                Success = "#10B981",
                Warning = "#F59E0B",
                Error = "#EF4444"
            }
        };

        // Fetch Netlify Status
        _netlifySite = await NetlifySvc.GetSiteStatus("project-syncroo");
    }

    private void OpenTerminal()
    {
        try
        {
            string? processPath = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "syncro-cli.exe");
            if (System.IO.File.Exists(processPath))
            {
                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = processPath,
                    UseShellExecute = true, // Launch in separate console window
                    CreateNoWindow = false
                };
                System.Diagnostics.Process.Start(psi);
            }
            else
            {
                // Fallback to MAUI window if executable is missing
                MainThread.BeginInvokeOnMainThread(() => {
                    if (Application.Current != null)
                    {
                        var terminalWindow = new Window(new TerminalPage()) 
                        { 
                            Title = "Syncro Terminal",
                            Width = 900,
                            Height = 600
                        };
                        Application.Current.OpenWindow(terminalWindow);
                    }
                });
            }
        }
        catch (Exception)
        {
            // Fallback to MAUI window on error
            MainThread.BeginInvokeOnMainThread(() => {
                if (Application.Current != null)
                {
                    var terminalWindow = new Window(new TerminalPage()) 
                    { 
                        Title = "Syncro Terminal",
                        Width = 900,
                        Height = 600
                    };
                    Application.Current.OpenWindow(terminalWindow);
                }
            });
        }
    }

    private void OpenMobileStore()
    {
        MainThread.BeginInvokeOnMainThread(() => {
            if (Application.Current != null)
            {
                var storeWindow = new Window(new MobileMarketplacePage()) 
                { 
                    Title = "Syncro Mobile Store",
                    Width = 1100,
                    Height = 800
                };
                Application.Current.OpenWindow(storeWindow);
            }
        });
    }
}

<style>
    :root {
        --header-height: 72px;
        --border-subtle: rgba(226, 232, 240, 0.8);
        --bg-panel: rgba(255, 255, 255, 0.75);
        --bg-main: #F7F9FC;
        --text-primary: #0F172A;
        --text-secondary: #475569;
        --text-muted: #94A3B8;
        --accent-primary: #0EA5E9;
        --accent-purple: #8B5CF6;
        --status-success: #10B981;
        --status-warning: #F59E0B;
    }

    .page {
        display: flex;
        height: 100vh;
        background-color: var(--bg-main);
        font-family: 'Inter', sans-serif;
    }

    main {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .app-header {
        height: var(--header-height);
        background: var(--glass-bg);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border-bottom: 1px solid rgba(255,255,255,0.4);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        z-index: 10;
        box-shadow: 0 4px 24px rgba(0,0,0,0.02);
    }

    .header-left {
        display: flex;
        align-items: center;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .project-title-container {
        display: flex;
        flex-direction: column;
    }

    .project-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
        letter-spacing: -0.01em;
    }

    .project-subtitle {
        font-size: 12px;
        font-weight: 500;
        color: var(--text-secondary);
        margin-top: 2px;
    }

    .divider {
        width: 1px;
        height: 24px;
        background: var(--border-subtle);
    }

    .status-pills {
        display: flex;
        gap: 12px;
    }

    .status-pill {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: var(--radius-lg);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.02em;
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        box-shadow: var(--shadow-soft);
        color: var(--text-secondary);
        transition: all 0.2s;
    }
    
    .status-pill:hover {
        transform: translateY(-1px);
        box-shadow: var(--shadow-hover);
    }

    .pulse {
        animation: pulse-animation 2s infinite;
    }

    @@keyframes pulse-animation {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
        70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .status-pill.success { color: var(--status-success); border-color: rgba(16, 185, 129, 0.2); background: rgba(16, 185, 129, 0.05); }
    .status-pill.success .dot { background: var(--status-success); }
    
    .status-pill.warning { color: var(--status-warning); border-color: rgba(245, 158, 11, 0.2); background: rgba(245, 158, 11, 0.05); }
    .status-pill.warning .dot { background: var(--status-warning); }

    .status-pill.primary { color: var(--accent-primary); border-color: rgba(14, 165, 233, 0.2); background: rgba(14, 165, 233, 0.05); }

    .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .icon-btn {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        box-shadow: var(--shadow-soft);
        color: var(--text-secondary);
        font-size: 16px;
        cursor: pointer;
        padding: 10px;
        border-radius: var(--radius-md);
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-btn:hover {
        background: #FFFFFF;
        color: var(--text-primary);
        box-shadow: var(--shadow-hover);
        transform: translateY(-1px);
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        padding: 4px 16px 4px 4px;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
        transition: all 0.2s;
    }
    
    .user-profile:hover {
        background: #FFFFFF;
        box-shadow: var(--shadow-hover);
        transform: translateY(-1px);
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid #FFFFFF;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .user-info {
        display: flex;
        flex-direction: column;
    }

    .user-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .user-role {
        font-size: 11px;
        font-weight: 500;
        color: var(--text-muted);
    }

    .content {
        flex: 1;
        background: var(--bg-main);
        padding: 32px;
        overflow-y: auto;
    }

    .content-panel-mud {
        /* No longer a boxed panel, letting inner elements handle their own cards */
        flex: 1;
        background: transparent;
        border: none;
        border-radius: 0;
        padding: 0 !important;
        box-shadow: none;
    }
</style>
