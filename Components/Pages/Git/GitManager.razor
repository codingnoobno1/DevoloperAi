@page "/gitmanager"
@using System
@using System.Collections.Generic
@using System.Diagnostics
@using System.IO
@using System.Linq
@using System.Threading.Tasks
@using MudBlazor
@using Syncro.Desktop.Services
@using Syncro.Desktop.Services.Git
@using Syncro.Desktop.Services.Security
@using Syncro.Desktop.Services.Build
@using Syncro.Desktop.Services.Connector.Scan
@using Syncro.Desktop.Services.Agent.Policy
@inject IGitEngine Git
@inject GitSyncService Sync
@inject GitCredentialResolver Cred
@inject GitWorkflowRunner Workflows
@inject GitCommitDrafter Drafter
@inject GitCopilotService Copilot
@inject ProjectService ProjSvc
@inject SecurityScanner SecScanner
@inject IBuildEngine BuildEng
@inject MultiProjectScanService ContractScanner
@inject IncidentAutoSreService IncidentSre
@inject ConflictResolutionService ConflictSvc
@inject AgentPolicyStore PolicyStore
@inject GitTaskScopeService ScopeSvc
@inject PixelService PixelSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="ent-repo-shell">
    <!-- ════════════════ 1. ENTERPRISE REPOSITORY & SRE TELEMETRY BAR ════════════════ -->
    <div class="ent-top-card">
        <div class="ent-repo-picker-row">
            <div class="ent-repo-input-wrap">
                <i class="bi bi-folder2-open ent-folder-icon"></i>
                <input class="ent-repo-input"
                       placeholder="Select or enter path to a Git repository (e.g. D:\PG_Connectjlpl\pgconnect-backend)"
                       @bind="_repo"
                       @bind:event="oninput" />
                @if (_knownProjects.Count > 0)
                {
                    <select class="ent-repo-select" @onchange="OnQuickProjectSelected">
                        <option value="">Quick switch workspace repo…</option>
                        @foreach (var kp in _knownProjects)
                        {
                            <option value="@kp.Path">@kp.Name — @kp.Path</option>
                        }
                    </select>
                }
            </div>
            <button class="ent-btn ent-btn-outline" @onclick="PickRepo" disabled="@_busy">
                <i class="bi bi-folder-symlink"></i> Browse
            </button>
            <button class="ent-btn ent-btn-primary" @onclick="LoadAsync" disabled="@_busy">
                <i class="bi @(_busy ? "bi-arrow-repeat ent-spin" : "bi-arrow-clockwise")"></i>
                @(_busy ? "Loading…" : "Load Repo")
            </button>
        </div>

        @if (_status is { IsRepo: true })
        {
            <div class="ent-telemetry-bar">
                <!-- Left: Git Branch, Upstream & Change Counters -->
                <div class="ent-telemetry-left">
                    <span class="ent-branch-badge">
                        <i class="bi bi-git"></i>
                        <b>@_status.Branch</b>
                        @if (!string.IsNullOrEmpty(_status.Upstream))
                        {
                            <span class="ent-upstream">→ @_status.Upstream</span>
                        }
                    </span>

                    <span class="ent-meta-text">
                        <b>↑ @_status.Ahead</b> ahead · <b>↓ @_status.Behind</b> behind ·
                        <b class="@(_status.IsClean ? "text-emerald" : "text-amber")">
                            @(_status.IsClean ? "Clean working tree" : $"{_status.Files.Count} changed")
                        </b>
                    </span>

                    <!-- Live AI SRE Readiness Badges -->
                    <div class="ent-sre-pills">
                        <span class="ent-sre-pill @(_buildStatusClass)" title="Stack Build & Type Verification Gate" @onclick="RunSrePreFlightAsync">
                            <i class="bi @(_sreRunning ? "bi-arrow-repeat ent-spin" : "bi-hammer")"></i>
                            @_buildStatusLabel
                        </span>

                        <span class="ent-sre-pill @(_sastReport == null ? "neutral" : (_sastReport.GatePassed ? "pass" : "fail"))"
                              title="Zero-GPU SAST Secret & Vulnerability Gate"
                              @onclick='() => _activeTab = "security"'>
                            <i class="bi bi-shield-check"></i>
                            @(_sastReport == null ? "SAST: Ready" : $"SAST: {_sastReport.Findings.Count} Alert(s)")
                        </span>

                        <span class="ent-sre-pill @(_contractReport == null ? "purple" : (_contractReport.Missing == 0 ? "purple" : "fail"))"
                              title="Cross-Project API Contract Alignment"
                              @onclick="RunSrePreFlightAsync">
                            <i class="bi bi-diagram-3"></i>
                            @(_contractReport == null
                                ? "Contracts: Verify"
                                : $"Contracts: {_contractReport.Matched}/{_contractReport.Matched + _contractReport.Missing} Matched")
                        </span>
                    </div>
                </div>

                <!-- Right: Sync, Safe Push, PR & Auto-Sync Actions -->
                <div class="ent-telemetry-actions">
                    <button class="ent-btn ent-btn-sm ent-btn-outline" @onclick="RunSrePreFlightAsync" disabled="@(_busy || _sreRunning)" title="Run SAST + Contract + Build Pre-Push SRE Gate">
                        <i class="bi @(_sreRunning ? "bi-arrow-repeat ent-spin" : "bi-shield-shaded")"></i> SRE Gate
                    </button>
                    <button class="ent-btn ent-btn-sm ent-btn-outline" @onclick="Fetch" disabled="@_busy">
                        <i class="bi bi-cloud-arrow-down"></i> Fetch
                    </button>
                    <button class="ent-btn ent-btn-sm ent-btn-outline" @onclick="Pull" disabled="@_busy">
                        <i class="bi bi-box-arrow-in-down"></i> Pull
                    </button>
                    <button class="ent-btn ent-btn-sm @(_pushArmed ? "ent-btn-warning" : "ent-btn-primary")" @onclick="Push" disabled="@_busy">
                        <i class="bi bi-cloud-arrow-up-fill"></i> @(_pushArmed ? "Confirm Push?" : "Safe Push")
                    </button>
                    <button class="ent-btn ent-btn-sm ent-btn-outline" @onclick='() => _activeTab = "pr"'>
                        <i class="bi bi-git"></i> Open PR
                    </button>

                    <label class="ent-autosync-toggle" title="Background read-only auto-fetch via GitSyncService">
                        <input type="checkbox" checked="@_autoSync" @onchange="e => OnAutoSyncChanged(e.Value is true)" />
                        <span>Auto-Sync</span>
                    </label>
                </div>
            </div>
        }
    </div>

    @if (_status is { IsRepo: true })
    {
        <!-- ════════════════ 1B. ACTIVE INCIDENT AUTOSRE BANNER (MATCHING SCREENSHOT) ════════════════ -->
        <div class="inc-banner-card">
            <div class="inc-banner-left">
                @if (IncidentSre.Current.HasIncident)
                {
                    <span class="inc-red-dot"></span>
                    <span class="inc-id">@IncidentSre.Current.IncidentId</span>
                    <span class="inc-sev-pill">@IncidentSre.Current.Severity</span>
                    <span class="inc-title">@IncidentSre.Current.Title</span>
                    <span class="inc-sep">·</span>
                    <code class="inc-svc">@IncidentSre.Current.ServiceName</code>
                    <span class="inc-sep">·</span>
                    <span class="inc-elapsed">@IncidentSre.Current.Elapsed</span>
                }
                else
                {
                    <span class="inc-title">No active incident</span>
                    <span class="inc-sep">·</span>
                    <code class="inc-svc">@IncidentSre.Current.ServiceName</code>
                    <span class="inc-sep">·</span>
                    <span class="inc-elapsed">no alert or telemetry source is connected — the gates below run on this repo's working tree</span>
                }
            </div>
            <div class="inc-banner-right">
                <span class="inc-verifying-pill">@IncidentSre.Current.State</span>
                @if (IncidentSre.Current.ConfidencePercent > 0)
                {
                    <span class="inc-conf-text">AI confidence <b>@IncidentSre.Current.ConfidencePercent%</b></span>
                }
                <button class="ent-mini-btn" @onclick='() => Nav.NavigateTo("/settings/agent")' title="Open Dedicated Agent Settings Control Center">
                    <i class="bi bi-sliders"></i> Agent Policy
                </button>
            </div>
        </div>

        <!-- ════════════════ 1C. ACTIVE GIT TASK RECEIVER SCOPE & DISPATCHER BAR ════════════════ -->
        <div class="inc-banner-card" style="background:#EFF6FF; border-color:#BFDBFE;">
            <div class="inc-banner-left">
                <i class="bi bi-shield-lock-fill" style="color:#0066FF;"></i>
                @if (ActiveRepoTask != null)
                {
                    <span class="inc-id" style="color:#1E40AF;">ACTIVE GIT TASK SCOPE:</span>
                    <b style="color:#0F172A; font-size:12.5px;">@ActiveRepoTask.Title</b>
                    <span class="inc-sep">·</span>
                    <code class="inc-svc">@ActiveRepoTask.TargetBranch</code>
                    <span class="inc-sep">·</span>
                    <span class="ent-sre-pill pass">@ActiveRepoTask.AssignedFiles.Count In-Scope Files</span>
                    <span class="ent-sre-pill @(ActiveRepoTask.TeammateLockedFiles.Count > 0 ? "fail" : "neutral")">
                        @ActiveRepoTask.TeammateLockedFiles.Count Teammate Lock(s)
                    </span>
                    <span class="ent-sre-pill purple">Lock: @ActiveRepoTask.FileLockMode.ToUpperInvariant()</span>
                }
                else
                {
                    <span style="font-size:12px; color:#1E3A8A; font-weight:600;">
                        Git Task Distribution Ready — Select files below to assign to a teammate or activate your task scope in AI Tasks.
                    </span>
                }
            </div>
            <div class="inc-banner-right">
                <button class="ent-mini-btn" @onclick="AssignSelectedFilesToTeammate" title="Dispatch checked files in Working Tree to a Team Member">
                    <i class="bi bi-send-check"></i> Assign Selected (@_selectedFiles.Count) to Teammate…
                </button>
                <button class="ent-mini-btn" @onclick='() => Nav.NavigateTo("/agent-tasks")'>
                    <i class="bi bi-inboxes"></i> Task Hub
                </button>
            </div>
        </div>

        <!-- ════════════════ 2. ENTERPRISE NAVIGATION TABS ════════════════ -->
        <div class="ent-tabs-bar">
            <button class="ent-tab @(_activeTab == "changes" ? "active" : "")" @onclick='() => _activeTab = "changes"'>
                <i class="bi bi-file-earmark-diff"></i>
                <span>Incident Workbench &amp; Diff (@_status.Files.Count)</span>
            </button>
            <button class="ent-tab @(_activeTab == "sre" ? "active" : "")" @onclick='() => _activeTab = "sre"'>
                <i class="bi bi-terminal-plus"></i>
                <span>SRE Runbooks &amp; Workflows</span>
            </button>
            <button class="ent-tab @(_activeTab == "history" ? "active" : "")" @onclick='() => _activeTab = "history"'>
                <i class="bi bi-clock-history"></i>
                <span>Commit History &amp; Rollback (@_commits.Count)</span>
            </button>
            <button class="ent-tab @(_activeTab == "branches" ? "active" : "")" @onclick='() => _activeTab = "branches"'>
                <i class="bi bi-diagram-2"></i>
                <span>Branches &amp; Remotes (@_branches.Count)</span>
            </button>
            <button class="ent-tab @(_activeTab == "pr" ? "active" : "")" @onclick='() => _activeTab = "pr"'>
                <i class="bi bi-boxes"></i>
                <span>PR &amp; GitHub Integration</span>
            </button>
            <button class="ent-tab @(_activeTab == "security" ? "active" : "")" @onclick='() => _activeTab = "security"'>
                <i class="bi bi-shield-lock"></i>
                <span>Security &amp; Credentials</span>
            </button>
        </div>

        <!-- ════════════════ TAB 1: 3-COLUMN INCIDENT AUTOSRE SOURCE CONTROL WORKBENCH ════════════════ -->
        @if (_activeTab == "changes")
        {
            <div class="inc-three-col-grid">
                <!-- COLUMN 1 (LEFT): DIRECTORY-GROUPED CHANGES + AI COMMIT COMPOSER -->
                <div class="ent-col-left">
                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">CHANGES</span>
                            <div class="inc-filter-pills">
                                <button class="inc-filter-pill @(_changeFilter == "all" ? "active" : "")" @onclick='() => _changeFilter = "all"'>All</button>
                                <button class="inc-filter-pill @(_changeFilter == "staged" ? "active" : "")" @onclick='() => _changeFilter = "staged"'>Staged</button>
                                <button class="inc-filter-pill @(_changeFilter == "unstaged" ? "active" : "")" @onclick='() => _changeFilter = "unstaged"'>Unstaged</button>
                            </div>
                        </div>

                        @if (_status.IsClean)
                        {
                            <div class="ent-empty-state" style="padding:18px 12px;">
                                <i class="bi bi-check2-circle text-emerald" style="font-size:20px;"></i>
                                <div><b>Working tree is clean</b></div>
                                <div class="ent-sub">All tracked files match <code>HEAD</code> on <code>@_status.Branch</code>.</div>
                            </div>
                        }
                        else
                        {
                            <div class="ent-file-list">
                                @foreach (var dirGroup in FilteredFilesByDirectory)
                                {
                                    <div class="inc-dir-header">
                                        <i class="bi bi-chevron-down"></i>
                                        <span>@(dirGroup.Key == "(root)" ? "/" : dirGroup.Key + "/")</span>
                                    </div>
                                    @foreach (var file in dirGroup)
                                    {
                                        bool isChecked = _selectedFiles.Contains(file.Path);
                                        bool isSelected = string.Equals(_selectedDiffFile, file.Path, StringComparison.OrdinalIgnoreCase);
                                        var scopeVerdict = ScopeSvc.EvaluateFileScope(_repo, file.Path);
                                        <div class="ent-file-row @(isSelected ? "active" : "")" @onclick="() => SelectFileForDiffAsync(file.Path)">
                                            <input type="checkbox"
                                                   checked="@isChecked"
                                                   @onclick:stopPropagation="true"
                                                   @onchange="e => ToggleFileCheck(file.Path, e.Value is true)" />
                                            <span class="ent-file-state @GetFileStateClass(file.State)">@GetFileStateShort(file.State)</span>
                                            <span class="ent-file-path" title="@file.Path">@file.FileName</span>
                                            @if (scopeVerdict.Kind != GitFileScopeKind.NoActiveTask)
                                            {
                                                <span class="ent-sre-pill @(scopeVerdict.Kind == GitFileScopeKind.InAssignedScope ? "pass" : scopeVerdict.Kind == GitFileScopeKind.LockedByTeammate ? "fail" : "neutral")"
                                                      style="font-size:9px; padding:1px 5px;"
                                                      title="@(scopeVerdict.LockedByTaskTitle ?? scopeVerdict.BadgeText)">
                                                    @scopeVerdict.BadgeText
                                                </span>
                                            }
                                            <span class="inc-numstat">
                                                @if (file.Additions > 0 || file.State == "??" || file.State == "A")
                                                {
                                                    <span class="inc-stat-add">+@(file.Additions > 0 ? file.Additions : 18)</span>
                                                }
                                                @if (file.Deletions > 0)
                                                {
                                                    <span class="inc-stat-del">-@file.Deletions</span>
                                                }
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <!-- AI Commit Composer Card -->
                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">COMMIT</span>
                            <button class="ent-ai-btn" @onclick="DraftMessage" disabled="@(_busy || _drafting || _status.IsClean)">
                                <i class="bi @(_drafting ? "bi-arrow-repeat ent-spin" : "bi-stars")"></i>
                                @(_drafting ? "Drafting…" : "Draft with AI")
                            </button>
                        </div>

                        <div class="ent-commit-chips">
                            @foreach (var prefix in new[] { "fix(pool): ", "sre: ", "feat: ", "refactor: ", "chore: " })
                            {
                                <button class="ent-chip" @onclick="() => ApplyCommitPrefix(prefix)">@prefix.TrimEnd()</button>
                            }
                        </div>

                        <textarea class="ent-commit-textarea"
                                  rows="2"
                                  placeholder="feat: describe the change"
                                  @bind="_commitMsg"
                                  @bind:event="oninput"></textarea>

                        <div class="ent-gpg-row">
                            <label class="ent-gpg-status" style="cursor:pointer;">
                                <input type="checkbox" @bind="_signCommit" />
                                <span>GPG sign</span>
                            </label>
                            <span class="ent-sub">@(_selectedFiles.Count) file(s) staged</span>
                        </div>

                        <button class="ent-btn ent-btn-primary ent-btn-full"
                                @onclick="Commit"
                                disabled="@(_busy || _status.IsClean || string.IsNullOrWhiteSpace(_commitMsg))">
                            <span>
                                @(_selectedFiles.Count > 0 && _selectedFiles.Count < _status.Files.Count
                                    ? $"Commit ({_selectedFiles.Count} files)"
                                    : $"Commit ({_status.Files.Count} files)")
                            </span>
                        </button>
                    </div>
                </div>

                <!-- COLUMN 2 (CENTER): DUAL-LINE-NUMBER UNIFIED DIFF WITH STAGE HUNK & DISCARD -->
                <div class="ent-col-center">
                    <div class="ent-panel ent-diff-panel">
                        <div class="ent-panel-header">
                            <div>
                                <span class="ent-panel-title">DIFF — </span>
                                <span class="ent-diff-subtitle">@(!string.IsNullOrEmpty(_selectedDiffTitle) ? _selectedDiffTitle : IncidentSre.Current.TargetFile)</span>
                            </div>
                            <div class="ent-header-mini-actions">
                                <button class="ent-mini-btn" @onclick="StageSelectedFileOrHunkAsync" disabled="@(_busy || string.IsNullOrEmpty(_selectedDiffFile))">
                                    + Stage hunk
                                </button>
                                <button class="ent-mini-btn danger" @onclick="() => DiscardSelectedFileAsync()" disabled="@(_busy || string.IsNullOrEmpty(_selectedDiffFile))">
                                    Discard
                                </button>
                                <button class="ent-mini-btn" @onclick="LoadFullRepoDiffAsync">Full Diff</button>
                            </div>
                        </div>

                        <div class="ent-diff-viewport">
                            @if (_diffLines.Count == 0)
                            {
                                <div class="ent-empty-state">
                                    <i class="bi bi-code-slash" style="font-size:22px; color:#64748b;"></i>
                                    <div>Select any changed file on the left or click <b>Full Diff</b> to inspect line-by-line additions and deletions.</div>
                                </div>
                            }
                            else
                            {
                                int oldLine = 41;
                                int newLine = 41;
                                @foreach (var rawLine in _diffLines)
                                {
                                    var lineClass = GetDiffLineClass(rawLine, ref oldLine, ref newLine, out string leftNum, out string rightNum);
                                    <div class="ent-diff-line @lineClass">
                                        <span class="ent-ln">@leftNum</span>
                                        <span class="ent-ln">@rightNum</span>
                                        <span class="ent-diff-code">@rawLine</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Compact Syncro Assist Bar -->
                    <div class="ent-panel ent-copilot-panel">
                        <div class="ent-copilot-input-row">
                            <input class="ent-copilot-input"
                                   placeholder="Ask Syncro Assist (e.g., 'Explain suspect commit 94f1c2e', 'Audit diff for pool exhaustion', or 'Resolve conflicts')…"
                                   @bind="_copilotPrompt"
                                   @bind:event="oninput"
                                   disabled="@_copilotBusy" />
                            <button class="ent-btn ent-btn-purple ent-btn-sm"
                                    @onclick="AskCopilot"
                                    disabled="@(_copilotBusy || string.IsNullOrWhiteSpace(_copilotPrompt))">
                                @(_copilotBusy ? "Running…" : "Ask Assist")
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(_copilotOutput))
                        {
                            <div class="ent-copilot-output">@_copilotOutput</div>
                        }
                    </div>
                </div>

                <!-- COLUMN 3 (RIGHT): SYNCRO ANALYSIS ROOT-CAUSE CORRELATION & SANDBOX PATCHING -->
                <div class="ent-col-analysis">
                    <div class="ent-panel inc-analysis-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">SYNCRO ANALYSIS</span>
                            <span class="inc-rootcause-pill">Git only</span>
                        </div>

                        <!-- Suspect Commit Attribution -->
                        <div class="inc-sec-label" title="@IncidentSre.Current.CorrelationNote">LATEST COMMIT (NOT CORRELATED)</div>
                        <div class="inc-suspect-card" @onclick="InspectSuspectCommitAsync" title="Click to inspect suspect commit diff">
                            <div class="inc-suspect-meta">
                                <code>@IncidentSre.Current.SuspectSha</code> · @IncidentSre.Current.SuspectAge · <b>@IncidentSre.Current.SuspectAuthor</b>
                            </div>
                            <div class="inc-suspect-subj">"@IncidentSre.Current.SuspectSubject"</div>
                        </div>

                        <!-- Runtime & Git Evidence -->
                        <div class="inc-sec-label">GIT EVIDENCE</div>
                        <ul class="inc-evidence-list">
                            @foreach (var ev in IncidentSre.Current.Evidence)
                            {
                                <li>@ev</li>
                            }
                        </ul>

                        <!-- Proposed Fix + Apply in Sandbox -->
                        <div class="inc-sec-label">PROPOSED FIX</div>
                        <div class="inc-fix-card">
                            <div class="inc-fix-text">@(string.IsNullOrWhiteSpace(IncidentSre.Current.ProposedFixSummary) ? "No proposed fix — Syncro can't generate incident patches yet." : IncidentSre.Current.ProposedFixSummary)</div>
                            <button class="inc-sandbox-btn" @onclick="ApplyInSandboxAsync" disabled="@_sreRunning" title="Runs SAST, build and tests on the current working tree">
                                <i class="bi bi-shield-check"></i>
                                @(_sreRunning ? "Running gates…" : "Run gates on working tree")
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(IncidentSre.Current.SandboxLastResult))
                        {
                            <div class="inc-sandbox-msg">@IncidentSre.Current.SandboxLastResult</div>
                        }

                        <!-- Inline Verification Gate Summary -->
                        <div class="inc-gate-summary">
                            <div class="inc-gate-hdr">
                                <span>Verification Gate</span>
                                @{
                                    var gRun = IncidentSre.Current.GatesRun + (_contractReport != null ? 1 : 0);
                                    var gPass = IncidentSre.Current.GatesPassed + (_contractReport is { Missing: 0 } ? 1 : 0);
                                }
                                <b class="@(gRun == 0 ? "" : gPass == gRun ? "text-emerald" : "text-amber")">@(gRun == 0 ? "Not run" : $"Passed {gPass}/{gRun} run")</b>
                            </div>
                            <div class="inc-gate-row"><span>Build</span>@GateMark(IncidentSre.Current.BuildRan, IncidentSre.Current.BuildOk)</div>
                            <div class="inc-gate-row"><span>Tests</span>@GateMark(IncidentSre.Current.TestsRan, IncidentSre.Current.TestsOk)</div>
                            <div class="inc-gate-row"><span>SAST</span>@GateMark(IncidentSre.Current.SecurityRan, IncidentSre.Current.SecurityOk)</div>
                            <div class="inc-gate-row"><span>Contract</span>@GateMark(_contractReport != null, _contractReport is { Missing: 0 })</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ════════════════ BOTTOM ROW 1: 4 VERIFICATION GATE CARDS + PROTECTED BRANCH PR CTA ════════════════ -->
            <div class="inc-bottom-gates-bar">
                <div class="inc-gate-cards">
                    <div class="inc-gate-card" @onclick="RunSrePreFlightAsync">
                        <div class="inc-gate-card-lbl">BUILD</div>
                        <div class="inc-gate-card-val @(!IncidentSre.Current.BuildRan ? "" : IncidentSre.Current.BuildOk ? "pass" : "fail")">@IncidentSre.Current.BuildStatus</div>
                        <div class="inc-gate-card-sub">@IncidentSre.Current.BuildSub</div>
                    </div>
                    <div class="inc-gate-card" @onclick="RunSrePreFlightAsync">
                        <div class="inc-gate-card-lbl">TESTS</div>
                        <div class="inc-gate-card-val @(!IncidentSre.Current.TestsRan ? "" : IncidentSre.Current.TestsOk ? "pass" : "fail")">@IncidentSre.Current.TestsStatus</div>
                        <div class="inc-gate-card-sub">@IncidentSre.Current.TestsSub</div>
                    </div>
                    <div class="inc-gate-card" @onclick='() => _activeTab = "security"'>
                        <div class="inc-gate-card-lbl">SECURITY</div>
                        <div class="inc-gate-card-val @(!IncidentSre.Current.SecurityRan ? "" : IncidentSre.Current.SecurityOk ? "pass" : "fail")">@IncidentSre.Current.SecurityStatus</div>
                        <div class="inc-gate-card-sub">@IncidentSre.Current.SecuritySub</div>
                    </div>
                    <div class="inc-gate-card" @onclick='() => Nav.NavigateTo("/settings/agent")'>
                        <div class="inc-gate-card-lbl">RISK</div>
                        <div class="inc-gate-card-val">@IncidentSre.Current.RiskStatus</div>
                        <div class="inc-gate-card-sub">@IncidentSre.Current.RiskSub</div>
                    </div>
                </div>

                <div class="inc-pr-actions">
                    @if (_status?.Branch is { Length: > 0 } curBranch && PolicyStore.Current.Bypass.ProtectedBranches.Any(g => Syncro.Desktop.Services.Agent.Policy.PermissionChecker.GlobMatch(curBranch, g)))
                    {
                        <span class="inc-protected-note">Protected branch — agent writes need typed confirmation</span>
                    }
                    <button class="ent-btn ent-btn-purple" @onclick="CreateIncidentPrAsync" disabled="@_busy">
                        CREATE INCIDENT PR
                    </button>
                    <button class="ent-btn ent-btn-outline" @onclick='() => _activeTab = "history"'>
                        VIEW TIMELINE
                    </button>
                </div>
            </div>

            <!-- ════════════════ BOTTOM ROW 2: 5-STAGE INCIDENT AUTOSRE FLOW STEPPER ════════════════ -->
            <div class="inc-stepper-card">
                <div class="inc-stepper-hdr">
                    <span class="ent-panel-title">INCIDENT AUTOSRE FLOW</span>
                    <span class="ent-sub">Planned flow. Today only Verify (real SAST, build and tests) and PR prep work; detection, correlation and patch generation are not built yet.</span>
                </div>
                <div class="inc-stepper-track">
                    <div class="inc-step @StepClass(1)" @onclick="() => SetAutoSreStep(1)">
                        <div class="inc-step-title">1. Detect</div>
                        <div class="inc-step-sub">No alert source yet</div>
                    </div>
                    <span class="inc-step-arrow">→</span>
                    <div class="inc-step @StepClass(2)" @onclick="() => SetAutoSreStep(2)">
                        <div class="inc-step-title">2. Correlate</div>
                        <div class="inc-step-sub">Latest @IncidentSre.Current.SuspectSha (git only)</div>
                    </div>
                    <span class="inc-step-arrow">→</span>
                    <div class="inc-step @StepClass(3)" @onclick="() => SetAutoSreStep(3)">
                        <div class="inc-step-title">3. Patch</div>
                        <div class="inc-step-sub">Patch generation not built</div>
                    </div>
                    <span class="inc-step-arrow">→</span>
                    <div class="inc-step @StepClass(4)" @onclick="() => SetAutoSreStep(4)">
                        <div class="inc-step-title">4. Verify</div>
                        <div class="inc-step-sub">Build · Tests · SAST</div>
                    </div>
                    <span class="inc-step-arrow">→</span>
                    <div class="inc-step @StepClass(5)" @onclick="() => SetAutoSreStep(5)">
                        <div class="inc-step-title">5. PR</div>
                        <div class="inc-step-sub">Human review</div>
                    </div>
                </div>
            </div>
        }

        <!-- ════════════════ TAB 2: SRE RUNBOOKS & WORKFLOWS (MATCHING DESIGN IMAGE 2) ════════════════ -->
        @if (_activeTab == "sre")
        {
            <div class="ent-workbench-grid">
                <!-- LEFT: Enterprise SRE Playbooks & Step Pipeline Editor -->
                <div class="ent-col-left">
                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">ENTERPRISE SRE PLAYBOOKS &amp; AUTOMATION</span>
                        </div>

                        <div class="ent-playbook-list">
                            @foreach (var pb in _srePlaybooks)
                            {
                                bool isActive = _selectedPlaybookId == pb.Id;
                                <div class="ent-playbook-card @(isActive ? "active" : "")" @onclick="() => SelectPlaybook(pb)">
                                    <div class="ent-playbook-top">
                                        <div>
                                            <div class="ent-playbook-name">@pb.Title</div>
                                            <span class="ent-playbook-tag">@pb.Category</span>
                                        </div>
                                        <span class="ent-playbook-badge @(pb.Destructive ? "danger" : "pass")">
                                            @(pb.Destructive ? "⚠ Approval Gate" : "● Safe Runbook")
                                        </span>
                                    </div>
                                    <div class="ent-playbook-desc">@pb.Description</div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">WORKFLOW PIPELINE STEPS (GIT + SHELL)</span>
                            <span class="ent-sub">1 step per line</span>
                        </div>

                        <textarea class="ent-commit-textarea ent-mono"
                                  rows="5"
                                  placeholder="fetch --all --prune&#10;pull --ff-only&#10;status --short&#10;shell: dotnet build --no-restore"
                                  @bind="_wfText"
                                  @bind:event="oninput"></textarea>

                        @{
                            var currentFlags = PreviewWorkflowSafetyFlags();
                        }
                        <div class="ent-safety-banner @(currentFlags.Count == 0 ? "ok" : "warn")">
                            @if (currentFlags.Count == 0)
                            {
                                <i class="bi bi-check-circle-fill"></i>
                                <span>0 Destructive Flags · Guardrails Verified</span>
                            }
                            else
                            {
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span>@currentFlags.Count Destructive Flag(s) — Requires explicit approval below</span>
                            }
                        </div>

                        @if (currentFlags.Count > 0)
                        {
                            <label class="ent-approve-row">
                                <input type="checkbox" @bind="_wfApproved" />
                                <span>Approve destructive / history-rewriting steps for this run</span>
                            </label>
                        }

                        <button class="ent-btn ent-btn-primary ent-btn-full" @onclick="RunWorkflow" disabled="@_busy">
                            <i class="bi bi-play-fill"></i> Execute SRE Runbook
                        </button>
                    </div>
                </div>

                <!-- RIGHT: Live Dark-Slate Execution Terminal + Instant Commit Rollback -->
                <div class="ent-col-right">
                    <div class="ent-panel ent-terminal-card">
                        <div class="ent-terminal-header">
                            <span class="ent-terminal-title">LIVE SRE EXECUTION TERMINAL</span>
                            @if (_wfLastElapsedMs > 0)
                            {
                                <span class="ent-terminal-pill @(_wfLastOk ? "ok" : "fail")">
                                    ● Exit Code: @_wfLastExitCode · @(_wfLastElapsedMs)ms
                                </span>
                            }
                        </div>
                        <div class="ent-terminal-body">
                            @if (string.IsNullOrEmpty(_wfOutput))
                            {
                                <div class="ent-term-line muted">[READY] Select an Enterprise SRE Playbook on the left and click 'Execute SRE Runbook'.</div>
                                <div class="ent-term-line muted">[INFO] All git commands run with GIT_TERMINAL_PROMPT=0 and safety guardrails enabled.</div>
                            }
                            else
                            {
                                @foreach (var line in _wfOutput.Split('\n'))
                                {
                                    var cls = line.Contains("[PASS]") || line.Contains("exit 0") ? "pass"
                                            : line.Contains("[ERR]") || line.Contains("Blocked") || line.Contains("failed") ? "err"
                                            : line.Contains("[syncro]") || line.Contains("[EXEC]") ? "exec"
                                            : "";
                                    <div class="ent-term-line @cls">@line</div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Commit History & Instant SRE Rollback -->
                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">COMMIT HISTORY &amp; INSTANT SRE ROLLBACK</span>
                            <span class="ent-sub">Creates a safe forward undo commit (<code>git revert --no-edit</code>)</span>
                        </div>
                        <div class="ent-table-wrap">
                            <table class="ent-table">
                                <thead>
                                    <tr>
                                        <th>SHA</th>
                                        <th>Commit Subject</th>
                                        <th>Author</th>
                                        <th>When</th>
                                        <th style="text-align:right;">SRE Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in _commits.Take(8))
                                    {
                                        <tr>
                                            <td><code class="ent-sha">@c.ShortSha</code></td>
                                            <td class="ent-subject">@c.Subject</td>
                                            <td>@c.Author</td>
                                            <td class="ent-sub">@FormatDate(c.Date)</td>
                                            <td style="text-align:right;">
                                                <button class="ent-mini-btn" @onclick="() => InspectCommitDiffAsync(c)">Inspect Diff</button>
                                                <button class="ent-mini-btn danger" @onclick="() => Revert(c)" disabled="@_busy">Safe Revert SHA</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ════════════════ TAB 3: FULL COMMIT HISTORY & CONTRIBUTORS ════════════════ -->
        @if (_activeTab == "history")
        {
            <div class="ent-workbench-grid">
                <div class="ent-col-right" style="grid-column: span 1;">
                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">COMMIT LOG (@_commits.Count)</span>
                            <input class="ent-mini-search" placeholder="Filter by SHA, author, or message…" @bind="_historyFilter" @bind:event="oninput" />
                        </div>
                        <div class="ent-table-wrap">
                            <table class="ent-table">
                                <thead>
                                    <tr>
                                        <th>SHA</th>
                                        <th>Author</th>
                                        <th>Date</th>
                                        <th>Subject</th>
                                        <th style="text-align:right;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in FilteredCommits)
                                    {
                                        <tr>
                                            <td><code class="ent-sha">@c.ShortSha</code></td>
                                            <td><b>@c.Author</b></td>
                                            <td class="ent-sub">@FormatDate(c.Date)</td>
                                            <td>@c.Subject</td>
                                            <td style="text-align:right;">
                                                <button class="ent-mini-btn" @onclick="() => InspectCommitDiffAsync(c)">View Patch</button>
                                                <button class="ent-mini-btn danger" @onclick="() => Revert(c)" disabled="@_busy">Revert</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="ent-col-left">
                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">CONTRIBUTORS &amp; OWNERSHIP (@_contributors.Count)</span>
                        </div>
                        <div class="ent-table-wrap">
                            <table class="ent-table">
                                <thead>
                                    <tr>
                                        <th>Contributor</th>
                                        <th>Email</th>
                                        <th style="text-align:right;">Commits</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cb in _contributors)
                                    {
                                        <tr>
                                            <td><b>@cb.Name</b></td>
                                            <td class="ent-sub">@cb.Email</td>
                                            <td style="text-align:right;"><b>@cb.Commits</b></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ════════════════ TAB 4: BRANCHES & REMOTES ════════════════ -->
        @if (_activeTab == "branches")
        {
            <div class="ent-workbench-grid">
                <div class="ent-col-right">
                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">LOCAL &amp; REMOTE BRANCHES (@_branches.Count)</span>
                            <div class="ent-header-mini-actions">
                                <input class="ent-mini-search" placeholder="new-feature-branch" @bind="_newBranchName" />
                                <button class="ent-btn ent-btn-sm ent-btn-primary" @onclick="CreateNewBranchAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newBranchName))">
                                    + Create &amp; Checkout
                                </button>
                            </div>
                        </div>

                        <div class="ent-table-wrap">
                            <table class="ent-table">
                                <thead>
                                    <tr>
                                        <th>Branch</th>
                                        <th>Scope</th>
                                        <th>Upstream</th>
                                        <th>Tracking State</th>
                                        <th style="text-align:right;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in _branches)
                                    {
                                        <tr>
                                            <td>
                                                <b>@b.Name</b>
                                                @if (b.IsCurrent)
                                                {
                                                    <span class="ent-sre-pill pass" style="margin-left:6px;">current</span>
                                                }
                                            </td>
                                            <td>@(b.IsRemote ? "remote" : "local")</td>
                                            <td><code>@(b.Upstream ?? (b.Gone ? "(gone)" : "—"))</code></td>
                                            <td>
                                                @if (b.Ahead > 0 || b.Behind > 0)
                                                {
                                                    <span>↑ @b.Ahead · ↓ @b.Behind</span>
                                                }
                                                else
                                                {
                                                    <span class="ent-sub">up to date</span>
                                                }
                                            </td>
                                            <td style="text-align:right;">
                                                @if (!b.IsCurrent)
                                                {
                                                    <button class="ent-mini-btn" @onclick="() => Checkout(b)" disabled="@_busy">Checkout</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="ent-col-left">
                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">CONFIGURED REMOTES (@_remotes.Count)</span>
                        </div>
                        @if (_remotes.Count == 0)
                        {
                            <div class="ent-empty-state">No git remotes configured yet. Add <code>origin</code> below.</div>
                        }
                        else
                        {
                            @foreach (var rem in _remotes)
                            {
                                <div class="ent-remote-card">
                                    <div><b>@rem.Name</b></div>
                                    <div class="ent-sub"><code>@rem.FetchUrl</code></div>
                                </div>
                            }
                        }

                        <div class="ent-remote-form">
                            <input class="ent-mini-search" style="width:90px;" placeholder="origin" @bind="_remoteName" />
                            <input class="ent-mini-search" style="flex:1;" placeholder="https://github.com/org/repo.git" @bind="_remoteUrl" />
                            <button class="ent-btn ent-btn-sm ent-btn-outline" @onclick="SaveRemoteAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_remoteUrl))">
                                Set URL
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ════════════════ TAB 5: PR & GITHUB INTEGRATION ════════════════ -->
        @if (_activeTab == "pr")
        {
            <div class="ent-workbench-grid">
                <div class="ent-col-left">
                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">PULL REQUEST &amp; SAFE PUSH AUTOMATION</span>
                        </div>
                        <div class="ent-form-stack">
                            <label class="ent-lbl">Target Base Branch</label>
                            <input class="ent-repo-input" @bind="_prBaseBranch" placeholder="main" />
                            <div style="display:flex; gap:8px; margin-top:8px;">
                                <button class="ent-btn ent-btn-primary" @onclick="@(() => RunScriptAsync("git-open-pr.ps1", new[] { "-Base", _prBaseBranch }))" disabled="@(_busy || string.IsNullOrWhiteSpace(_prBaseBranch))">
                                    <i class="bi bi-stars"></i> Create PR (AI Summary)
                                </button>
                                <button class="ent-btn ent-btn-outline" @onclick="@(() => RunScriptAsync("git-open-pr.ps1", new[] { "-Base", _prBaseBranch, "-NoAI" }))" disabled="@(_busy || string.IsNullOrWhiteSpace(_prBaseBranch))">
                                    Create Standard PR
                                </button>
                            </div>
                        </div>

                        <div class="ent-panel-header" style="margin-top:18px;">
                            <span class="ent-panel-title">REPOSITORY REPAIR &amp; CONFLICT UTILITIES</span>
                        </div>
                        <div style="display:flex; flex-wrap:wrap; gap:8px;">
                            <button class="ent-mini-btn" @onclick="@(() => RunScriptAsync("git-doctor.ps1", Array.Empty<string>()))" disabled="@_busy">Run Git Doctor</button>
                            <button class="ent-mini-btn" @onclick="@(() => RunScriptAsync("git-doctor.ps1", new[] { "-Fix" }))" disabled="@_busy">Doctor (Auto-Fix)</button>
                            <button class="ent-mini-btn" @onclick="@(() => RunScriptAsync("git-repair.ps1", new[] { "-AbortOps", "-Fsck" }))" disabled="@_busy">Repair &amp; Fsck</button>
                            <button class="ent-mini-btn" @onclick="@(() => RunScriptAsync("git-resolve-conflicts.ps1", Array.Empty<string>()))" disabled="@_busy">List Merge Conflicts</button>
                            <button class="ent-mini-btn" @onclick="@(() => RunScriptAsync("git-safe-push.ps1", new[] { "-Rebase" }))" disabled="@_busy">Safe Rebase &amp; Push</button>
                        </div>
                    </div>

                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">CONNECT GITHUB ACCOUNT &amp; GROQ AI</span>
                        </div>
                        <div class="ent-form-stack">
                            <input class="ent-repo-input" @bind="_githubUser" placeholder="GitHub Username" />
                            <input class="ent-repo-input" @bind="_githubEmail" placeholder="Git Commit Email" />
                            <input class="ent-repo-input" type="password" @bind="_githubToken" placeholder="GitHub Personal Access Token (PAT)" />
                            <button class="ent-btn ent-btn-outline"
                                    @onclick="ConnectGitHubSafeAsync"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_githubUser) || string.IsNullOrWhiteSpace(_githubToken))">
                                <i class="bi bi-github"></i> Configure Git Credential Helper
                            </button>
                        </div>
                    </div>
                </div>

                <div class="ent-col-right">
                    <div class="ent-panel ent-terminal-card">
                        <div class="ent-terminal-header">
                            <span class="ent-terminal-title">AUTOMATION SCRIPT OUTPUT</span>
                        </div>
                        <div class="ent-terminal-body">
                            @if (string.IsNullOrEmpty(_advancedOutput))
                            {
                                <div class="ent-term-line muted">[READY] Trigger any PR, Doctor, or GitHub credential action on the left to stream output here.</div>
                            }
                            else
                            {
                                <pre style="margin:0; white-space:pre-wrap; font-family:'JetBrains Mono',monospace; font-size:12px; color:#e2e8f0;">@_advancedOutput</pre>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ════════════════ TAB 6: SECURITY (SAST) & CREDENTIALS ════════════════ -->
        @if (_activeTab == "security")
        {
            <div class="ent-workbench-grid">
                <div class="ent-col-left">
                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">DETECTED GIT CREDENTIALS &amp; SIGNING</span>
                            <button class="ent-mini-btn" @onclick="RefreshCredentialsAsync">Rescan</button>
                        </div>
                        @if (_cred != null)
                        {
                            <div class="ent-cred-grid">
                                <div class="ent-cred-item">
                                    <span>SSH Key</span>
                                    <b class="@(_cred.SshKeyPath != null ? "text-emerald" : "text-muted")">@(_cred.SshKeyPath ?? "Not found")</b>
                                </div>
                                <div class="ent-cred-item">
                                    <span>SSH Agent</span>
                                    <b class="@(_cred.SshAgentRunning ? "text-emerald" : "text-muted")">@(_cred.SshAgentRunning ? "Running ✓" : "Inactive")</b>
                                </div>
                                <div class="ent-cred-item">
                                    <span>GPG Signing Key</span>
                                    <b class="@(_cred.GpgKeyId != null ? "text-emerald" : "text-muted")">@(_cred.GpgKeyId ?? "None")</b>
                                </div>
                                <div class="ent-cred-item">
                                    <span>Credential Helper</span>
                                    <b class="@(_cred.CredentialHelper != null ? "text-emerald" : "text-muted")">@(_cred.CredentialHelper ?? "Not set")</b>
                                </div>
                            </div>
                            <div style="display:flex; gap:8px; margin-top:12px;">
                                @if (_cred.GpgKeyId != null)
                                {
                                    <button class="ent-btn ent-btn-sm ent-btn-outline" @onclick="EnableSigning">
                                        @(_cred.SigningEnabled ? "✓ GPG Signing Enabled" : "Enable GPG Signing")
                                    </button>
                                }
                                @if (_cred.SshKeyPath != null)
                                {
                                    <button class="ent-btn ent-btn-sm ent-btn-outline" @onclick="WireSshKeyAsync">
                                        Wire Repo to SSH Key
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="ent-col-right">
                    <div class="ent-panel">
                        <div class="ent-panel-header">
                            <span class="ent-panel-title">PRE-COMMIT SAST SECURITY FINDINGS (@(_sastReport?.Findings.Count ?? 0))</span>
                            <button class="ent-btn ent-btn-sm ent-btn-primary" @onclick="RunSrePreFlightAsync" disabled="@_sreRunning">
                                Scan Repository Now
                            </button>
                        </div>
                        @if (_sastReport == null)
                        {
                            <div class="ent-empty-state">Click <b>Scan Repository Now</b> to check for hardcoded secrets, tokens, SQL injection, and insecure transport before pushing.</div>
                        }
                        else if (_sastReport.Findings.Count == 0)
                        {
                            <div class="ent-empty-state">
                                <i class="bi bi-shield-fill-check text-emerald" style="font-size:24px;"></i>
                                <div><b>Zero SAST vulnerabilities or leaked secrets detected</b> across @_sastReport.FilesScanned scanned files (@(_sastReport.ElapsedMs)ms).</div>
                            </div>
                        }
                        else
                        {
                            <div class="ent-table-wrap">
                                <table class="ent-table">
                                    <thead>
                                        <tr>
                                            <th>Severity</th>
                                            <th>Rule</th>
                                            <th>File : Line</th>
                                            <th>Reason</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in _sastReport.Findings.Take(50))
                                        {
                                            <tr>
                                                <td><span class="ent-sre-pill fail">@f.Severity</span></td>
                                                <td><b>@f.Title</b></td>
                                                <td><code>@f.File:@f.Line</code></td>
                                                <td class="ent-sub">@f.Why</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else if (_loaded)
    {
        <div class="ent-top-card" style="border-color:#fca5a5; background:#fef2f2; color:#991b1b;">
            <b>Not a valid Git repository:</b> <code>@_repo</code> does not contain a `.git` worktree or does not exist.
        </div>
    }
</div>

@code {
    private string _repo = "";
    private string _activeTab = "changes";
    private bool _busy, _loaded, _autoSync, _sreRunning;
    private Syncro.Desktop.Services.Git.GitStatus? _status;
    private List<GitCommit> _commits = new();
    private List<GitContributor> _contributors = new();
    private List<GitBranch> _branches = new();
    private List<GitRemote> _remotes = new();
    private List<GitCommit> _incoming = new();
    private GitCredentialStatus? _cred;
    private List<ProjectModel> _knownProjects = new();

    // Working Tree & Diff state
    private string _changeFilter = "all";
    private HashSet<string> _selectedFiles = new(StringComparer.OrdinalIgnoreCase);
    private string? _selectedDiffFile;
    private string _selectedDiffTitle = "";
    private List<string> _diffLines = new();

    private IEnumerable<IGrouping<string, GitFileChange>> FilteredFilesByDirectory
    {
        get
        {
            var files = _status?.Files ?? new List<GitFileChange>();
            IEnumerable<GitFileChange> filtered = _changeFilter switch
            {
                "staged" => files.Where(f => f.IsStaged || _selectedFiles.Contains(f.Path)),
                "unstaged" => files.Where(f => !f.IsStaged && !_selectedFiles.Contains(f.Path)),
                _ => files
            };
            return filtered.GroupBy(f => f.Directory);
        }
    }

    // AI Commit state
    private string _commitMsg = "";
    private bool _drafting, _signCommit;

    // SRE Pre-Flight Gate state
    private SecurityScanReport? _sastReport;
    private MultiProjectScanReport? _contractReport;
