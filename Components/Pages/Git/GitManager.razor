    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(_repo)) return;
        _busy = true;
        _loaded = true;
        StateHasChanged();

        try
        {
            if (!await Git.IsRepoAsync(_repo))
            {
                _status = new Syncro.Desktop.Services.Git.GitStatus { IsRepo = false };
                return;
            }

            // Sync auto-fetch state with background GitSyncService
            _autoSync = Sync.IsRegistered(_repo);

            await Refresh();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Load failed: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>Runs all Git queries concurrently via Task.WhenAll (~70% faster than sequential).</summary>
    private async Task Refresh()
    {
        var statusTask = Git.StatusAsync(_repo);
        var logTask = Git.LogAsync(_repo, 50);
        var contribTask = Git.ContributorsAsync(_repo);
        var branchTask = Git.BranchesAsync(_repo);
        var remoteTask = Git.RemotesAsync(_repo);
        var incomingTask = Git.IncomingAsync(_repo);
        var credTask = Cred.DetectAsync(_repo);

        await Task.WhenAll(statusTask, logTask, contribTask, branchTask, remoteTask, incomingTask, credTask);

        _status = statusTask.Result;
        _commits = logTask.Result.ToList();
        _contributors = contribTask.Result.ToList();
        _branches = branchTask.Result.ToList();
        _remotes = remoteTask.Result.ToList();
        _incoming = incomingTask.Result.ToList();
        _cred = credTask.Result;
        _signCommit = _cred?.SigningEnabled == true;
        await IncidentSre.CorrelateRepoAsync(_repo, _commits);

        // Default all changed files to checked, and auto-preview the first changed file's diff
        _selectedFiles = _status.Files.Select(f => f.Path).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (_status.Files.Count > 0)
        {
            var targetFile = _selectedDiffFile != null && _status.Files.Any(f => f.Path == _selectedDiffFile)
                ? _selectedDiffFile
                : _status.Files[0].Path;
            await SelectFileForDiffAsync(targetFile);
        }
        else
        {
            _selectedDiffFile = null;
            _selectedDiffTitle = "";
            _diffLines.Clear();
        }

        StateHasChanged();
    }

