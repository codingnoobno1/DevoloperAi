    private async Task Commit()
    {
        if (_status == null || string.IsNullOrWhiteSpace(_commitMsg)) return;

        var targetFiles = _selectedFiles.Count > 0
            ? _selectedFiles.ToList()
            : _status.Files.Select(f => f.Path).ToList();

        // Enforce Receiver Git Task File Scope Guard
        var scopeCheck = ScopeSvc.ValidateFilesForCommit(_repo, targetFiles);
        if (!scopeCheck.Allowed)
        {
            Snackbar.Add($"Git Task Scope Guard Blocked Commit: {scopeCheck.Message}", MudBlazor.Severity.Error);
            return;
        }
        else if (scopeCheck.TeammateLockViolations.Count > 0 || scopeCheck.OutOfScopeFiles.Count > 0)
        {
            Snackbar.Add($"Advisory Task Scope Warning: {scopeCheck.Message}", MudBlazor.Severity.Warning);
        }

        _busy = true;
        StateHasChanged();

        GitResult r;
        if (_selectedFiles.Count > 0 && _selectedFiles.Count < _status.Files.Count)
            r = await Git.CommitFilesAsync(_repo, _commitMsg, _selectedFiles.ToList(), sign: _signCommit);
        else
            r = await Git.CommitAsync(_repo, _commitMsg, stageAll: true, sign: _signCommit);

        Snackbar.Add(r.Ok ? "Committed changes." : $"Commit failed: {r.Error}",
            r.Ok ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        if (r.Ok) _commitMsg = "";
        await Refresh();

        if (r.Ok && ActiveRepoTask != null && _commits.Count > 0)
        {
            ActiveRepoTask.LatestCommitSha = _commits[0].ShortSha;
            ActiveRepoTask.CommitCount++;
            await PixelSvc.UpdateGitTaskAsync(ActiveRepoTask.Id, new UpdateGitTaskRequest
            {
                LatestCommitSha = ActiveRepoTask.LatestCommitSha,
                CommitCount = ActiveRepoTask.CommitCount
            });
        }

        _busy = false;
    }

    private async Task RunSrePreFlightAsync()
    {
        if (string.IsNullOrWhiteSpace(_repo) || !Directory.Exists(_repo)) return;
        _sreRunning = true;
        StateHasChanged();

        try
        {
            // 1. SAST Security Scan on repo
            var sastTask = SecScanner.ScanAsync(_repo);

            // 2. Multi-Project API Contract Scan (scan parent ecosystem folder if available, else repo)
            var parentDir = Directory.GetParent(_repo)?.FullName ?? _repo;
            var contractTask = ContractScanner.ScanAsync(parentDir);

            await Task.WhenAll(sastTask, contractTask);
            _sastReport = sastTask.Result;
            _contractReport = contractTask.Result;
            await IncidentSre.RunFullVerificationGatesAsync(_repo);

            Snackbar.Add(
                $"SRE Gate complete: {_sastReport.Findings.Count} SAST alert(s), {_contractReport.Matched} matched contracts ({_contractReport.Missing} broken).",
                _sastReport.GatePassed && _contractReport.Missing == 0 ? MudBlazor.Severity.Success : MudBlazor.Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"SRE Gate error: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _sreRunning = false;
            StateHasChanged();
        }
    }

