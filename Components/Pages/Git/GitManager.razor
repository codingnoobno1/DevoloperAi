    protected override async Task OnInitializedAsync()
    {
        _knownProjects = ProjSvc.GetProjects();
        if (!string.IsNullOrWhiteSpace(ScopeSvc.CurrentActiveRepoPath) && Directory.Exists(ScopeSvc.CurrentActiveRepoPath))
        {
            _repo = ScopeSvc.CurrentActiveRepoPath;
        }
        else
        {
            var firstValid = _knownProjects.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.Path) && Directory.Exists(p.Path));
            if (firstValid != null)
            {
                _repo = firstValid.Path;
            }
        }

        if (!string.IsNullOrWhiteSpace(_repo))
        {
            if (ScopeSvc.GetActiveTaskForRepo(_repo) == null)
            {
                // Only a task that belongs to THIS repo may scope its commits (matched by the project's
                // local folder or the task's repo URL vs this repo's remotes) — never just "the first task".
                var myTasks = await PixelSvc.GetAssignedTasksAsync();
                var projects = await PixelSvc.GetProjectsAsync();
                var remotes = (await Git.RemotesAsync(_repo)).SelectMany(r => new[] { r.FetchUrl, r.PushUrl }).ToList();
                var activeTask = myTasks.FirstOrDefault(t =>
                    !string.Equals(t.Status, "completed", StringComparison.OrdinalIgnoreCase) &&
                    GitTaskScopeService.TaskBelongsToRepo(t, _repo, remotes, projects.FirstOrDefault(p => p.Id == t.ProjectId)?.LocalRepoPath));
                if (activeTask != null)
                {
                    ScopeSvc.ActivateTaskForRepo(_repo, activeTask);
                }
            }
            await LoadAsync();
        }
    }

