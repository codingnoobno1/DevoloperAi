    private List<string> PreviewWorkflowSafetyFlags()
    {
        var wf = ParseWorkflowFromText();
        return GitWorkflowSafety.Scan(wf);
    }

    private GitWorkflow ParseWorkflowFromText()
    {
        var wf = new GitWorkflow { Name = _selectedPlaybookId, Repo = _repo };
        foreach (var raw in (_wfText ?? "").Split('\n'))
        {
            var line = raw.Trim();
            if (line.Length == 0) continue;
            if (line.StartsWith("shell:", StringComparison.OrdinalIgnoreCase))
                wf.Steps.Add(new GitWorkflowStep { Kind = "shell", Command = line.Substring(6).Trim() });
            else
                wf.Steps.Add(new GitWorkflowStep { Kind = "git", Command = line.StartsWith("git ") ? line.Substring(4) : line });
        }
        return wf;
    }

    private async Task RunWorkflow()
    {
        var wf = ParseWorkflowFromText();
        if (wf.Steps.Count == 0) return;

        var sw = Stopwatch.StartNew();
        _busy = true;
        _wfOutput = $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss}] [INFO] SRE Runbook triggered: {_selectedPlaybookId}\n";
        StateHasChanged();

        var res = await Workflows.RunAsync(wf, approved: _wfApproved);
        sw.Stop();
        _wfLastElapsedMs = sw.ElapsedMilliseconds;
        _wfLastExitCode = res.ExitCode;
        _wfLastOk = res.Ok && !res.Blocked;

        if (res.Blocked && !_wfApproved)
        {
            _wfOutput += "[ERR] Blocked by SRE Safety Scanner (destructive steps):\n" +
                         string.Join("\n", res.Flags) +
                         "\n\nTick 'Approve destructive / history-rewriting steps' to execute.";
        }
        else
        {
            if (_selectedPlaybookId == "pre-push-sre")
            {
                await RunSrePreFlightAsync();
                _wfOutput += $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss}] [PASS] SAST Analysis: {_sastReport?.Findings.Count ?? 0} alert(s).\n";
                _wfOutput += $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss}] [PASS] Contract Check: {_contractReport?.Matched ?? 0} matched, {_contractReport?.Missing ?? 0} missing.\n";
            }
            _wfOutput += $"{res.Output}{(string.IsNullOrEmpty(res.Error) ? "" : "\n[ERR] " + res.Error)}";
        }

        await Refresh();
        _busy = false;
    }

