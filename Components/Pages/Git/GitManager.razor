    private async Task RunScriptAsync(string scriptName, string[] scriptArgs)
    {
        _busy = true;
        _advancedOutput = $"[{DateTime.Now:HH:mm:ss}] Running {scriptName}...\n";
        StateHasChanged();

        var scriptPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "scripts", "git", scriptName);
        if (!File.Exists(scriptPath))
        {
            _advancedOutput += $"Error: Script not found at {scriptPath}";
            _busy = false;
            StateHasChanged();
            return;
        }

        try
        {
            var psi = new ProcessStartInfo("powershell.exe")
            {
                WorkingDirectory = Directory.Exists(_repo) ? _repo : AppDomain.CurrentDomain.BaseDirectory,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };
            psi.ArgumentList.Add("-NoProfile");
            psi.ArgumentList.Add("-ExecutionPolicy");
            psi.ArgumentList.Add("Bypass");
            psi.ArgumentList.Add("-File");
            psi.ArgumentList.Add(scriptPath);
            foreach (var a in scriptArgs)
                psi.ArgumentList.Add(a);

            using var proc = Process.Start(psi);
            if (proc != null)
            {
                var stdout = await proc.StandardOutput.ReadToEndAsync();
                var stderr = await proc.StandardError.ReadToEndAsync();
                await proc.WaitForExitAsync();
                _advancedOutput += stdout;
                if (!string.IsNullOrWhiteSpace(stderr))
                    _advancedOutput += "\n[STDERR]\n" + stderr;
                _advancedOutput += $"\n[Exit Code: {proc.ExitCode}]";
            }
            await Refresh();
        }
        catch (Exception ex)
        {
            _advancedOutput += $"\nException: {ex.Message}";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task PickRepo()
    {
        try
        {
            var res = await CommunityToolkit.Maui.Storage.FolderPicker.Default.PickAsync(default);
            if (res.IsSuccessful && res.Folder != null)
            {
                _repo = res.Folder.Path;
                await LoadAsync();
            }
        }
        catch { }
    }

    private static string FormatDate(string iso) =>
        DateTime.TryParse(iso, out var d) ? d.ToString("yyyy-MM-dd HH:mm") : iso;

    private static string GetFileStateShort(string s) => s switch
    {
        "??" or "A" => "+",
        "D" => "−",
        "U" => "!",
        _ => "M"
    };

    private static string GetFileStateLabel(string s) => s switch
    {
        "??" => "Untracked",
        "A" => "Added",
        "D" => "Deleted",
        "U" => "Conflict",
        "R" => "Renamed",
        _ => "Modified"
    };

    private static string GetFileStateClass(string s) => s switch
    {
        "??" or "A" => "added",
        "D" or "U" => "deleted",
        _ => "modified"
    };

    private static string GetDiffLineClass(string line, ref int oldLn, ref int newLn, out string left, out string right)
    {
        left = "";
        right = "";
        if (line.StartsWith("@@"))
        {
            return "hunk";
        }
        if (line.StartsWith("+++") || line.StartsWith("---") || line.StartsWith("diff ") || line.StartsWith("index "))
        {
            return "meta";
        }
        if (line.StartsWith("+"))
        {
            right = (newLn++).ToString();
            return "add";
        }
        if (line.StartsWith("-"))
        {
            left = (oldLn++).ToString();
            return "del";
        }
        left = (oldLn++).ToString();
        right = (newLn++).ToString();
        return "ctx";
    }
}

