@page "/endpoint-explorer"
@using Syncro.Desktop.Services.AST
@using Syncro.Desktop.Services.AST.Models
@using System.IO
@inject AstService AstService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
    <!-- Sub-navigation Header -->
    <div class="d-flex align-center justify-space-between mb-6 pa-6 panel rounded-lg ast-header-gradient text-white">
        <div>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Api" Size="Size.Large" Class="text-white" />
                <MudText Typo="Typo.h5" Class="font-weight-bold text-white">REST ENDPOINT EXPLORER</MudText>
            </div>
            @if (AstService.ActiveProjectMap != null)
            {
                <MudText Typo="Typo.caption" Class="text-white-50">Active Project: <strong>@AstService.ActiveProjectMap.ProjectName</strong> (@AstService.ActiveProjectMap.Language / @AstService.ActiveProjectMap.Framework)</MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="text-white-50">Please load and scan a project to view endpoints</MudText>
            }
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       OnClick="@(() => Navigation.NavigateTo("ast-dashboard"))" 
                       StartIcon="@Icons.Material.Filled.Search"
                       Class="header-nav-btn">Scan Hub</MudButton>
            @if (AstService.ActiveProjectMap != null)
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Secondary" 
                           OnClick="@(() => Navigation.NavigateTo("project-map-view"))" 
                           StartIcon="@Icons.Material.Filled.AccountTree"
                           Class="header-nav-btn">Graph Map</MudButton>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Info" 
                           OnClick="@(() => Navigation.NavigateTo("endpoint-explorer"))" 
                           StartIcon="@Icons.Material.Filled.Api"
                           Class="header-nav-btn active">Endpoints</MudButton>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Warning" 
                           OnClick="@(() => Navigation.NavigateTo("dto-planner"))" 
                           StartIcon="@Icons.Material.Filled.DataArray"
                           Class="header-nav-btn">DTO Planner</MudButton>
            }
        </div>
    </div>

    @if (AstService.ActiveProjectMap == null)
    {
        <MudPaper Elevation="0" Class="pa-12 panel rounded-lg text-center d-flex flex-column align-center justify-center">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Large" Class="mb-4" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">No Scanned Project Loaded</MudText>
            <MudText Typo="Typo.body2" Class="text-muted mb-6">You must scan a project codebase first before accessing the rest endpoints explorer.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="@(() => Navigation.NavigateTo("ast-dashboard"))">
                Go to Scan Hub
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            <!-- Left Side: Table of routes -->
            <MudItem xs="12" lg="8">
                <MudPaper Elevation="0" Class="pa-6 panel rounded-lg">
                    <div class="d-flex align-center justify-space-between mb-4">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Discovered REST Endpoints</MudText>
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">@FilteredEndpoints.Count routes match filters</MudChip>
                    </div>

                    <div style="overflow-x: auto;">
                        <table class="ent-table">
                            <thead>
                                <tr>
                                    <th style="width: 80px;">Method</th>
                                    <th>Path / URL</th>
                                    <th>Handler / Controller</th>
                                    <th>Source File</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (FilteredEndpoints.Any())
                                {
                                    @foreach (var ep in FilteredEndpoints)
                                    {
                                        <tr class="route-row" @onclick="() => OnEndpointSelected(ep)">
                                            <td>
                                                <span class="badge @GetMethodBadgeClass(ep.Method)">@ep.Method</span>
                                            </td>
                                            <td class="font-mono font-weight-bold text-indigo">@ep.Path</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(ep.ControllerName))
                                                {
                                                    <span class="text-sm font-weight-medium">@ep.ControllerName</span>
                                                    @if (!string.IsNullOrEmpty(ep.HandlerMethod))
                                                    {
                                                        <span class="text-xs text-muted">.@(ep.HandlerMethod)()</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-xs text-muted italic">Inline Route Handler</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="text-xs text-secondary truncate d-block" title="@ep.FilePath">@Path.GetFileName(ep.FilePath)</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-8 text-muted italic">No endpoints discovered matching current filters.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- Right Side: Filters, Details, & Swagger Specs -->
            <MudItem xs="12" lg="4">
                <div class="d-flex flex-column gap-6">
                    <!-- Filters Panel -->
                    <MudPaper Elevation="0" Class="pa-6 panel rounded-lg">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">Filter & Search</MudText>
                        <div class="d-flex flex-column gap-3">
                            <MudTextField T="string" Value="@SearchQuery" ValueChanged="OnFiltersChanged" Label="Search Route Path" Placeholder="e.g. /api/users" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
                            
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                <MudChip T="string" Color="Color.Primary" Variant="@(SelectedMethod == "ALL" ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetMethodFilter("ALL"))" Size="Size.Small">ALL</MudChip>
                                <MudChip T="string" Color="Color.Success" Variant="@(SelectedMethod == "GET" ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetMethodFilter("GET"))" Size="Size.Small">GET</MudChip>
                                <MudChip T="string" Color="Color.Primary" Variant="@(SelectedMethod == "POST" ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetMethodFilter("POST"))" Size="Size.Small">POST</MudChip>
                                <MudChip T="string" Color="Color.Warning" Variant="@(SelectedMethod == "PUT" ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetMethodFilter("PUT"))" Size="Size.Small">PUT</MudChip>
                                <MudChip T="string" Color="Color.Error" Variant="@(SelectedMethod == "DELETE" ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetMethodFilter("DELETE"))" Size="Size.Small">DELETE</MudChip>
                            </div>
                        </div>
                    </MudPaper>

                    <!-- Endpoint Inspector Details -->
                    @if (_selectedEndpoint != null)
                    {
                        <MudPaper Elevation="0" Class="pa-6 panel rounded-lg border-l-primary">
                            <div class="d-flex align-center justify-space-between mb-4 border-b pb-2">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Route Inspector</MudText>
                                <span class="badge @GetMethodBadgeClass(_selectedEndpoint.Method)">@_selectedEndpoint.Method</span>
                            </div>

                            <div class="mb-4">
                                <span class="text-caption text-muted font-weight-bold uppercase d-block">Full Path</span>
                                <span class="text-body2 font-mono font-weight-bold text-indigo d-block">@_selectedEndpoint.Path</span>
                            </div>

                            <div class="mb-4">
                                <span class="text-caption text-muted font-weight-bold uppercase d-block">Controller / Class</span>
                                <span class="text-body2 font-weight-medium">@(!string.IsNullOrEmpty(_selectedEndpoint.ControllerName) ? _selectedEndpoint.ControllerName : "N/A")</span>
                            </div>

                            <div class="mb-4">
                                <span class="text-caption text-muted font-weight-bold uppercase d-block">Handler Method</span>
                                <span class="text-body2 font-mono">@(!string.IsNullOrEmpty(_selectedEndpoint.HandlerMethod) ? _selectedEndpoint.HandlerMethod : "N/A")</span>
                            </div>

                            @if (_selectedEndpoint.Parameters.Any())
                            {
                                <div class="mb-4">
                                    <span class="text-caption text-muted font-weight-bold uppercase d-block mb-1">Route / Query Parameters</span>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var param in _selectedEndpoint.Parameters)
                                        {
                                            <span class="text-xs pa-1 border rounded bg-light font-mono">@param</span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(_selectedEndpoint.RequestDto))
                            {
                                <div class="mb-4">
                                    <span class="text-caption text-muted font-weight-bold uppercase d-block">Request Body Model</span>
                                    <span class="text-body2 text-warning font-weight-bold">@_selectedEndpoint.RequestDto</span>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(_selectedEndpoint.ResponseDto))
                            {
                                <div class="mb-4">
                                    <span class="text-caption text-muted font-weight-bold uppercase d-block">Response Model</span>
                                    <span class="text-body2 text-success font-weight-bold">@_selectedEndpoint.ResponseDto</span>
                                </div>
                            }

                            <div class="pt-2 border-t mt-4 text-right">
                                <span class="text-xs text-muted truncate d-block" title="@_selectedEndpoint.FilePath">Defined in: @Path.GetFileName(_selectedEndpoint.FilePath):L@_selectedEndpoint.LineNumber</span>
                            </div>
                        </MudPaper>
                    }

                    <!-- Swagger / OpenAPI Specs Panel -->
                    <MudPaper Elevation="0" Class="pa-6 panel rounded-lg">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">Swagger/OpenAPI Specifications</MudText>
                        
                        @if (AstService.ActiveProjectMap.SwaggerSpecs.Any())
                        {
                            @foreach (var spec in AstService.ActiveProjectMap.SwaggerSpecs)
                            {
                                <div class="pa-3 border border-subtle rounded-lg bg-light mb-2">
                                    <div class="d-flex justify-space-between mb-1">
                                        <span class="font-weight-bold text-sm text-primary">@spec.Title</span>
                                        <span class="badge badge-success text-xs">v@(spec.Version)</span>
                                    </div>
                                    <span class="text-xs text-muted d-block mb-2 truncate" title="@spec.FilePath">Path: @Path.GetFileName(spec.FilePath)</span>
                                    <div class="d-flex justify-between align-center">
                                        <span class="text-xs text-indigo font-weight-bold">@spec.Endpoints.Count parsed routes</span>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => ExportOpenApiJson(spec)">View Spec</MudButton>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <MudIcon Icon="@Icons.Material.Filled.LinkOff" Color="Color.Secondary" Size="Size.Medium" Class="mb-2" />
                                <MudText Typo="Typo.caption" Class="text-muted d-block">No Swagger JSON files scanned in repository.</MudText>
                            </div>
                        }
                    </MudPaper>
                </div>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

<style>
    .ast-header-gradient {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        box-shadow: 0 4px 20px -2px rgba(99, 102, 241, 0.15);
    }
    .text-white-50 {
        color: rgba(255, 255, 255, 0.7) !important;
    }
    .header-nav-btn {
        text-transform: none !important;
        font-weight: 600 !important;
        border-radius: 6px !important;
    }
    .header-nav-btn.active {
        border: 2px solid white !important;
    }
    .bg-light {
        background-color: #F9FAFB;
    }
    .border-b {
        border-bottom: 1px solid var(--border-subtle);
    }
    .border-t {
        border-top: 1px solid var(--border-subtle);
    }
    .uppercase {
        text-transform: uppercase;
    }
    .font-mono {
        font-family: 'JetBrains Mono', monospace;
    }
    .route-row {
        cursor: pointer;
        transition: all 0.2s;
    }
    .route-row:hover {
        background-color: #EEF2FF;
    }
    .border-l-primary {
        border-left: 5px solid #6366f1;
    }

    /* Badges */
    .badge-get { background: #DCFCE7; color: #15803d; }
    .badge-post { background: #DBEAFE; color: #1d4ed8; }
    .badge-put { background: #FEF3C7; color: #b45309; }
    .badge-delete { background: #FEE2E2; color: #b91c1c; }
    .badge-patch { background: #F3E8FF; color: #6d28d9; }
    .badge-other { background: #F3F4F6; color: #4B5563; }
</style>

@code {
    private List<AstEndpoint> AllEndpoints { get; set; } = new();
    private List<AstEndpoint> FilteredEndpoints { get; set; } = new();
    private AstEndpoint? _selectedEndpoint;
    private string SearchQuery { get; set; } = "";
    private string SelectedMethod { get; set; } = "ALL";

    protected override void OnInitialized()
    {
        if (AstService.ActiveProjectMap != null)
        {
            AllEndpoints = AstService.ActiveProjectMap.Endpoints;
            ApplyFilters();
            
            // Default to select first endpoint
            _selectedEndpoint = FilteredEndpoints.FirstOrDefault();
        }
    }

    private void ApplyFilters()
    {
        var query = SearchQuery.Trim().ToLower();
        FilteredEndpoints = AllEndpoints
            .Where(e => (SelectedMethod == "ALL" || e.Method.Equals(SelectedMethod, StringComparison.OrdinalIgnoreCase)) &&
                        (string.IsNullOrEmpty(query) || e.Path.ToLower().Contains(query) || 
                         e.ControllerName.ToLower().Contains(query) || e.HandlerMethod.ToLower().Contains(query)))
            .ToList();
    }

    private void OnFiltersChanged(string val)
    {
        SearchQuery = val;
        ApplyFilters();
        StateHasChanged();
    }

    private void SetMethodFilter(string method)
    {
        SelectedMethod = method;
        ApplyFilters();
        StateHasChanged();
    }

    private void OnEndpointSelected(AstEndpoint ep)
    {
        _selectedEndpoint = ep;
        StateHasChanged();
    }

    private string GetMethodBadgeClass(string method)
    {
        return method.ToUpper() switch
        {
            "GET" => "badge-get",
            "POST" => "badge-post",
            "PUT" => "badge-put",
            "DELETE" => "badge-delete",
            "PATCH" => "badge-patch",
            _ => "badge-other"
        };
    }

    private void ExportOpenApiJson(SwaggerSpec spec)
    {
        if (string.IsNullOrEmpty(spec.RawJsonOrYaml))
        {
            Snackbar.Add("No specification content available.", Severity.Warning);
            return;
        }

        Snackbar.Add($"Loaded OpenAPI Spec: '{spec.Title}'", Severity.Info);
        // Show Dialog or Log
    }
}
