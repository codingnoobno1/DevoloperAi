        {
            _workspaceRootPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "SyncroWorkspace");
        }
        _cacheSize = AstStorageService.GetCacheSize();
        _clonesSize = GitRepoService.GetClonesSize();
        StateHasChanged();
    }

    private async Task ChangeWorkspaceRoot()
    {
        try
        {
            var result = await FolderPicker.PickAsync(CancellationToken.None);
            if (result != null && result.IsSuccessful && result.Folder != null)
            {
                string newPath = result.Folder.Path;
                
                // Validate write permissions in target folder
                try
                {
                    if (!Directory.Exists(newPath))
                    {
                        Directory.CreateDirectory(newPath);
                    }
                    string testFile = Path.Combine(newPath, ".write_test");
                    await File.WriteAllTextAsync(testFile, "test");
                    File.Delete(testFile);
                }
                catch (Exception)
                {
                    Snackbar.Add("Selected folder is not writable. Please choose another folder.", Severity.Error);
                    return;
                }

                Microsoft.Maui.Storage.Preferences.Default.Set("__syncro_workspace_root__", newPath);
                Snackbar.Add($"Workspace root updated to: {newPath}", Severity.Success);
                UpdateWorkspaceStats();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to change workspace: {ex.Message}", Severity.Error);
        }
    }

    private void ResetWorkspaceRoot()
    {
        Microsoft.Maui.Storage.Preferences.Default.Remove("__syncro_workspace_root__");
        Snackbar.Add("Workspace root reset to default.", Severity.Info);
        UpdateWorkspaceStats();
    }

    private void ClearWorkspaceFiles()
    {
        try
        {
            AstStorageService.ClearCache();
            string clonesDir = GitRepoService.ClonesRootDirectory;
            if (Directory.Exists(clonesDir))
            {
                foreach (var dir in Directory.GetDirectories(clonesDir))
                {
                    try { Directory.Delete(dir, true); } catch { }
                }
                foreach (var file in Directory.GetFiles(clonesDir))
                {
                    try { File.Delete(file); } catch { }
                }
            }
            Snackbar.Add("Workspace cache and cloned repositories cleared.", Severity.Success);
            UpdateWorkspaceStats();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to clear workspace files: {ex.Message}", Severity.Error);
        }
    }

    private string FormatBytes(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB", "TB" };
        int counter = 0;
        decimal number = bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number = number / 1024;
            counter++;
        }
        return $"{number:n1} {suffixes[counter]}";
    }

    // ── CLI Integration Methods ───────────────────────────────────────────────

    /// <summary>
    /// Opens the Syncro CLI interactive shell in a new, separate console window.
    /// Runs syncro-cli.exe as an independent process so crashes cannot affect
    /// the MAUI Desktop UI.
    /// </summary>
    private void OpenNativeTerminal()
    {
        try
        {
            // Resolve CLI path: first try beside this exe, then fall back to PATH
            string? cliPath = ResolveCliPath();

            if (cliPath == null)
            {
                Snackbar.Add(
                    "syncro-cli.exe not found. Run 'syncro install' or build the Syncro.CLI project first.",
                    Severity.Warning);
                return;
            }

            // Working directory = active project path or workspace root
            string workDir = AstService.ActiveProjectMap?.ProjectPath
                ?? _workspaceRootPath
                ?? Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);

            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName        = "cmd.exe",
                Arguments       = $"/K \"{cliPath}\"",
                WorkingDirectory = Directory.Exists(workDir) ? workDir : Environment.CurrentDirectory,
                UseShellExecute  = true,   // Required for a new visible console window
                CreateNoWindow   = false,
                WindowStyle      = System.Diagnostics.ProcessWindowStyle.Normal
            };

            System.Diagnostics.Process.Start(psi);
            Snackbar.Add("Syncro CLI terminal opened.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to open terminal: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Triggers a UAC-elevated re-launch of syncro-cli.exe with the 'install'
    /// argument, which adds the CLI directory to the Windows Machine PATH.
    /// </summary>
    private void InstallCliToPath()
    {
        try
        {
            string? cliPath = ResolveCliPath();

            if (cliPath == null)
            {
                Snackbar.Add(
                    "syncro-cli.exe not found. Build the Syncro.CLI project first.",
                    Severity.Warning);
                return;
            }

            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName        = cliPath,
                Arguments       = "install",
                UseShellExecute = true,
                Verb            = "runas"   // Request UAC elevation
            };

            System.Diagnostics.Process.Start(psi);

            // Re-check status after a brief delay (the elevated process runs async)
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                CheckCliPathStatus();
                InvokeAsync(StateHasChanged);
            });

            Snackbar.Add("Launched elevated PATH installer. Check the UAC prompt.", Severity.Info);
        }
        catch (System.ComponentModel.Win32Exception)
        {
            // User cancelled UAC prompt
            Snackbar.Add("PATH installation cancelled by user.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to launch installer: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Checks whether the syncro-cli.exe directory is registered in the
    /// Windows Machine PATH variable and updates the <c>_isCliInPath</c> flag.
    /// </summary>
    private void CheckCliPathStatus()
    {
        try
        {
            string? cliPath = ResolveCliPath();
            if (cliPath == null)
            {
                _isCliInPath = false;
                return;
            }

            string cliDir = Path.GetDirectoryName(cliPath) ?? "";

            // Check both Machine and User PATH scopes
            string machinePath = Environment.GetEnvironmentVariable("PATH",
                EnvironmentVariableTarget.Machine) ?? "";
            string userPath = Environment.GetEnvironmentVariable("PATH",
                EnvironmentVariableTarget.User) ?? "";
            string processPath = Environment.GetEnvironmentVariable("PATH",
                EnvironmentVariableTarget.Process) ?? "";

            string allPaths = $"{machinePath};{userPath};{processPath}";

            _isCliInPath = allPaths
                .Split(';')
                .Any(p => p.Trim().Equals(cliDir, StringComparison.OrdinalIgnoreCase));
        }
        catch
        {
            _isCliInPath = false;
        }
    }

    /// <summary>
    /// Resolves the full path to syncro-cli.exe.
    /// Searches (in order): beside the current exe, in PATH via 'where'.
    /// </summary>
    private static string? ResolveCliPath()
    {
        // 1. Beside the running executable (published single-file layout)
        string exeDir = AppDomain.CurrentDomain.BaseDirectory;
        string candidate = Path.Combine(exeDir, "syncro-cli.exe");
        if (File.Exists(candidate)) return candidate;

        // 2. Sibling Syncro.CLI build output (Debug or Release)
        foreach (var config in new[] { "Debug", "Release" })
        {
            string sibling = Path.Combine(exeDir, "..", "..", "..", "..",
                "Syncro.CLI", "bin", config, "net9.0", "syncro-cli.exe");
            sibling = Path.GetFullPath(sibling);
            if (File.Exists(sibling)) return sibling;
        }

        // 3. Check system PATH (if already installed)
        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName               = "where",
                Arguments              = "syncro-cli",
                RedirectStandardOutput = true,
                UseShellExecute        = false,
                CreateNoWindow         = true
            };
            using var proc = System.Diagnostics.Process.Start(psi);
            string? line   = proc?.StandardOutput.ReadLine();
            proc?.WaitForExit();
            if (!string.IsNullOrWhiteSpace(line) && File.Exists(line.Trim()))
                return line.Trim();
        }
        catch { }

        return null;
    }
