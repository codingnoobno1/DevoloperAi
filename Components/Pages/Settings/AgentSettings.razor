    private string? _yamlError;

    private sealed class YamlRuleWhen
    {
        public List<string>? ConflictTypes { get; set; }
        public List<string>? GitCodes { get; set; }
        public List<string>? Branches { get; set; }
        public List<string>? Operations { get; set; }
    }

    private sealed class YamlRule
    {
        public string? Id { get; set; }
        public string? Name { get; set; }
        public YamlRuleWhen? When { get; set; }
        public List<string>? Chain { get; set; }
        public List<string>? Verify { get; set; }
        public string? Else { get; set; }
        public string? Approval { get; set; }
        public double? MinConfidence { get; set; }
        public bool? Shadow { get; set; }
    }

    /// <summary>Parses the YAML box into a rule and checks every id against the current policy.</summary>
    private ResolutionRule? ParseYamlRule(out string? error)
    {
        error = null;
        YamlRule? y;
        try
        {
            y = new YamlDotNet.Serialization.DeserializerBuilder()
                .WithNamingConvention(YamlDotNet.Serialization.NamingConventions.CamelCaseNamingConvention.Instance)
                .Build()
                .Deserialize<YamlRule>(_yamlRuleSnippet ?? "");
        }
        catch (Exception ex) { error = "YAML error: " + (ex.InnerException?.Message ?? ex.Message); return null; }

        if (y == null) { error = "The YAML is empty."; return null; }
        var types = y.When?.ConflictTypes ?? new List<string>();
        if (types.Count == 0) { error = "when.conflictTypes is required (use [\"*\"] for all)."; return null; }
        var unknownTypes = types.Where(t => t != "*" && !_d.Conflicts.ConflictTypes.Any(c => c.Id.Equals(t, StringComparison.OrdinalIgnoreCase))).ToList();
        if (unknownTypes.Count > 0) { error = "Unknown conflict type(s): " + string.Join(", ", unknownTypes); return null; }
        var chain = y.Chain ?? new List<string>();
        var unknownTech = chain.Where(t => !_d.Conflicts.Techniques.Any(x => x.Id.Equals(t, StringComparison.OrdinalIgnoreCase))).ToList();
        if (unknownTech.Count > 0) { error = "Unknown technique(s): " + string.Join(", ", unknownTech); return null; }
        var gates = y.Verify ?? new List<string>();
        var unknownGates = gates.Where(g => !_d.Conflicts.Gates.Any(x => x.Id.Equals(g, StringComparison.OrdinalIgnoreCase))).ToList();
        if (unknownGates.Count > 0) { error = "Unknown gate(s): " + string.Join(", ", unknownGates) + ". Known: " + string.Join(", ", _d.Conflicts.Gates.Select(g => g.Id)); return null; }
        var approval = y.Approval ?? "Ask";
        if (approval is not ("Auto Bypass" or "Auto + Notify" or "Ask" or "Locked Floor")) { error = "approval must be one of: Auto Bypass, Auto + Notify, Ask, Locked Floor."; return null; }

        int nextOrder = (_d.Conflicts.Rules.Count > 0 ? _d.Conflicts.Rules.Max(r => r.Order) : 0) + 1;
        var id = string.IsNullOrWhiteSpace(y.Id) ? $"rule-yaml-{nextOrder}" : y.Id.Trim();
        if (_d.Conflicts.Rules.Any(r => r.Id.Equals(id, StringComparison.OrdinalIgnoreCase))) { error = $"A rule with id '{id}' already exists."; return null; }

        return new ResolutionRule
        {
            Order = nextOrder,
            Id = id,
            Name = string.IsNullOrWhiteSpace(y.Name) ? id : y.Name.Trim(),
            ConflictTypes = types,
            GitCodes = y.When?.GitCodes is { Count: > 0 } gc ? gc : new List<string> { "UU" },
            Branches = y.When?.Branches is { Count: > 0 } br ? br : new List<string> { "*" },
            Operations = y.When?.Operations is { Count: > 0 } op ? op : new List<string> { "merge", "rebase", "cherry-pick", "pull" },
            Chain = chain,
            VerifyGates = gates,
            ElseAction = string.IsNullOrWhiteSpace(y.Else) ? "H1" : y.Else.Trim(),
            MinConfidence = y.MinConfidence ?? 0.85,
            ApprovalMode = approval,
            ShadowMode = y.Shadow ?? false,
        };
    }

    private async Task AddManualResolutionRule()
    {
        _yamlError = null;
        if (_ruleInputMode == "YAML")
        {
            var rule = ParseYamlRule(out var err);
            if (rule == null) { _yamlError = err; return; }
            _d.Conflicts.Rules.Add(rule);
            Flash($"Added rule #{rule.Order}: {rule.Name} (from YAML)");
            await RerunSimIfShown();
            return;
        }

        if (_ruleInputMode == "Plain English" && !string.IsNullOrWhiteSpace(_plainEnglishRulePrompt))
        {
            var nlRule = ConflictSvc.DraftRuleFromPlainEnglish(_plainEnglishRulePrompt, _d);
            _d.Conflicts.Rules.Add(nlRule);
            _plainEnglishRulePrompt = "";
            Flash($"Added rule #{nlRule.Order}: {nlRule.Name}");
            await RerunSimIfShown();
            return;
        }

        string typeId = _newRuleConflictType;
        if (typeId == "__custom__")
        {
            typeId = string.IsNullOrWhiteSpace(_customTypeId) ? "custom-type-" + (_d.Conflicts.ConflictTypes.Count + 1) : _customTypeId.Trim();
            if (!_d.Conflicts.ConflictTypes.Any(c => c.Id.Equals(typeId, StringComparison.OrdinalIgnoreCase)))
            {
                _d.Conflicts.ConflictTypes.Add(new ConflictTypeDef
                {
                    Id = typeId,
                    Label = typeId,
                    Globs = SplitList(_newRuleGlob),
                    Priority = 60,
                    Severity = _customTypeSeverity,
                    Description = "User-defined custom conflict type"
                });
            }
            _newRuleConflictType = typeId;
        }

        if (_ruleInputMode == "Script" && !string.IsNullOrWhiteSpace(_customScriptCommand))
        {
            var customTechId = "C_" + (_d.Conflicts.Techniques.Count + 1);
            _d.Conflicts.Techniques.Add(new TechniqueDef
            {
                Id = customTechId,
                Label = "Custom Script (" + customTechId + ")",
                Category = "custom",
                CommandOrHint = _customScriptCommand.Trim(),
                Risk = "medium",
                Reversible = true
            });
            _newRuleChain = new List<string> { customTechId };
        }

        int nextOrder = (_d.Conflicts.Rules.Count > 0 ? _d.Conflicts.Rules.Max(r => r.Order) : 0) + 1;
        var globDisplay = string.IsNullOrWhiteSpace(_newRuleGlob) ? "*" : _newRuleGlob;
        var added = new ResolutionRule
        {
            Order = nextOrder,
            Id = $"rule-{typeId}-{nextOrder}",
            Name = $"{typeId} ({globDisplay})",
            ConflictTypes = new List<string> { typeId },
            GitCodes = new List<string> { "UU" },
            Chain = _newRuleChain.Count > 0 ? new List<string>(_newRuleChain) : new List<string> { "T2", "A1" },
            VerifyGates = new List<string>(_newRuleGates),
            ElseAction = "H1",
            ApprovalMode = _newRuleApprovalMode
        };
        _d.Conflicts.Rules.Add(added);
        Flash($"Added Rule #{added.Order}: {added.Name}");
        await RerunSimIfShown();
    }

    private void PreviewPlainEnglishRule()
