        if (_draftedNlRule == null) return;
        _d.Conflicts.Rules.Add(_draftedNlRule);
        Flash($"Added Rule #{_draftedNlRule.Order}: {_draftedNlRule.Name}");
        _draftedNlRule = null;
        _plainEnglishRulePrompt = "";
    }

    private void ApplyStackTemplate(string stack)
    {
        int nextOrder = (_d.Conflicts.Rules.Count > 0 ? _d.Conflicts.Rules.Max(r => r.Order) : 15) + 1;
        if (stack == "dotnet")
        {
            _d.Conflicts.Rules.Add(new ResolutionRule
            {
                Order = nextOrder,
                Id = "tpl-dotnet-csproj",
                Name = "dotnet-csproj-sdk (*.csproj, Directory.Packages.props)",
                ConflictTypes = new() { "manifest-deps" },
                GitCodes = new() { "UU" },
                Chain = new() { "S3", "S5", "S1" },
                VerifyGates = new() { "build", "tests" },
                ApprovalMode = "Auto + Notify"
            });
            Flash("Applied .NET 9 MAUI conflict template pack.");
        }
        else if (stack == "flutter")
        {
            _d.Conflicts.Rules.Add(new ResolutionRule
            {
                Order = nextOrder,
                Id = "tpl-flutter-codegen",
                Name = "flutter-codegen (*.g.dart, *.freezed.dart, pubspec.lock)",
                ConflictTypes = new() { "generated", "lockfile" },
                GitCodes = new() { "UU", "AA" },
                Chain = new() { "S2", "S1" },
                VerifyGates = new() { "build" },
                ApprovalMode = "Auto Bypass"
            });
            Flash("Applied Flutter / Dart conflict template pack.");
        }
        else if (stack == "nextjs")
        {
            _d.Conflicts.Rules.Add(new ResolutionRule
            {
                Order = nextOrder,
                Id = "tpl-nextjs-lock",
                Name = "nextjs-lock-and-routes (pnpm-lock.yaml, app/api/**)",
                ConflictTypes = new() { "lockfile", "api-contract" },
                GitCodes = new() { "UU" },
                Chain = new() { "S1", "S6", "S9" },
                VerifyGates = new() { "contract", "build" },
                ApprovalMode = "Auto + Notify"
            });
            Flash("Applied Next.js / TypeScript conflict template pack.");
        }
    }

    private void ImportRepoGitAttributes()
    {
        int nextOrder = (_d.Conflicts.Rules.Count > 0 ? _d.Conflicts.Rules.Max(r => r.Order) : 15) + 1;
        var imp = ConflictSvc.ImportFromGitAttributes(_simRepo, nextOrder);
        foreach (var t in imp.Types.Where(t => !_d.Conflicts.ConflictTypes.Any(x => x.Id == t.Id))) _d.Conflicts.ConflictTypes.Add(t);
        foreach (var t in imp.Techniques.Where(t => !_d.Conflicts.Techniques.Any(x => x.Id == t.Id))) _d.Conflicts.Techniques.Add(t);
        foreach (var r in imp.Rules) _d.Conflicts.Rules.Add(r);
        Flash(imp.Message);
    }

    private void PromoteLearnedSuggestion(LearnedRuleSuggestion s)
    {
        int nextOrder = (_d.Conflicts.Rules.Count > 0 ? _d.Conflicts.Rules.Max(r => r.Order) : 15) + 1;
        _d.Conflicts.Rules.Add(new ResolutionRule
        {
            Order = nextOrder,
            Id = "learned-" + s.ConflictTypeId + "-" + nextOrder,
            Name = $"{s.ConflictTypeId} ({s.Pattern})",
            ConflictTypes = new() { s.ConflictTypeId },
            GitCodes = new() { "UU" },
            Chain = new List<string>(s.ChainIds),
            VerifyGates = new List<string>(s.Gates),
            ElseAction = "H1",
            ApprovalMode = "Auto + Notify"
        });
        Flash($"Promoted learned pattern '{s.Pattern}' to Rule #{nextOrder}.");
    }

    private static string BadgeClass(string mode) => mode switch
    {
        "Locked Floor" => "floor",
        "Auto Bypass" => "auto",
        "Auto + Notify" => "notify",
        _ => "ask"
    };

    private static string FormatGateName(string g) => g switch
    {
        "build" => "Build",
        "tests" => "Tests",
        "contract" => "ContractEngine",
        "sast" => "SAST",
        "no-markers" => "NoMarkers",
        _ => g
    };

    private void Reload()
    {
        _d = Store.Snapshot();
        _saved = Store.ToJson(_d);
    }

    private bool Dirty => Store.ToJson(_d) != _saved;

    private string? Invalid
    {
        get
        {
            var b = _d.Bypass;
            if (b.AutoMax < 0 || b.AskMax > 100) return "Decision bands must be between 0 and 100.";
            if (!(b.AutoMax <= b.NotifyMax && b.NotifyMax <= b.AskMax)) return "Decision bands must go up: Auto ≤ Notify ≤ Ask.";
            if (_d.Model.MaxToolCalls < 1) return "Max tool calls must be at least 1.";
            if (_d.Approvals.TimeoutMinutes < 1) return "Approval timeout must be at least 1 minute.";
            if (_d.Environments.Branches.Any(r => string.IsNullOrWhiteSpace(r.Pattern))) return "Every environment rule needs a branch glob.";
            return null;
        }
    }

    private void Save()
    {
        if (Invalid != null) return;
        Store.Save(_d, $"Agent Settings saved ({(Tabs.FirstOrDefault(t => t.Id == _tab)?.Label ?? _tab)})");
        Reload();
        Flash("Saved to AgentPolicyStore and recorded in Audit Log.");
    }

    private void Discard()
    {
        Reload();
        Flash("Changes discarded.");
    }

    private void OnStoreChanged(AgentPolicy p) => InvokeAsync(() =>
    {
        if (!Dirty) Reload();
        else _saved = Store.ToJson(Store.Current);
        StateHasChanged();
    });

    private void Refresh() => InvokeAsync(StateHasChanged);
    private void OnAudit(AuditEntry _) => InvokeAsync(StateHasChanged);

    private async void Flash(string msg)
    {
        _flash = msg;
        StateHasChanged();
        await Task.Delay(2500);
        if (_flash == msg) { _flash = null; await InvokeAsync(StateHasChanged); }
    }

    private IEnumerable<TabDef> VisibleTabs(string section) =>
        Tabs.Where(t => t.Section == section && (string.IsNullOrWhiteSpace(_search)
            || t.Label.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || t.Keywords.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || t.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    // ── model tab ──
    private string KeySource()
    {
        if (Keys.Has("groq")) return "saved in Windows Credential Manager";
        if (!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("GROQ_API_KEY"))) return "from GROQ_API_KEY environment variable";
        return "not set";
    }

    private string MaskedKey() => ApiKeyStore.Mask(Keys.Get("groq") ?? Environment.GetEnvironmentVariable("GROQ_API_KEY"));

    private string KeyStateText => _keyState switch
    {
        KeyState.Connected => "Connected",
        KeyState.Failed => "Connection failed",
        KeyState.Testing => "Testing…",
        KeyState.Missing => "No key",
        _ => Groq?.HasKey == true ? "Not tested" : "No key",
    };

    private async Task TestKey()
    {
        var key = Keys.Get("groq") ?? Environment.GetEnvironmentVariable("GROQ_API_KEY");
        if (string.IsNullOrWhiteSpace(key)) { _keyState = KeyState.Missing; return; }
        _keyState = KeyState.Testing;
        StateHasChanged();
        var ok = await Llm.ValidateConnectionAsync(key);
        _keyState = ok ? KeyState.Connected : KeyState.Failed;
    }

    private async Task SaveKey()
    {
        var key = _keyInput.Trim();
        _keyState = KeyState.Testing;
        StateHasChanged();
        if (!await Llm.ValidateConnectionAsync(key))
        {
            _keyState = KeyState.Failed;
            return;
        }
        if (!Keys.Set("groq", key)) { Flash("Could not save the key to Windows Credential Manager."); return; }
        Groq?.Initialize(key);
        _keyInput = "";
        _editKey = false;
        _keyState = KeyState.Connected;
        Audit.Append(new AuditEntry { Origin = "settings", Tool = "api-key", Approver = "user", Outcome = "saved", Target = "Groq API key changed" });
    }

    private void ClearKey()
    {
        Keys.Clear("groq");
        var env = Environment.GetEnvironmentVariable("GROQ_API_KEY");
        try { Groq?.Initialize(env ?? ""); } catch { }
        _keyState = string.IsNullOrEmpty(env) ? KeyState.Missing : KeyState.Unknown;
        Audit.Append(new AuditEntry { Origin = "settings", Tool = "api-key", Approver = "user", Outcome = "saved", Target = "Groq API key removed" });
    }

    private void ToggleSource(string id)
    {
        if (!_d.Model.ContextSources.Remove(id)) _d.Model.ContextSources.Add(id);
    }

    private int UsagePct() => _d.Model.DailyTokenBudget > 0 ? (int)Math.Round(100.0 * Usage.UsedToday / _d.Model.DailyTokenBudget) : 0;

    private static string Short(long n) => n >= 1_000_000 ? $"{n / 1_000_000.0:0.#}M" : n >= 1000 ? $"{n / 1000.0:0.#}K" : n.ToString();

    // ── tools tab ──
    private IEnumerable<IMcpTool> FilteredTools() =>
        Orchestrator.Tools
            .Where(t => string.IsNullOrWhiteSpace(_toolFilter) || t.Name.Contains(_toolFilter, StringComparison.OrdinalIgnoreCase) || t.Description.Contains(_toolFilter, StringComparison.OrdinalIgnoreCase))
            .Where(t => string.IsNullOrEmpty(_classFilter) || ToolCatalog.Classify(t.Name).ToString() == _classFilter)
            .OrderByDescending(t => (int)ToolCatalog.Classify(t.Name)).ThenBy(t => t.Name);

    private string OverrideOf(string tool) =>
        _d.Bypass.ToolOverrides.FirstOrDefault(kv => string.Equals(kv.Key, tool, StringComparison.OrdinalIgnoreCase)).Value.ToString();

    private void SetOverride(string tool, string? value)
    {
        foreach (var k in _d.Bypass.ToolOverrides.Keys.Where(k => string.Equals(k, tool, StringComparison.OrdinalIgnoreCase)).ToList())
            _d.Bypass.ToolOverrides.Remove(k);
        if (Enum.TryParse<ToolOverride>(value, out var ov) && ov != ToolOverride.Default) _d.Bypass.ToolOverrides[tool] = ov;
    }

    private DecisionResult PreviewDecision() => Decider.Decide(_pvTool, ToolCallFacts.From(_pvJson), _pvOrigin, _d);

    private static string OverrideLabel(ToolOverride o) => o switch
    {
        ToolOverride.AlwaysAsk => "Always ask",
        ToolOverride.AutoIfSafe => "Auto if safe",
        ToolOverride.Block => "Blocked",
        _ => "Default",
    };

    private static string DecisionText(Decision d) => d switch
    {
        Decision.Auto => "Auto",
        Decision.AutoNotify => "Auto + notify",
        Decision.Ask => "Ask",
        Decision.AskDoubleConfirm => "Ask + confirm",
        Decision.Block => "Block",
        _ => d.ToString(),
    };

    // ── permissions tab ──
    private RenderFragment Verdict(PermissionResult? r) => __builder =>
    {
        if (r == null) return;
        var (cls, text) = r.Verdict switch
        {
            PermissionVerdict.Allowed => ("ok", "Allowed"),
            PermissionVerdict.NeedsApproval => ("ask", "Needs approval"),
            _ => ("no", "Blocked"),
        };
        <div class="as-verdict @cls"><b>@text</b> @(string.IsNullOrEmpty(r.Why) ? "" : "— " + r.Why)</div>
    };

    // ── sync tab ──
    private void AddRepo()
    {
        var path = _newRepo.Trim().Trim('"');
        if (path.Length == 0 || _d.GitSync.Repos.Any(r => string.Equals(r.Repo, path, StringComparison.OrdinalIgnoreCase))) return;
        _d.GitSync.Repos.Add(new GitSyncRepo { Repo = path, AutoFetch = true });
        _newRepo = "";
    }

    private static List<string> SplitList(string? s) =>
        (s ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList();

    // ── audit tab ──
    private IEnumerable<AuditEntry> FilteredAudit() =>
        Audit.Recent
            .Where(e => string.IsNullOrEmpty(_auditOutcome) || e.Outcome == _auditOutcome)
            .Where(e => string.IsNullOrWhiteSpace(_auditFilter) || e.Tool.Contains(_auditFilter, StringComparison.OrdinalIgnoreCase)
                        || e.Target.Contains(_auditFilter, StringComparison.OrdinalIgnoreCase) || e.Origin.Contains(_auditFilter, StringComparison.OrdinalIgnoreCase))
            .Take(300);

    private void OpenAuditFolder()
    {
        try
        {
            Directory.CreateDirectory(Path.GetDirectoryName(Audit.FilePath)!);
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("explorer.exe", $"\"{Path.GetDirectoryName(Audit.FilePath)}\"") { UseShellExecute = true });
        }
        catch (Exception ex) { Flash($"Could not open folder: {ex.Message}"); }
    }

    // ── export ──
    private void ExportYaml()
    {
        var s = new YamlDotNet.Serialization.SerializerBuilder()
            .WithNamingConvention(YamlDotNet.Serialization.NamingConventions.CamelCaseNamingConvention.Instance)
            .Build();
        _yaml = "# Syncro agent policy — export only (Syncro reads %LOCALAPPDATA%/SyncroDesktop/agent/policy.json, not this file) — exported" + DateTime.Now.ToString("yyyy-MM-dd HH:mm") + (Dirty ? " (includes unsaved changes)" : "") + "\n" + s.Serialize(_d);
    }

    private async Task CopyYaml()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _yaml); Flash("Copied YAML to clipboard."); }
        catch { Flash("Copy failed — select the text instead."); }
    }

    private static string Trunc(string s, int n) => string.IsNullOrEmpty(s) || s.Length <= n ? s : s[..n] + "…";

    public void Dispose()
    {
        Approvals.Changed -= Refresh;
        Audit.Appended -= OnAudit;
        Usage.Changed -= Refresh;
        Store.Changed -= OnStoreChanged;
        AgentStatus.Changed -= Refresh;
    }
}
