    private void MoveRule(ResolutionRule rule, int delta)
    {
        var ordered = _d.Conflicts.Rules.OrderBy(r => r.Order).ToList();
        int idx = ordered.IndexOf(rule);
        int targetIdx = idx + delta;
        if (idx < 0 || targetIdx < 0 || targetIdx >= ordered.Count) return;
        if (ordered[targetIdx].Final) return; // cannot move above a locked floor rule

        (ordered[idx].Order, ordered[targetIdx].Order) = (ordered[targetIdx].Order, ordered[idx].Order);
    }

    private void RemoveRule(ResolutionRule rule)
    {
        if (rule.Final) return;
        _d.Conflicts.Rules.Remove(rule);
        int order = 1;
        foreach (var r in _d.Conflicts.Rules.OrderBy(x => x.Order))
            r.Order = order++;
    }

