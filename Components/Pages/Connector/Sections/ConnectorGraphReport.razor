@using MudBlazor
@using Syncro.Desktop.Services.Connector.Models
@using Syncro.Desktop.Services.Connector.Matching

@if (Report != null)
{
    <MudPaper Elevation="0" Class="panel pa-4 mb-4">
        <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-2">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Connection Graph</MudText>
            </div>
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">@Report.Matched matched</MudChip>
                @if (Report.MethodMismatch > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">@Report.MethodMismatch method</MudChip>
                }
                @if (Report.ShapeMismatch > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@Report.ShapeMismatch shape</MudChip>
                }
                @if (Report.Missing > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">@Report.Missing missing</MudChip>
                }
                @if (Report.OrphanRoutes.Count > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@Report.OrphanRoutes.Count orphan</MudChip>
                }
            </div>
        </div>

        <div class="d-flex align-center gap-3 mb-3 conn-legend">
            <span><span class="verb-badge verb-get" style="padding:2px 8px;">FE</span> @(FrontendContract?.Stack) · @(FrontendContract?.Calls.Count ?? 0) calls</span>
            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" />
            <span><span class="verb-badge verb-put" style="padding:2px 8px;">BE</span> @(BackendContract?.Stack) · @(BackendContract?.Routes.Count ?? 0) routes</span>
        </div>

        @if (Report.Edges.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="text-muted pa-4 text-center">No API calls were found in the frontend to map.</MudText>
        }
        else
        {
            <div class="edge-list">
                @foreach (var e in Report.Edges)
                {
                    <div class="edge-row @EdgeStateClass(e.State)">
                        <span class="verb-badge @VerbClass(e.Call.Method)">@e.Call.Method.ToString().ToUpperInvariant()</span>
                        <span class="edge-call">@e.Call.PathTemplate</span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowRightAlt" Size="Size.Small" Class="edge-arrow" />
                        <span class="edge-route">@(e.Route?.PathTemplate ?? "— no backend route —")</span>
                        <span class="edge-state">@StateLabel(e.State)</span>
                        @if (e.State == MatchState.Missing)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.AutoFixHigh" Class="edge-draft"
                                       OnClick="() => OnDraftFromMissing.InvokeAsync(e)">Draft</MudButton>
                        }
                        else
                        {
                            <span class="edge-draft"></span>
                        }
                    </div>
                    @if (e.Diffs.Count > 0)
                    {
                        <div class="edge-diffs">
                            @foreach (var d in e.Diffs)
                            {
                                <div class="edge-diff">@d</div>
                            }
                        </div>
                    }
                }
            </div>

            @if (Report.OrphanRoutes.Count > 0)
            {
                <MudText Typo="Typo.caption" Class="text-muted mt-3 d-block">Backend routes no frontend call reaches:</MudText>
                <div class="orphan-list">
                    @foreach (var r in Report.OrphanRoutes)
                    {
                        <span class="orphan-chip"><span class="verb-badge @VerbClass(r.Method)">@r.Method.ToString().ToUpperInvariant()</span> @r.PathTemplate</span>
                    }
                </div>
            }
        }
    </MudPaper>
}

<style>
    .conn-legend { font-size: 12px; color: var(--mud-palette-text-secondary); }
    .edge-list { display: flex; flex-direction: column; }
    .edge-row { display: grid; grid-template-columns: 64px minmax(0,1fr) 24px minmax(0,1fr) 120px 72px;
        align-items: center; gap: 10px; padding: 8px 10px; border-radius: 6px; font-size: 13px;
        border-left: 3px solid transparent; }
    .edge-call, .edge-route { font-family: 'Cascadia Code','Fira Code',monospace; overflow: hidden;
        text-overflow: ellipsis; white-space: nowrap; }
    .edge-route { color: var(--mud-palette-text-secondary); }
    .edge-arrow { color: var(--mud-palette-text-secondary); }
    .edge-state { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; text-align: right; }
    .edge-draft { justify-self: end; }

    .edge-matched { background: rgba(16,185,129,.06); border-left-color: #10b981; }
    .edge-matched .edge-state { color: #10b981; }
    .edge-method { background: rgba(245,158,11,.07); border-left-color: #f59e0b; }
    .edge-method .edge-state, .edge-shape .edge-state { color: #f59e0b; }
    .edge-shape { background: rgba(245,158,11,.05); border-left-color: #f59e0b; }
    .edge-missing { background: rgba(239,68,68,.07); border-left-color: #ef4444; }
    .edge-missing .edge-state { color: #ef4444; }
    .edge-missing .edge-route { color: #ef4444; opacity: .8; }

    .edge-diffs { padding: 2px 10px 8px 84px; }
    .edge-diff { font-size: 11.5px; color: var(--mud-palette-text-secondary); }
    .edge-diff:before { content: "↳ "; color: var(--mud-palette-primary); }

    .orphan-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
    .orphan-chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 8px; border-radius: 6px;
        background: var(--mud-palette-background-grey); font-size: 12px; font-family: 'Cascadia Code',monospace; }

    .verb-badge { font-size: 10px; font-weight: 700; text-align: center; padding: 3px 6px; border-radius: 5px;
        color: #fff; letter-spacing: .03em; }
    .verb-get { background: #10b981; }
    .verb-post { background: #f59e0b; }
    .verb-put { background: #3b82f6; }
    .verb-patch { background: #8b5cf6; }
    .verb-delete { background: #ef4444; }
    .verb-other { background: #64748b; }
</style>

@code {
    [Parameter] public ConnectionReport? Report { get; set; }
    [Parameter] public FrontendContract? FrontendContract { get; set; }
    [Parameter] public BackendContract? BackendContract { get; set; }
    [Parameter] public EventCallback<ConnectionEdge> OnDraftFromMissing { get; set; }

    private static string VerbClass(HttpVerb v) => v switch
    {
        HttpVerb.Get => "verb-get",
        HttpVerb.Post => "verb-post",
        HttpVerb.Put => "verb-put",
        HttpVerb.Patch => "verb-patch",
        HttpVerb.Delete => "verb-delete",
        _ => "verb-other"
    };

    private static string EdgeStateClass(MatchState s) => s switch
    {
        MatchState.Matched => "edge-matched",
        MatchState.ShapeMismatch => "edge-shape",
        MatchState.MethodMismatch => "edge-method",
        MatchState.Missing => "edge-missing",
        _ => ""
    };

    private static string StateLabel(MatchState s) => s switch
    {
        MatchState.Matched => "matched",
        MatchState.ShapeMismatch => "shape",
        MatchState.MethodMismatch => "method",
        MatchState.Missing => "missing",
        _ => ""
    };
}
