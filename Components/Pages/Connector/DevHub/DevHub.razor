                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Flutter devices -->
                        <div class="device-section">
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                                <div class="device-section-title">Flutter Devices</div>
                                <span class="avail-badge @(_flutterAvail ? "avail-ok" : "avail-no")">
                                    flutter @(_flutterAvail ? "Ready" : "Not Found")
                                </span>
                            </div>
                            @if (_flutterDevices.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Class="text-muted">
                                    @(_flutterAvail ? "No Flutter devices found. Start an emulator or connect a device." : "Flutter not found in PATH.")
                                </MudText>
                            }
                            else
                            {
                                @foreach (var d in _flutterDevices)
                                {
                                    <div style="padding:6px 10px;font-size:12px;font-family:monospace;color:var(--mud-palette-text-secondary);border-bottom:1px solid var(--mud-palette-divider);">
