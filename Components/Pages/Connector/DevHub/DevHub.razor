    private static string GetSdClass(RunStatus? s) => s?.State switch
    {
        "running" => "sd sd-run",
        "healthy" => "sd sd-ok",
        "starting"=> "sd sd-start",
        "crashed" => "sd sd-err",
        _         => "sd sd-idle"
    };

    private static string GetStateLabel(RunStatus? s) => s?.State switch
    {
        "running" => "Running",
        "healthy" => "Healthy",
        "starting"=> "Starting…",
        "crashed" => "Crashed",
        "stopped" => "Stopped",
        _         => "Idle"
    };

    private static string GetLogStyle(string line)
    {
        var lo = line.ToLowerInvariant();
        if (lo.Contains("error") || lo.Contains("fail")) return "color:#f87171;";
        if (lo.Contains("warn"))  return "color:#fbbf24;";
        if (lo.Contains("ready") || lo.Contains("compiled") || lo.Contains("started")) return "color:#34d399;";
        if (lo.Contains("http://") || lo.Contains("localhost")) return "color:#60a5fa;";
        return "";
    }

    private static string GetMethodColor(string m) => m switch
    {
        "GET"    => "#10b981",
        "POST"   => "#f59e0b",
        "PUT"    => "#6366f1",
        "PATCH"  => "#8b5cf6",
        "DELETE" => "#ef4444",
        _        => "inherit"
    };

    private static string GetStatusClass(int s)
    {
        if (s >= 500) return "sts-5xx";
        if (s >= 400) return "sts-4xx";
        if (s >= 300) return "sts-3xx";
        if (s >= 200) return "sts-2xx";
        return "";
    }

    private static string GetStatusText(int s) => s switch
    {
        200 => "OK", 201 => "Created", 204 => "No Content",
        400 => "Bad Request", 401 => "Unauthorized", 403 => "Forbidden",
        404 => "Not Found", 409 => "Conflict", 422 => "Unprocessable Entity",
        500 => "Internal Server Error", 502 => "Bad Gateway", 503 => "Service Unavailable",
        _ => ""
    };

    private static string GetNetMethodClass(string m) => m switch
    {
        "GET"    => "nm-get",
        "POST"   => "nm-post",
        "PUT"    => "nm-put",
        "PATCH"  => "nm-patch",
        "DELETE" => "nm-delete",
        _        => "nm-other"
    };

    private static string GetNetStatusColor(int s)
    {
        if (s >= 500) return "#ef4444";
        if (s >= 400) return "#f59e0b";
        if (s >= 200) return "#10b981";
        return "inherit";
    }
