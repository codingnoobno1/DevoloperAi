                    </MudAlert>
                }
                else
                {
                    <div class="swagger-project-list">
                        @foreach (var node in BackendProjects)
                        {
                            var alive2 = node.RunState?.State is "running" or "healthy";
                            <div class="swagger-card" style="--pc:@DomainDetector.GetColor(node.Domain);">
                                <span style="color:@DomainDetector.GetColor(node.Domain);">
