@namespace Syncro.Desktop.Components.Pages.Connector.DevHub
@using System.Net.Http
@using System.Net.Http.Headers
@using System.Text
@using System.IO
@using Syncro.Desktop.Services.Connector.Adb
@using Syncro.Desktop.Services.Connector.DevHub
@using Syncro.Desktop.Services.Connector.ProjectDomain
@using Syncro.Desktop.Services.Universe.Runtime
@inject StackRunManager RunManager
@inject DevHubState Hub
@inject ISnackbar Snackbar
@implements IDisposable

<!-- ═══════════════════════════════════════ DevHub ═══════════════════════ -->
<style>
    /* ── Root ── */
    .dh { display:flex; flex-direction:column; height:100vh;
          background:var(--mud-palette-background); font-family:Inter,system-ui,sans-serif; }

    /* ── Header bar ── */
    .dh-topbar {
        display:flex; align-items:center; gap:12px; padding:10px 20px;
        background:var(--mud-palette-surface);
        border-bottom:1px solid var(--mud-palette-divider);
        flex-shrink:0;
    }
    .dh-logo {
        width:36px; height:36px; border-radius:9px; flex-shrink:0;
        background:linear-gradient(135deg,#6366f1,#06b6d4);
        display:flex; align-items:center; justify-content:center;
        box-shadow:0 3px 10px rgba(99,102,241,.4);
    }
    .dh-title { font-weight:800; font-size:16px; letter-spacing:-.02em; }
    .dh-subtitle { font-size:11px; color:var(--mud-palette-text-secondary); }
    .dh-health-chip {
        display:inline-flex; align-items:center; gap:5px; padding:3px 10px;
        border-radius:20px; font-size:11px; font-weight:700;
    }
    .dh-healthy { background:rgba(16,185,129,.14); color:#10b981; }
    .dh-partial { background:rgba(245,158,11,.14); color:#f59e0b; }
    .dh-offline { background:rgba(100,116,139,.14); color:#64748b; }

    /* ── Sidebar nav ── */
    .dh-body { display:flex; flex:1; overflow:hidden; }
    .dh-sidebar {
        width:64px; display:flex; flex-direction:column; align-items:center;
        padding:12px 0; gap:4px; flex-shrink:0;
        background:var(--mud-palette-surface);
        border-right:1px solid var(--mud-palette-divider);
    }
    .dh-nav-btn {
        width:48px; height:48px; border-radius:12px; border:none; cursor:pointer;
        display:flex; flex-direction:column; align-items:center; justify-content:center;
        gap:2px; transition:all .2s; color:var(--mud-palette-text-secondary);
        background:transparent; font-size:9px; font-weight:700; letter-spacing:.03em;
    }
    .dh-nav-btn:hover { background:var(--mud-palette-action-hover); color:var(--mud-palette-text-primary); }
    .dh-nav-btn.active {
        background:rgba(99,102,241,.15); color:#818cf8;
        box-shadow:inset 2px 0 0 #818cf8;
    }
    .dh-nav-sep { width:32px; height:1px; background:var(--mud-palette-divider); margin:4px 0; }

    /* ── Content ── */
    .dh-content { flex:1; overflow-y:auto; overflow-x:hidden; padding:20px 24px; }

    /* ── Section header ── */
    .dh-sec-hdr {
        display:flex; align-items:center; justify-content:space-between;
        margin-bottom:16px; flex-wrap:wrap; gap:8px;
    }
    .dh-sec-title { font-size:18px; font-weight:700; }

    /* ── Project card ── */
    .dh-proj-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:14px; }
    .dh-proj-card {
        border-radius:14px; padding:16px; position:relative; overflow:hidden;
        background:var(--mud-palette-surface);
        border:1.5px solid var(--mud-palette-divider);
        transition:all .2s;
    }
    .dh-proj-card:hover { transform:translateY(-2px); border-color:var(--pc); box-shadow:0 6px 20px rgba(0,0,0,.12); }
    .dh-proj-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:var(--pc); }
    .dh-domain-badge {
        display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:6px;
        font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
        background:color-mix(in srgb,var(--pc) 14%,transparent); color:var(--pc); margin-bottom:10px;
    }
    .dh-card-name { font-weight:700; font-size:15px; margin-bottom:2px;
                    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .dh-card-stack { font-size:11px; color:var(--mud-palette-text-secondary); margin-bottom:10px; }
    .dh-card-port { font-family:monospace; font-size:12px; color:var(--pc); font-weight:700; }
    .dh-card-status { display:flex; align-items:center; gap:6px; font-size:12px; margin-bottom:12px; }
    .dh-card-actions { display:flex; flex-wrap:wrap; gap:6px; }

    /* ── Status dot ── */
    .sd { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
    .sd-run { background:#10b981; box-shadow:0 0 6px #10b981; animation:pulse-dh 2s infinite; }
    .sd-ok  { background:#10b981; }
    .sd-start{ background:#f59e0b; }
    .sd-err { background:#ef4444; }
    .sd-idle{ background:#64748b; }
    @@keyframes pulse-dh { 0%,100%{opacity:1}50%{opacity:.4} }

    /* ── API Tester ── */
    .api-request-bar {
        display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap; align-items:center;
    }
    .api-method-select {
        padding:8px 12px; border-radius:8px; font-weight:700; font-family:monospace;
        border:1.5px solid var(--mud-palette-divider); cursor:pointer;
        background:var(--mud-palette-surface); color:var(--mud-palette-text-primary);
        font-size:13px; min-width:90px;
    }
    .api-url-input {
        flex:1; padding:8px 14px; border-radius:8px; font-family:monospace; font-size:13px;
        border:1.5px solid var(--mud-palette-divider);
        background:var(--mud-palette-surface); color:var(--mud-palette-text-primary);
        min-width:200px;
    }
    .api-url-input:focus { outline:none; border-color:#818cf8; }
    .api-tabs { display:flex; gap:0; margin-bottom:12px; border-bottom:2px solid var(--mud-palette-divider); }
    .api-tab {
        padding:8px 16px; cursor:pointer; font-size:13px; font-weight:600;
        color:var(--mud-palette-text-secondary); border-bottom:2px solid transparent;
        margin-bottom:-2px; transition:all .15s;
    }
    .api-tab.active { color:#818cf8; border-bottom-color:#818cf8; }
    .api-header-row { display:grid; grid-template-columns:1fr 1fr 32px; gap:6px; margin-bottom:6px; }
    .api-hdr-input {
        padding:6px 10px; border-radius:6px; font-size:12px;
        border:1px solid var(--mud-palette-divider);
        background:var(--mud-palette-surface); color:var(--mud-palette-text-primary);
    }
    .api-body-editor {
        width:100%; min-height:120px; padding:10px 14px; border-radius:8px;
        font-family:'Cascadia Code',monospace; font-size:12px;
        border:1.5px solid var(--mud-palette-divider);
        background:var(--mud-palette-surface); color:var(--mud-palette-text-primary);
        resize:vertical; box-sizing:border-box;
    }
    .api-body-editor:focus { outline:none; border-color:#818cf8; }
    .api-response {
        border-radius:10px; border:1.5px solid var(--mud-palette-divider);
        background:var(--mud-palette-surface); overflow:hidden; margin-top:16px;
    }
    .api-resp-hdr {
        display:flex; align-items:center; gap:12px; padding:10px 14px;
        background:var(--mud-palette-background); border-bottom:1px solid var(--mud-palette-divider);
    }
    .api-status { padding:3px 10px; border-radius:6px; font-weight:700; font-family:monospace; font-size:13px; }
    .sts-2xx { background:rgba(16,185,129,.15); color:#10b981; }
    .sts-3xx { background:rgba(99,102,241,.15); color:#818cf8; }
    .sts-4xx { background:rgba(245,158,11,.15); color:#f59e0b; }
    .sts-5xx { background:rgba(239,68,68,.15);  color:#ef4444; }
    .api-resp-body {
        padding:14px; font-family:'Cascadia Code',monospace; font-size:12px;
        max-height:320px; overflow-y:auto; white-space:pre-wrap; word-break:break-all;
        line-height:1.6; color:var(--mud-palette-text-primary);
    }

    /* ── Swagger panel ── */
    .swagger-project-list { display:flex; flex-direction:column; gap:10px; }
    .swagger-card {
        border-radius:12px; padding:16px; background:var(--mud-palette-surface);
        border:1.5px solid var(--mud-palette-divider); display:flex; align-items:center;
        gap:14px; flex-wrap:wrap;
    }
    .swagger-url { font-family:monospace; font-size:12px; color:var(--mud-palette-text-secondary);
                   flex:1; min-width:200px; }

    /* ── Device panel ── */
    .device-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
    .device-section { background:var(--mud-palette-surface); border-radius:14px; padding:18px;
                      border:1.5px solid var(--mud-palette-divider); }
    .device-section-title { font-weight:700; font-size:13px; text-transform:uppercase;
                             letter-spacing:.06em; color:var(--mud-palette-text-secondary);
                             margin-bottom:14px; }
    .device-row {
        display:flex; align-items:center; gap:10px; padding:10px 12px;
        border-radius:10px; margin-bottom:8px;
        background:var(--mud-palette-background);
        border:1px solid var(--mud-palette-divider);
    }
    .device-model { font-weight:700; font-size:13px; flex:1; }
    .device-id { font-family:monospace; font-size:11px; color:var(--mud-palette-text-secondary); }
    .device-auth { font-size:10px; padding:2px 6px; border-radius:4px; font-weight:700; }
    .da-ok  { background:rgba(16,185,129,.14); color:#10b981; }
    .da-no  { background:rgba(239,68,68,.14); color:#ef4444; }

    /* ── Phone graphic ── */
    .phone-frame {
        width:160px; height:300px; border-radius:28px; margin:0 auto;
        background:var(--mud-palette-background); border:4px solid var(--mud-palette-divider);
        display:flex; flex-direction:column; align-items:center; padding:14px 10px;
        box-shadow:0 12px 32px rgba(0,0,0,.18); position:relative; overflow:hidden;
    }
    .phone-notch { width:60px; height:12px; background:var(--mud-palette-divider);
                   border-radius:0 0 10px 10px; margin-bottom:12px; }
    .phone-screen { flex:1; width:100%; border-radius:12px;
                    background:var(--mud-palette-surface); display:flex;
                    align-items:center; justify-content:center; }
    .phone-home-bar { width:50px; height:4px; border-radius:2px;
                      background:var(--mud-palette-divider); margin-top:10px; }

    /* ── Network log ── */
    .net-log-bar { display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap; align-items:center; }
    .net-log-table { width:100%; border-collapse:collapse; font-size:12px; }
    .net-log-table th {
        text-align:left; padding:8px 10px; font-size:10px; font-weight:700; text-transform:uppercase;
        letter-spacing:.06em; color:var(--mud-palette-text-secondary);
        border-bottom:2px solid var(--mud-palette-divider);
    }
    .net-log-table td { padding:7px 10px; border-bottom:1px solid var(--mud-palette-divider); }
    .net-log-table tr:hover td { background:var(--mud-palette-action-hover); }
    .net-method { font-family:monospace; font-weight:700; padding:2px 6px; border-radius:4px; font-size:11px; }
    .nm-get    { background:rgba(16,185,129,.14); color:#10b981; }
    .nm-post   { background:rgba(245,158,11,.14); color:#f59e0b; }
    .nm-put    { background:rgba(99,102,241,.14); color:#818cf8; }
    .nm-patch  { background:rgba(139,92,246,.14); color:#8b5cf6; }
    .nm-delete { background:rgba(239,68,68,.14);  color:#ef4444; }
    .nm-other  { background:rgba(100,116,139,.14); color:#64748b; }

    /* ── Availability badge ── */
    .avail-badge { display:inline-flex; align-items:center; gap:5px; padding:4px 10px;
                   border-radius:8px; font-size:11px; font-weight:700; }
    .avail-ok  { background:rgba(16,185,129,.13); color:#10b981; }
    .avail-no  { background:rgba(239,68,68,.13); color:#ef4444; }
    .avail-unk { background:rgba(100,116,139,.13); color:#64748b; }
</style>

<div class="dh">

    <!-- ── Top bar ─────────────────────────────────────────────────────── -->
    <div class="dh-topbar">
        <div class="dh-logo">
            <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Surface" Size="Size.Small" />
        </div>
        <div>
            <div class="dh-title">DevHub</div>
            <div class="dh-subtitle">@Hub.Projects.Count project@(Hub.Projects.Count==1?"":"s") in fleet</div>
        </div>

        <div class="d-flex gap-2 align-center ml-2">
            @{ var running = Hub.Projects.Count(p => p.RunState?.State is "running" or "healthy"); }
            @if (Hub.Projects.Count == 0)
            {
                <span class="dh-health-chip dh-offline">No fleet</span>
            }
            else if (running == Hub.Projects.Count)
            {
                <span class="dh-health-chip dh-healthy">● @running/@Hub.Projects.Count Running</span>
            }
            else if (running > 0)
            {
                <span class="dh-health-chip dh-partial">◐ @running/@Hub.Projects.Count Partial</span>
            }
            else
            {
                <span class="dh-health-chip dh-offline">○ Fleet Idle</span>
            }
        </div>

        <div class="ml-auto d-flex gap-2 align-center">
            <MudText Typo="Typo.caption" Class="text-muted">Auto-refresh 2s</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                           OnClick="ManualRefresh" Title="Force refresh" />
        </div>
    </div>

    <!-- ── Body: sidebar + content ─────────────────────────────────────── -->
    <div class="dh-body">

        <!-- Sidebar navigation -->
        <div class="dh-sidebar">
            @foreach (var t in _tabs)
            {
                <button class="dh-nav-btn @(_tab == t.Id ? "active" : "")"
                        @onclick="() => _tab = t.Id"
                        title="@t.Label">
                    <MudIcon Icon="@t.Icon" Style="font-size:20px;" />
                    @t.Short
                </button>
            }
            <div class="dh-nav-sep"></div>
            <button class="dh-nav-btn" @onclick="RefreshDevices" title="Refresh ADB devices">
                <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" Style="font-size:20px;" />
                ADB
            </button>
        </div>

        <!-- Tab content -->
        <div class="dh-content">

            <!-- ───── Tab 0: Preview Hub ───── -->
            @if (_tab == 0)
            {
                <div class="dh-sec-hdr">
                    <div>
                        <div class="dh-sec-title">Preview Hub</div>
                        <MudText Typo="Typo.caption" Class="text-muted">
                            All projects — click to open a native preview window
                        </MudText>
                    </div>
                </div>

                @if (Hub.Projects.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        No projects in the fleet. Add projects in the Universe Connector.
                    </MudAlert>
                }
                else
                {
                    <div class="dh-proj-grid">
                        @foreach (var node in Hub.Projects)
                        {
                            var color = DomainDetector.GetColor(node.Domain);
                            var rs    = node.RunState;
                            var alive = rs?.State is "running" or "healthy";

                            <div class="dh-proj-card" style="--pc:@color;">
                                <div class="dh-domain-badge">
                                    <MudIcon Icon="@GetDomainIcon(node.Domain)" Style="font-size:11px;" />
                                    @node.Domain
                                </div>
                                <div class="dh-card-name" title="@node.Path">@node.Label</div>
                                <div class="dh-card-stack">@node.Stack</div>
                                <div class="dh-card-status">
                                    <span class="sd @GetSdClass(rs)"></span>
                                    <span>@GetStateLabel(rs)</span>
                                    @if (node.Port > 0)
                                    {
                                        <span class="dh-card-port ml-auto">:@node.Port</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(node.GitBranch))
                                {
                                    <div style="font-size:11px;color:var(--mud-palette-text-secondary);margin-bottom:10px;">
                                        <MudIcon Icon="@Icons.Material.Filled.Source" Style="font-size:12px;" />
                                        @node.GitBranch
                                        @if (node.IsGitDirty) { <span style="color:#f59e0b;font-weight:700;margin-left:4px;">dirty</span> }
                                    </div>
                                }

                                <div class="dh-card-actions">
                                    @if (node.Domain is DomainKind.Frontend or DomainKind.Mobile && node.Port > 0)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.OpenInNew" Disabled="!alive"
                                                   OnClick="() => PreviewWindowHelper.OpenPreview(node.Label, node.Port)">
                                            Preview
                                        </MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                                   StartIcon="@Icons.Material.Filled.Language"
                                                   OnClick="() => _ = OpenBrowserAsync(node.Port)">
                                            Browser
                                        </MudButton>
                                    }
                                    @if (node.Domain is DomainKind.Backend or DomainKind.AIService && node.Port > 0)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                                   StartIcon="@Icons.Material.Filled.Api" Disabled="!alive"
                                                   OnClick="() => PreviewWindowHelper.OpenSwagger(node.Label, node.Port)">
                                            Swagger
                                        </MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                                   StartIcon="@Icons.Material.Filled.Science"
                                                   OnClick="() => QuickFillApiTester(node)">
                                            API Tester
                                        </MudButton>
                                    }
                                    @if (node.Domain is DomainKind.Database)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Color="Color.Warning">
                                            DB · no preview
                                        </MudChip>
                                    }
                                </div>

                                <!-- Live process output snippet -->
                                @if (_logs.TryGetValue(node.Id, out var snap) && snap.Count > 0)
                                {
                                    <div style="margin-top:10px;background:#0f172a;border-radius:8px;padding:8px 10px;font-family:monospace;font-size:10px;color:#94a3b8;max-height:60px;overflow:hidden;">
                                        @foreach (var l in snap.TakeLast(3))
                                        {
                                            <div style="@GetLogStyle(l);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@l</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }

            <!-- ───── Tab 1: API Tester ───── -->
            @if (_tab == 1)
            {
                <div class="dh-sec-hdr">
                    <div>
                        <div class="dh-sec-title">API Tester</div>
                        <MudText Typo="Typo.caption" Class="text-muted">Postman-style HTTP client</MudText>
                    </div>
                </div>

                <!-- Quick URL suggestions from running backends -->
                @if (Hub.Projects.Any(p => p.Domain is DomainKind.Backend or DomainKind.AIService && p.Port > 0))
                {
                    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;">
                        <MudText Typo="Typo.caption" Class="text-muted d-flex align-center">Quick base URL:</MudText>
                        @foreach (var be in Hub.Projects.Where(p => p.Domain is DomainKind.Backend or DomainKind.AIService && p.Port > 0))
                        {
                            var bePort = be.Port;
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                     OnClick="() => SetQuickBaseUrl(bePort)">
                                @be.Label :@be.Port
                            </MudChip>
                        }
                    </div>
                }

                <!-- Request bar -->
                <div class="api-request-bar">
                    <select class="api-method-select" @bind="_apiMethod"
                            style="color:@GetMethodColor(_apiMethod);">
                        @foreach (var m in new[]{"GET","POST","PUT","PATCH","DELETE","HEAD","OPTIONS"})
                        {
                            <option value="@m">@m</option>
                        }
                    </select>
                    <input class="api-url-input" type="text" placeholder="http://localhost:3001/api/..."
                           @bind="_apiUrl" @bind:event="oninput" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@(_apiSending ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Send)"
                               Disabled="_apiSending || string.IsNullOrWhiteSpace(_apiUrl)"
                               OnClick="SendRequestAsync">
                        @(_apiSending ? "Sending…" : "Send")
                    </MudButton>
                </div>

                <!-- Request tabs -->
                <div class="api-tabs">
                    @for (var ti = 0; ti < _apiTabNames.Length; ti++)
                    {
                        var ti2 = ti;
                        var lbl = _apiTabNames[ti];
                        <div class="api-tab @(_apiSubTab == ti2 ? "active" : string.Empty)"
                             @onclick="() => _apiSubTab = ti2">
                            @lbl
                            @if (ti2 == 0 && _apiHeaders.Count > 0)
                            { <MudBadge Content="@_apiHeaders.Count" Color="Color.Primary" Class="ml-1" /> }
                        </div>
                    }
                </div>

                @if (_apiSubTab == 0)
                {
                    <!-- Headers -->
                    @for (var hi = 0; hi < _apiHeaders.Count; hi++)
                    {
                        var idx2 = hi;
                        <div class="api-header-row">
                            <input class="api-hdr-input" placeholder="Header name"
                                   value="@_apiHeaders[idx2].Key"
                                   @onchange="e => UpdateHeaderKey(idx2, e.Value?.ToString() ?? string.Empty)" />
                            <input class="api-hdr-input" placeholder="Value"
                                   value="@_apiHeaders[idx2].Value"
                                   @onchange="e => UpdateHeaderValue(idx2, e.Value?.ToString() ?? string.Empty)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           OnClick="() => RemoveHeader(idx2)" />
                        </div>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddHeader"
                               Style="margin-top:6px;">
                        Add Header
                    </MudButton>
                }
                @if (_apiSubTab == 1)
                {
                    <!-- Body -->
                    <textarea class="api-body-editor" placeholder='{"key": "value"}'
                              @bind="_apiBody" @bind:event="oninput" rows="6" />
                    <div style="display:flex;gap:6px;margin-top:6px;">
                        @foreach (var preset in new[]{ "{}", "{\"id\":1}", "[{\"id\":1}]" })
                        {
                            var p2 = preset;
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     OnClick="() => _apiBody = p2">@p2</MudChip>
                        }
                    </div>
                }
                @if (_apiSubTab == 2)
                {
                    <!-- Auth -->
                    <div style="display:flex;flex-direction:column;gap:10px;max-width:500px;">
                        <MudSelect T="string" @bind-Value="_authType" Label="Auth Type"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
