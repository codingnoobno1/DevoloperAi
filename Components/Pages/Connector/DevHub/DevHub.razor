                        </div>
                    </div>
                </div>
            }

            <!-- ───── Tab 4: Network Monitor ───── -->
            @if (_tab == 4)
            {
                <div class="dh-sec-hdr">
                    <div>
                        <div class="dh-sec-title">Network Monitor</div>
                        <MudText Typo="Typo.caption" Class="text-muted">HTTP activity extracted from running process logs</MudText>
                    </div>
                    <div class="d-flex gap-2 align-center">
                        <MudSelect T="string" @bind-Value="_netFilter" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Style="min-width:160px;">
                            <MudSelectItem Value="@("all")">All projects</MudSelectItem>
                            @foreach (var p in Hub.Projects)
                            {
                                <MudSelectItem Value="@p.Id.ToString()">@p.Label</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.ClearAll"
                                   OnClick="() => _netEntries.Clear()">
                            Clear
                        </MudButton>
                    </div>
                </div>

                @if (FilteredEntries.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        No HTTP activity detected yet. Start a backend service to see network requests here.
                    </MudAlert>
                }
                else
                {
                    <table class="net-log-table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Project</th>
                                <th>Method</th>
                                <th>Path / URL</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in FilteredEntries.TakeLast(200).Reverse())
                            {
                                <tr>
                                    <td style="font-family:monospace;font-size:11px;color:var(--mud-palette-text-secondary);">@e.Time</td>
                                    <td style="font-size:12px;">@e.Project</td>
                                    <td><span class="net-method @GetNetMethodClass(e.Method)">@e.Method</span></td>
                                    <td style="font-family:monospace;font-size:11px;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@e.Path">@e.Path</td>
                                    <td style="font-family:monospace;font-size:12px;font-weight:700;color:@GetNetStatusColor(e.Status);">
                                        @(e.Status > 0 ? e.Status.ToString() : "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }

        </div>
    </div>
</div>

@code {
    // ── Tab navigation ────────────────────────────────────────────────────────
    private int _tab = 0;

    private readonly string[] _apiTabNames = { "Headers", "Body", "Auth" };

    private record TabDef(int Id, string Label, string Short, string Icon);
    private readonly TabDef[] _tabs = {
        new(0, "Preview Hub",    "HUB",  Icons.Material.Filled.GridView),
        new(1, "API Tester",     "API",  Icons.Material.Filled.Science),
        new(2, "Swagger",        "SWG",  Icons.Material.Filled.Api),
        new(3, "Device",         "DEV",  Icons.Material.Filled.PhoneAndroid),
        new(4, "Network",        "NET",  Icons.Material.Filled.NetworkCheck),
    };

    // ── Process logs per project ──────────────────────────────────────────────
    private readonly Dictionary<Guid, List<string>> _logs = new();

    // ── API Tester state ─────────────────────────────────────────────────────
    private string _apiMethod   = "GET";
    private string _apiUrl      = "";
    private string _apiBody     = "";
    private int    _apiSubTab   = 0;
    private bool   _apiSending;
    private int    _apiResponseStatus;
    private long   _apiElapsedMs;
    private string _apiResponseBody = "";
    private string _apiContentType  = "";

    private readonly List<ApiHeader> _apiHeaders = new();
    private sealed class ApiHeader { public string Key = ""; public string Value = ""; }

    // Auth fields
    private string _authType     = "None";
    private string _authToken    = "";
    private string _authUser     = "";
    private string _authPass     = "";
    private string _apiKeyHeader = "X-API-Key";
    private string _apiKeyValue  = "";

    // ── ADB / Device ─────────────────────────────────────────────────────────
    private bool _adbAvail;
    private bool _scrcpyAvail;
    private bool _flutterAvail;
    private bool _loadingDevices;
    private List<AdbDevice> _adbDevices = new();
    private List<string>    _flutterDevices = new();
    private AdbDevice?      _selectedDevice;

    // ── Network Monitor ───────────────────────────────────────────────────────
    private string _netFilter = "all";
    private readonly List<NetEntry> _netEntries = new();
    private sealed class NetEntry
    {
        public string Time = "";
        public string Project = "";
        public string ProjectId = "";
        public string Method = "";
        public string Path = "";
        public int    Status;
    }

    // ── Timer ─────────────────────────────────────────────────────────────────
    private System.Threading.Timer? _timer;

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            RefreshLogs();
            InvokeAsync(StateHasChanged);
        }, null, 500, 2000);

        Hub.Changed += OnHubChanged;
        await RefreshDevicesAsync();
    }

    public void Dispose()
    {
        _timer?.Dispose();
        Hub.Changed -= OnHubChanged;
    }

    private void OnHubChanged() => InvokeAsync(StateHasChanged);

    private void ManualRefresh()
    {
        RefreshLogs();
        StateHasChanged();
    }

    // ── Log refresh ───────────────────────────────────────────────────────────

    private void RefreshLogs()
    {
        var procs = RunManager.Running();
        foreach (var node in Hub.Projects)
        {
            node.RunState = RunManager.Snapshot().FirstOrDefault(s =>
                s.WorkspaceId == node.Path || s.Label == node.Label);

            var proc = procs.FirstOrDefault(p =>
                p.Spec.WorkspaceId == node.Path || p.Spec.Label == node.Label);

            if (proc != null)
            {
                var lines = proc.RecentOutput().ToList();
                _logs[node.Id] = lines;
                ExtractNetworkEntries(node, lines);
            }
        }
    }

    private void ExtractNetworkEntries(ConnectorWorkspaceNode node, List<string> lines)
    {
        var httpMethods = new[] { " GET ", " POST ", " PUT ", " PATCH ", " DELETE " };
        foreach (var line in lines)
        {
            var up = line.ToUpperInvariant();
            var method = httpMethods.FirstOrDefault(m => up.Contains(m));
            if (method == null) continue;

            method = method.Trim();
            var path = ExtractPath(line);
            if (string.IsNullOrEmpty(path)) continue;

            var key = $"{node.Id}|{path}|{method}";
            if (_netEntries.Any(e => e.ProjectId == node.Id.ToString() && e.Path == path && e.Method == method &&
                                     (DateTime.TryParse(e.Time, out var t) && (DateTime.Now - t).TotalSeconds < 2)))
                continue;

            _netEntries.Add(new NetEntry
            {
                Time      = DateTime.Now.ToString("HH:mm:ss"),
                Project   = node.Label,
                ProjectId = node.Id.ToString(),
                Method    = method,
                Path      = path,
                Status    = ExtractStatus(line)
            });

            if (_netEntries.Count > 1000) _netEntries.RemoveAt(0);
        }
    }

    private static string ExtractPath(string line)
    {
        var patterns = new[] { "GET /", "POST /", "PUT /", "PATCH /", "DELETE /",
                                "GET http", "POST http" };
        foreach (var p in patterns)
        {
            var idx = line.IndexOf(p, StringComparison.OrdinalIgnoreCase);
            if (idx < 0) continue;
            var start = idx + p.LastIndexOf(' ') + 1;
            var rest  = line[start..].Split(new[]{' ','\t','"','\'','<'}, 2)[0];
            return rest.Length > 0 ? rest : "";
        }
        return "";
    }

    private static int ExtractStatus(string line)
    {
        foreach (var word in line.Split(' '))
        {
            if (word.Length == 3 && int.TryParse(word, out var s) && s is >= 100 and <= 599)
                return s;
        }
        return 0;
    }

    // ── API Tester ────────────────────────────────────────────────────────────

    private void AddHeader()     => _apiHeaders.Add(new ApiHeader());
    private void RemoveHeader(int i)  { if (i < _apiHeaders.Count) _apiHeaders.RemoveAt(i); }
    private void UpdateHeaderKey(int i, string k)   { if (i < _apiHeaders.Count) _apiHeaders[i].Key   = k; }
    private void UpdateHeaderValue(int i, string v) { if (i < _apiHeaders.Count) _apiHeaders[i].Value = v; }

    private void QuickFillApiTester(ConnectorWorkspaceNode node)
    {
        _apiUrl = $"http://localhost:{node.Port}/";
        _tab = 1;
    }

    private void QuickFillFromRoute(ConnectorWorkspaceNode node, Syncro.Desktop.Services.Connector.Models.BackendRoute r)
    {
        _apiUrl    = $"http://localhost:{node.Port}{r.PathTemplate}";
        _apiMethod = r.Method.ToString().ToUpper();
        _tab = 1;
    }

    private async Task SendRequestAsync()
    {
        if (string.IsNullOrWhiteSpace(_apiUrl)) return;
        _apiSending = true;
        _apiResponseStatus = 0;
        _apiResponseBody   = "";
        _apiContentType    = "";
        StateHasChanged();

        var sw = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(30) };

            var req = new HttpRequestMessage(new HttpMethod(_apiMethod), _apiUrl);

            // Add headers
            foreach (var h in _apiHeaders.Where(h => !string.IsNullOrWhiteSpace(h.Key)))
                req.Headers.TryAddWithoutValidation(h.Key, h.Value);

            // Auth
            if (_authType == "Bearer" && !string.IsNullOrEmpty(_authToken))
                req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _authToken);
            else if (_authType == "Basic" && !string.IsNullOrEmpty(_authUser))
                req.Headers.Authorization = new AuthenticationHeaderValue("Basic",
                    Convert.ToBase64String(Encoding.UTF8.GetBytes($"{_authUser}:{_authPass}")));
            else if (_authType == "APIKey" && !string.IsNullOrEmpty(_apiKeyValue))
                req.Headers.TryAddWithoutValidation(_apiKeyHeader, _apiKeyValue);

            // Body
            if (_apiMethod is not "GET" and not "DELETE" and not "HEAD" && !string.IsNullOrWhiteSpace(_apiBody))
                req.Content = new StringContent(_apiBody, Encoding.UTF8, "application/json");

            var resp = await http.SendAsync(req);
            sw.Stop();
            _apiElapsedMs      = sw.ElapsedMilliseconds;
            _apiResponseStatus = (int)resp.StatusCode;
            _apiContentType    = resp.Content.Headers.ContentType?.MediaType ?? "";
            _apiResponseBody   = await resp.Content.ReadAsStringAsync();

            if (_apiContentType.Contains("json"))
                _apiResponseBody = PrettyJson(_apiResponseBody);
        }
        catch (Exception ex)
        {
            sw.Stop();
            _apiElapsedMs      = sw.ElapsedMilliseconds;
            _apiResponseStatus = 0;
            _apiResponseBody   = $"Error: {ex.Message}";
        }
        finally
        {
            _apiSending = false;
            StateHasChanged();
        }
    }

    private static string PrettyJson(string raw)
    {
        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(raw);
            return System.Text.Json.JsonSerializer.Serialize(parsed,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch { return raw; }
    }

    // ── Device ────────────────────────────────────────────────────────────────

    private async void RefreshDevices() => await RefreshDevicesAsync();

    private async Task RefreshDevicesAsync()
    {
        _loadingDevices = true;
        StateHasChanged();

        _adbAvail    = await Task.Run(AdbService.IsAdbAvailable);
        _scrcpyAvail = await Task.Run(AdbService.IsScrcpyAvailable);
        _flutterAvail = await Task.Run(AdbService.IsFlutterAvailable);

        if (_adbAvail)
            _adbDevices = await AdbService.GetDevicesAsync();

        if (_flutterAvail)
            _flutterDevices = await AdbService.GetFlutterDevicesAsync();

        _loadingDevices = false;
        StateHasChanged();
    }

    // ── Browser launch ────────────────────────────────────────────────────────

    private static async Task OpenBrowserAsync(int port, string path = "")
    {
        try { await Microsoft.Maui.ApplicationModel.Launcher.OpenAsync(new Uri($"http://localhost:{port}{path}")); }
        catch { }
    }

    private static void OpenSwaggerInBrowser(int port) =>
        _ = OpenBrowserAsync(port, "/swagger");

