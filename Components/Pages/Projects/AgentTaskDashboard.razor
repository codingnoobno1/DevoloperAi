    private async Task AcceptAndSetupReceiverAsync()
    {
        if (_selectedTask == null) return;
        _isSettingUp = true;
        _bannerMessage = null;
        StateHasChanged();

        try
        {
            // 1. Ensure local repository exists (or clone if missing)
            if (string.IsNullOrWhiteSpace(_receiverRepoPath) || !Directory.Exists(Path.Combine(_receiverRepoPath, ".git")))
            {
                string fallbackCloneDir = Path.Combine(
                    Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
                    "SyncroWorkspaces",
                    _selectedTask.Id);

                if (!string.IsNullOrWhiteSpace(_selectedTask.RepoUrl))
                {
                    bool cloned = await GitAutoSvc.CloneRepositoryAsync(_selectedTask.RepoUrl, fallbackCloneDir);
                    if (cloned)
                    {
                        _receiverRepoPath = fallbackCloneDir;
                    }
                }
            }

            // 2. Checkout or create the task's dedicated TargetBranch
            string branchMsg = "";
            if (Directory.Exists(Path.Combine(_receiverRepoPath, ".git")) && !string.IsNullOrWhiteSpace(_selectedTask.TargetBranch))
            {
                var (ok, msg) = await ScopeSvc.CheckoutTaskBranchAsync(_receiverRepoPath, _selectedTask.TargetBranch, _selectedTask.BaseBranch);
                branchMsg = msg;
            }

            // 3. Activate task scope guard in GitTaskScopeService
            ScopeSvc.ActivateTaskForRepo(_receiverRepoPath, _selectedTask);

            // 4. Mark task as in-progress on Pixel Platform
            if (_selectedTask.Status == "pending")
            {
                _selectedTask.Status = "in-progress";
                if (_selectedTask.Progress < 15) _selectedTask.Progress = 15;
                await PixelSvc.UpdateGitTaskAsync(_selectedTask.Id, new UpdateGitTaskRequest
                {
                    Status = _selectedTask.Status,
                    Progress = _selectedTask.Progress
                });
            }

            await RefreshReceiverGitStatusAsync();
            await GenerateScopedMethodologyAsync();

            _bannerIsError = false;
            _bannerMessage = $"Task '{_selectedTask.Title}' accepted! Active scope guard enabled for {_selectedTask.AssignedFiles.Count} file(s). {branchMsg}";
        }
        catch (Exception ex)
        {
            _bannerIsError = true;
            _bannerMessage = $"Setup failed: {ex.Message}";
        }
        finally
        {
            _isSettingUp = false;
            StateHasChanged();
        }
    }

