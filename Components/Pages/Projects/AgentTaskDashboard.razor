        align-items: center;
        min-width: 90px;
    }

    .gtd-kpi-num {
        font-size: 18px;
        font-weight: 800;
        line-height: 1.1;
    }

    .gtd-kpi-lbl {
        font-size: 10px;
        font-weight: 700;
        color: #64748B;
        text-transform: uppercase;
    }

    .gtd-mode-tabs {
        display: flex;
        gap: 8px;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid #F1F5F9;
    }

    .gtd-mode-tab {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px;
        border-radius: 9px;
        border: 1px solid #E2E8F0;
        background: #F8FAFC;
        color: #475569;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .gtd-mode-tab.active {
        background: #EFF6FF;
        border-color: #0066FF;
        color: #0066FF;
    }

    .gtd-tab-badge {
        background: #FFFFFF;
        border: 1px solid #CBD5E1;
        border-radius: 99px;
        padding: 1px 8px;
        font-size: 11px;
        font-weight: 800;
    }

    .gtd-alert {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
    }

    .gtd-alert-success {
        background: #ECFDF5;
        border: 1px solid #A7F3D0;
        color: #065F46;
    }

    .gtd-alert-error {
        background: #FEF2F2;
        border: 1px solid #FECACA;
        color: #991B1B;
    }

    .gtd-alert-close {
        background: transparent;
        border: none;
        font-weight: 800;
        cursor: pointer;
        color: inherit;
    }

    /* Grids */
    .gtd-receiver-grid {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 16px;
        align-items: start;
    }

    .gtd-receiver-detail {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .gtd-three-col-scope {
        display: grid;
        grid-template-columns: 1.15fr 1fr 1fr;
        gap: 14px;
        align-items: start;
    }

    .gtd-dispatcher-grid {
        display: grid;
        grid-template-columns: 390px 1fr;
        gap: 16px;
        align-items: start;
    }

    .gtd-dispatcher-right {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    /* Card Headers */
    .gtd-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 1px solid #F1F5F9;
    }

    .gtd-card-title {
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.05em;
        color: #0F172A;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .gtd-card-sub {
        font-size: 11px;
        color: #64748B;
        margin-top: 2px;
    }

    /* Filter Pills */
    .gtd-filter-pills {
        display: flex;
        gap: 4px;
    }

    .gtd-filter-pill {
        border: 1px solid #E2E8F0;
        background: #F8FAFC;
        color: #64748B;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        cursor: pointer;
    }

    .gtd-filter-pill.active {
        background: #0066FF;
        border-color: #0066FF;
        color: #FFFFFF;
    }

    /* Task List Items */
    .gtd-task-scroll {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: 680px;
        overflow-y: auto;
    }

    .gtd-task-item {
        border: 1px solid #E2E8F0;
        background: #F8FAFC;
        border-radius: 10px;
        padding: 12px;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .gtd-task-item:hover {
        border-color: #93C5FD;
        background: #FFFFFF;
    }

    .gtd-task-item.selected {
        border: 2px solid #0066FF;
        background: #EFF6FF;
    }

    .gtd-task-item-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
    }

    .gtd-task-item-title {
        font-size: 14px;
        font-weight: 700;
        color: #0F172A;
        line-height: 1.3;
    }

    .gtd-task-item-proj {
        font-size: 11px;
        color: #64748B;
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .gtd-task-item-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 8px;
    }

    .gtd-branch-chip, .gtd-files-chip, .gtd-lock-chip {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .gtd-branch-chip {
        background: #EEF2FF;
        color: #4338CA;
        border: 1px solid #C7D2FE;
        font-family: 'JetBrains Mono', Consolas, monospace;
    }

    .gtd-files-chip {
        background: #F0FDF4;
        color: #15803D;
        border: 1px solid #BBF7D0;
    }

    .gtd-lock-chip.strict {
        background: #FEF2F2;
        color: #B91C1C;
        border: 1px solid #FECACA;
    }

    .gtd-lock-chip.advisory {
        background: #FFFBEB;
        color: #B45309;
        border: 1px solid #FDE68A;
    }

    .gtd-progress-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
    }

    .gtd-progress-track {
        flex: 1;
        height: 6px;
        background: #E2E8F0;
        border-radius: 99px;
        overflow: hidden;
    }

    .gtd-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #0066FF, #10B981);
        border-radius: 99px;
    }

    .gtd-progress-pct {
        font-size: 11px;
        font-weight: 800;
        color: #334155;
    }

    .gtd-task-item-foot {
        display: flex;
        justify-content: space-between;
        font-size: 10px;
        color: #64748B;
        margin-top: 6px;
    }

    .gtd-active-scope-tag {
        margin-top: 8px;
        padding: 4px 8px;
        border-radius: 6px;
        background: #ECFDF5;
        color: #047857;
        font-size: 10px;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    /* Priority & Status Pills */
    .gtd-prio-pill, .gtd-status-pill {
        font-size: 10px;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 6px;
        text-transform: uppercase;
    }

    .prio-high { background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; }
    .prio-med  { background: #FFFBEB; color: #D97706; border: 1px solid #FDE68A; }
    .prio-low  { background: #F1F5F9; color: #475569; border: 1px solid #CBD5E1; }

    .st-done    { background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; }
    .st-active  { background: #EFF6FF; color: #2563EB; border: 1px solid #BFDBFE; }
    .st-delayed { background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; }
    .st-pending { background: #F8FAFC; color: #475569; border: 1px solid #E2E8F0; }

    /* Receiver Detail Header */
    .gtd-detail-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-wrap: wrap;
        padding-bottom: 14px;
        border-bottom: 1px solid #F1F5F9;
    }

    .gtd-detail-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 8px;
    }

    .gtd-detail-title {
        font-size: 18px;
        font-weight: 800;
        margin: 0;
        color: #0F172A;
    }

    .gtd-detail-desc {
        font-size: 13px;
        color: #475569;
        margin: 6px 0 0;
        max-width: 760px;
    }

    .gtd-detail-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .gtd-repo-bind-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        padding: 10px 12px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 9px;
        margin-top: 12px;
    }

    .gtd-repo-bind-left {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        flex-wrap: wrap;
    }

    .gtd-git-ready-pill {
        font-size: 12px;
        color: #047857;
        background: #ECFDF5;
        border: 1px solid #A7F3D0;
        padding: 4px 10px;
        border-radius: 7px;
    }

    .gtd-git-warn-pill {
        font-size: 12px;
        color: #B45309;
        background: #FFFBEB;
        border: 1px solid #FDE68A;
        padding: 4px 10px;
        border-radius: 7px;
    }

    .gtd-telemetry-strip {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 16px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #F1F5F9;
    }

    .gtd-status-progress-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 4px;
    }

    .gtd-range {
        flex: 1;
        accent-color: #0066FF;
    }

    .gtd-pct-badge {
        font-size: 12px;
        font-weight: 800;
        color: #0066FF;
        min-width: 38px;
    }

    .gtd-gate-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 4px;
    }

    .gtd-gate-pill {
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 7px;
        border: 1px solid #E2E8F0;
        background: #F8FAFC;
        color: #64748B;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .gtd-gate-pill.pass {
        background: #ECFDF5;
        border-color: #A7F3D0;
        color: #047857;
    }

    .gtd-local-note {
        font-size: 12px;
        color: #92400E;
        background: #FFFBEB;
        border: 1px solid #FDE68A;
        border-radius: 8px;
        padding: 6px 10px;
        margin: 8px 0;
    }

    .gtd-gate-pill.fail {
        background: #FEF2F2;
        border-color: #FECACA;
        color: #B91C1C;
    }

    .gtd-sha-pill {
        font-size: 11px;
        font-weight: 800;
        font-family: 'JetBrains Mono', Consolas, monospace;
        padding: 4px 10px;
        border-radius: 7px;
        background: #EEF2FF;
        border: 1px solid #C7D2FE;
        color: #4338CA;
    }

    /* Scope File Rows */
    .gtd-file-scope-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
        max-height: 360px;
        overflow-y: auto;
    }

    .gtd-scope-file-row {
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 8px 10px;
        background: #F8FAFC;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .gtd-scope-file-row.in-scope {
        border-left: 3px solid #10B981;
    }

    .gtd-scope-file-row.locked-scope {
        border-left: 3px solid #EF4444;
        background: #FEF2F2;
    }

    .gtd-scope-file-main {
        display: flex;
        align-items: center;
        gap: 6px;
        overflow: hidden;
    }

    .gtd-scope-badge {
        font-size: 9px;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 4px;
        white-space: nowrap;
    }

    .scope-in     { background: #D1FAE5; color: #065F46; }
    .scope-glob   { background: #DBEAFE; color: #1E40AF; }
    .scope-ro     { background: #E2E8F0; color: #334155; }
    .scope-locked { background: #FEE2E2; color: #991B1B; }

    .gtd-file-code {
        font-size: 11.5px;
        font-family: 'JetBrains Mono', Consolas, monospace;
        color: #0F172A;
        word-break: break-all;
    }

    .gtd-scope-file-right {
        display: flex;
        justify-content: flex-end;
    }

    .gtd-git-state-tag {
        font-size: 10px;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 4px;
    }

    .state-mod   { background: #FEF3C7; color: #B45309; }
    .state-add   { background: #D1FAE5; color: #047857; }
    .state-del   { background: #FEE2E2; color: #B91C1C; }
    .state-clean { background: #F1F5F9; color: #64748B; }

    .gtd-lock-task-caption {
        font-size: 10.5px;
        color: #7F1D1D;
    }

    .gtd-methodology-box {
        background: #0F172A;
        color: #F8FAFC;
        border-radius: 9px;
        padding: 12px;
        max-height: 350px;
        overflow-y: auto;
    }

    .gtd-methodology-pre {
        margin: 0;
        white-space: pre-wrap;
        font-family: 'JetBrains Mono', Consolas, monospace;
        font-size: 11.5px;
        line-height: 1.5;
    }

    /* Dispatcher Mode Styles */
    .gtd-project-bar {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .gtd-project-bar-left {
        display: flex;
        align-items: flex-end;
        gap: 14px;
        flex: 1;
        flex-wrap: wrap;
    }

    .gtd-project-bar-right {
        display: flex;
        gap: 8px;
    }

    .gtd-field-lbl {
        display: block;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.06em;
        color: #64748B;
        margin-bottom: 4px;
        text-transform: uppercase;
    }

    .gtd-sub-section-lbl {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.06em;
        color: #475569;
        margin: 8px 0 4px;
        text-transform: uppercase;
    }

    .gtd-input, .gtd-select, .gtd-textarea {
        width: 100%;
        border: 1px solid #CBD5E1;
        background: #FFFFFF;
        color: #0F172A;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 12.5px;
        outline: none;
    }

    .gtd-input:focus, .gtd-select:focus, .gtd-textarea:focus {
        border-color: #0066FF;
        box-shadow: 0 0 0 2px rgba(0, 102, 255, 0.12);
    }

    .gtd-form-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .gtd-form-grid-3 {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr;
        gap: 10px;
    }

    /* Team Roster Cards */
    .gtd-add-member-box {
        background: #F8FAFC;
        border: 1px solid #BFDBFE;
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 12px;
    }

    .gtd-member-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .gtd-member-card {
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 12px;
        background: #F8FAFC;
        transition: all 0.15s ease;
    }

    .gtd-member-card.picked {
        border: 2px solid #0066FF;
        background: #EFF6FF;
    }

    .gtd-member-top {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .gtd-avatar {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        background: linear-gradient(135deg, #0066FF, #7C3AED);
        color: #FFFFFF;
        font-weight: 800;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .gtd-member-info {
        flex: 1;
        min-width: 0;
    }

    .gtd-member-name-row {
        display: flex;
        align-items: center;
        gap: 5px;
        flex-wrap: wrap;
    }

    .gtd-member-name {
        font-size: 13.5px;
        font-weight: 800;
        color: #0F172A;
    }

    .gtd-member-email {
        font-size: 11px;
        color: #64748B;
    }

    .gtd-role-badge {
        font-size: 9px;
        font-weight: 800;
        padding: 1px 6px;
        border-radius: 4px;
        background: #E2E8F0;
        color: #334155;
    }

    .gtd-role-badge.lead {
        background: #DBEAFE;
        color: #1D4ED8;
    }

    .gtd-member-actions {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .gtd-owned-globs-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 8px;
    }

    .gtd-owned-lbl {
        font-size: 10px;
        font-weight: 700;
        color: #64748B;
    }

    .gtd-glob-pill {
        font-size: 10.5px;
        padding: 2px 6px;
        border-radius: 5px;
        background: #FFFFFF;
        border: 1px solid #CBD5E1;
        color: #0F172A;
        cursor: pointer;
    }

    .gtd-member-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
        margin-top: 10px;
        padding-top: 8px;
        border-top: 1px solid #E2E8F0;
        text-align: center;
    }

    .gtd-mstat b {
        display: block;
        font-size: 13px;
        color: #0F172A;
    }

    .gtd-mstat span {
        font-size: 10px;
        color: #64748B;
    }

    /* Interactive File Picker */
    .gtd-file-picker-section {
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 12px;
        background: #F8FAFC;
    }

    .gtd-picker-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
    }

    .gtd-picker-tabs {
        display: flex;
        gap: 6px;
    }

    .gtd-picker-tab {
        border: 1px solid #CBD5E1;
        background: #FFFFFF;
        color: #475569;
        padding: 6px 12px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .gtd-picker-tab.active {
        background: #0066FF;
        border-color: #0066FF;
        color: #FFFFFF;
    }

    .gtd-picker-search {
        flex: 1;
        min-width: 220px;
        display: flex;
        align-items: center;
        gap: 6px;
        background: #FFFFFF;
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        padding: 5px 10px;
    }

    .gtd-search-input {
        border: none;
        outline: none;
        width: 100%;
        font-size: 12px;
    }

    .gtd-Manual-add {
        display: flex;
        gap: 6px;
    }

    .gtd-dir-glob-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 10px;
    }

    .gtd-dir-chip {
        border: 1px solid #CBD5E1;
        background: #FFFFFF;
        color: #334155;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 6px;
        cursor: pointer;
    }

    .gtd-dir-chip.active {
        background: #DBEAFE;
        border-color: #2563EB;
        color: #1D4ED8;
    }

    .gtd-picker-list {
        margin-top: 10px;
        max-height: 240px;
        overflow-y: auto;
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        divide-y: 1px solid #F1F5F9;
    }

    .gtd-picker-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 10px;
        border-bottom: 1px solid #F1F5F9;
        cursor: pointer;
        font-size: 12px;
    }

    .gtd-picker-row:hover {
        background: #F8FAFC;
    }

    .gtd-picker-row.checked {
        background: #EFF6FF;
    }

    .gtd-picker-row.locked-warning {
        background: #FFFBEB;
    }

    .gtd-picker-path {
        flex: 1;
        font-family: 'JetBrains Mono', Consolas, monospace;
        font-size: 11.5px;
        color: #0F172A;
    }

    .gtd-picker-row-right {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .gtd-lock-pill {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 5px;
    }

    .gtd-lock-pill.conflict {
        background: #FEE2E2;
        color: #991B1B;
        border: 1px solid #FECACA;
    }

    .gtd-lock-pill.same-owner {
        background: #E0E7FF;
        color: #3730A3;
    }

    .gtd-mod-pill {
        font-size: 9.5px;
        font-weight: 800;
        padding: 1px 6px;
        border-radius: 4px;
        background: #FEF3C7;
        color: #B45309;
    }

    .gtd-selected-summary {
        margin-top: 10px;
    }

    .gtd-chip-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
