    private async Task OnProjectChangedAsync(ChangeEventArgs e)
    {
        _selectedProjectId = e.Value?.ToString() ?? "";
        if (!string.IsNullOrEmpty(_selectedProjectId))
        {
            var proj = _projects.FirstOrDefault(p => p.Id == _selectedProjectId);
            if (proj != null && !string.IsNullOrWhiteSpace(proj.LocalRepoPath) && Directory.Exists(proj.LocalRepoPath))
            {
                _dispatchRepoPath = proj.LocalRepoPath;
            }
            await LoadProjectDispatchDataAsync(_selectedProjectId);
            await LoadRepoTreeForDispatcherAsync();
        }
    }

    private async Task OnDispatchWorkspacePickedAsync(ChangeEventArgs e)
    {
        var path = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(path))
        {
            _dispatchRepoPath = path;
            await LoadRepoTreeForDispatcherAsync();
        }
    }

    private async Task LoadProjectDispatchDataAsync(string projectId)
    {
        _teamRoster = await PixelSvc.GetProjectTeamAsync(projectId);
        var tasksAndLocks = await PixelSvc.GetProjectTasksAndLocksAsync(projectId);
        _projectTasks = tasksAndLocks.Tasks;
        _projectFileLocks = tasksAndLocks.FileLocks;

        if (string.IsNullOrEmpty(_draftAssigneeId) && _teamRoster.Members.Count > 0)
        {
            var firstMember = _teamRoster.Members.FirstOrDefault(m => !m.IsLead) ?? _teamRoster.Members[0];
            _draftAssigneeId = firstMember.UserId;
            _draftAssigneeName = firstMember.Name;
        }
    }

    private async Task LoadRepoTreeForDispatcherAsync()
    {
        if (string.IsNullOrWhiteSpace(_dispatchRepoPath) || !Directory.Exists(_dispatchRepoPath))
            return;

        _isSyncingTree = true;
        StateHasChanged();

        try
        {
            _repoTrackedFiles = await ScopeSvc.GetTrackedRepoFilesAsync(_dispatchRepoPath);
            var status = await Git.StatusAsync(_dispatchRepoPath);
            if (status.IsRepo)
            {
                _draftBaseBranch = string.IsNullOrWhiteSpace(status.Branch) ? "main" : status.Branch;
                _repoModifiedFiles = status.Files
                    .Select(f => GitTaskScopeService.NormalizeRelativePath(f.Path))
                    .Where(f => !string.IsNullOrEmpty(f))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
                _repoModifiedSet = new HashSet<string>(_repoModifiedFiles, StringComparer.OrdinalIgnoreCase);

                if (_repoModifiedFiles.Count == 0)
                {
                    _pickerSource = "all";
                }
            }
        }
        finally
        {
            _isSyncingTree = false;
            StateHasChanged();
        }
    }

    private async Task SyncRepoTreeToPlatformAsync()
    {
        if (string.IsNullOrEmpty(_selectedProjectId)) return;
        await LoadRepoTreeForDispatcherAsync();

        _isSyncingTree = true;
        StateHasChanged();

        try
        {
            var branches = await Git.BranchesAsync(_dispatchRepoPath);
            var branchNames = branches.Where(b => !b.IsRemote).Select(b => b.Name).ToList();
            if (branchNames.Count == 0) branchNames.Add("main");

            var proj = _projects.FirstOrDefault(p => p.Id == _selectedProjectId);
            var treeSynced = await PixelSvc.SyncRepoFileTreeAsync(
                _selectedProjectId,
                proj?.GithubRepo ?? "",
                _dispatchRepoPath,
                _draftBaseBranch,
                branchNames,
                _repoTrackedFiles);

            _bannerIsError = !treeSynced;
            _bannerMessage = treeSynced
                ? $"Synced {_repoTrackedFiles.Count} tracked files and {branchNames.Count} branch(es) from '{_dispatchRepoPath}' to the platform."
                : $"Loaded {_repoTrackedFiles.Count} tracked files and {branchNames.Count} branch(es) from '{_dispatchRepoPath}' on this computer. Not sent to the platform — it has no file-tree API yet.";
        }
        finally
        {
            _isSyncingTree = false;
            StateHasChanged();
        }
    }

    private async Task SaveTeamMemberAsync()
    {
        if (string.IsNullOrWhiteSpace(_newMemberName) || string.IsNullOrWhiteSpace(_newMemberEmail))
        {
            _bannerIsError = true;
            _bannerMessage = "Member name and email are required.";
            return;
        }

        var globs = _newMemberOwnedGlobs
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(g => g.Replace('\\', '/').Trim())
            .Where(g => !string.IsNullOrEmpty(g))
            .ToList();

        var skills = _newMemberSkills
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Where(s => !string.IsNullOrEmpty(s))
            .ToList();

        _teamRoster = await PixelSvc.AddOrUpdateTeamMemberAsync(_selectedProjectId, new TeamMemberModel
        {
            UserId = "dev-" + _newMemberName.ToLowerInvariant().Replace(" ", "-"),
            Name = _newMemberName.Trim(),
            Email = _newMemberEmail.Trim(),
            ProjectRole = _newMemberRole,
            OwnedPaths = globs,
            Skills = skills
        });

        _newMemberName = "";
        _newMemberEmail = "";
        _newMemberOwnedGlobs = "";
        _showAddMemberForm = false;

        _bannerIsError = _teamRoster.LastChangeSyncedToPlatform != true;
        _bannerMessage = _teamRoster.LastChangeSyncedToPlatform == true
            ? "Team roster and module ownership updated on the platform."
            : "Team member saved on this computer only — the platform didn't accept it (no team API yet).";
    }

