    {
        _teamRoster = await PixelSvc.RemoveTeamMemberAsync(_selectedProjectId, userId);
    }

    private void PickMemberForTask(TeamMemberModel member)
    {
        _draftAssigneeId = member.UserId;
        _draftAssigneeName = member.Name;
        if (member.OwnedPaths.Count > 0 && _draftAllowedGlobs.Count == 0)
        {
            foreach (var g in member.OwnedPaths)
            {
                if (!_draftAllowedGlobs.Contains(g, StringComparer.OrdinalIgnoreCase))
                    _draftAllowedGlobs.Add(g);
            }
        }
    }

    private void OnDraftAssigneeSelected(ChangeEventArgs e)
    {
        _draftAssigneeId = e.Value?.ToString() ?? "";
        var m = _teamRoster?.Members.FirstOrDefault(x => x.UserId == _draftAssigneeId);
        _draftAssigneeName = m?.Name ?? _draftAssigneeId;
    }

    private void ToggleDraftFile(string relativePath)
    {
        var existing = _draftAssignedFiles.FirstOrDefault(f => string.Equals(f, relativePath, StringComparison.OrdinalIgnoreCase));
        if (existing != null)
            _draftAssignedFiles.Remove(existing);
        else
            _draftAssignedFiles.Add(relativePath);
    }

    private void ToggleDraftGlob(string glob)
    {
        var existing = _draftAllowedGlobs.FirstOrDefault(g => string.Equals(g, glob, StringComparison.OrdinalIgnoreCase));
        if (existing != null)
            _draftAllowedGlobs.Remove(existing);
        else
            _draftAllowedGlobs.Add(glob);
    }

    private void AddGlobToDraft(string glob)
    {
        if (!_draftAllowedGlobs.Contains(glob, StringComparer.OrdinalIgnoreCase))
            _draftAllowedGlobs.Add(glob);
    }

    private void AddManualPathOrGlob()
    {
        if (string.IsNullOrWhiteSpace(_manualPathOrGlob)) return;
        var clean = GitTaskScopeService.NormalizeRelativePath(_manualPathOrGlob);
        if (clean.Contains('*'))
        {
            if (!_draftAllowedGlobs.Contains(clean, StringComparer.OrdinalIgnoreCase))
                _draftAllowedGlobs.Add(clean);
        }
        else
        {
            if (!_draftAssignedFiles.Contains(clean, StringComparer.OrdinalIgnoreCase))
                _draftAssignedFiles.Add(clean);
        }
        _manualPathOrGlob = "";
    }

    private void ClearDraftFiles()
    {
        _draftAssignedFiles.Clear();
        _draftAllowedGlobs.Clear();
    }

    private GitFileLockModel? GetExistingFileLock(string filePath)
    {
        return _projectFileLocks.FirstOrDefault(lk => GitTaskScopeService.PathsMatch(lk.FilePath, filePath));
    }

    private async Task DispatchGitTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_draftTitle) || string.IsNullOrWhiteSpace(_draftAssigneeId))
        {
            _bannerIsError = true;
            _bannerMessage = "Please provide a Task Title and select a Team Member.";
            return;
        }

        if (_draftAssignedFiles.Count == 0 && _draftAllowedGlobs.Count == 0)
        {
            _bannerIsError = true;
            _bannerMessage = "Please select at least one Git file or directory glob to assign to this developer.";
            return;
        }

        _isDispatching = true;
        _bannerMessage = null;
        StateHasChanged();

        try
        {
            var proj = _projects.FirstOrDefault(p => p.Id == _selectedProjectId);
            var res = await PixelSvc.CreateGitTaskAsync(new CreateGitTaskRequest
            {
                ProjectId = _selectedProjectId,
                Title = _draftTitle,
                Description = string.IsNullOrWhiteSpace(_draftDescription)
                    ? $"Scoped implementation on {string.Join(", ", _draftAssignedFiles.Take(4))}."
                    : _draftDescription,
                AssignedTo = _draftAssigneeId,
                AssignedToName = _draftAssigneeName,
                Priority = _draftPriority,
                Deadline = _draftDeadline,
                RepoUrl = proj?.GithubRepo ?? "",
                BaseBranch = _draftBaseBranch,
                TargetBranch = string.IsNullOrWhiteSpace(_draftTargetBranch) ? SuggestedTargetBranch : _draftTargetBranch,
                AssignedFiles = new List<string>(_draftAssignedFiles),
                AllowedGlobs = new List<string>(_draftAllowedGlobs),
                FileLockMode = _draftLockMode,
                ForceAssign = _draftForceAssign
            });

            if (!res.Success)
            {
                _bannerIsError = true;
                _bannerMessage = res.Error ?? "Failed to dispatch task due to file lock conflict.";
                return;
            }

            _bannerIsError = false;
            _bannerMessage = $"Dispatched '{res.Task?.Title}' to {_draftAssigneeName} with {_draftAssignedFiles.Count} locked Git file(s) on branch '{res.Task?.TargetBranch}'!";

            // Reset composer
            _draftTitle = "";
            _draftDescription = "";
            _draftTargetBranch = "";
            _draftAssignedFiles.Clear();
            _draftAllowedGlobs.Clear();
            _draftForceAssign = false;

            await RefreshAllAsync();
        }
        finally
        {
            _isDispatching = false;
            StateHasChanged();
        }
    }

    private async Task OpenTaskInReceiverAsync(AgentTaskModel task)
    {
        if (!_myTasks.Any(t => t.Id == task.Id))
        {
            _myTasks.Insert(0, task);
        }
        _activeMode = "receiver";
        await SelectTaskAsync(task);
    }

