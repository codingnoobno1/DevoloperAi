@page "/agent-tasks"
@page "/agent-tasks/{TaskId}"
@using System
@using System.Collections.Generic
@using System.IO
@using System.Linq
@using System.Threading.Tasks
@using MudBlazor
@using Syncro.Desktop.Services
@using Syncro.Desktop.Services.Git
@using Syncro.Desktop.Services.Mcp
@using Syncro.Desktop.Services.Build
@using Syncro.Desktop.Services.Security
@using Syncro.Desktop.Services.Connector.Scan
@inject PixelService PixelSvc
@inject GitAutomationService GitAutoSvc
@inject IGitEngine Git
@inject GitTaskScopeService ScopeSvc
@inject LocalMcpServer McpSvc
@inject ProjectService ProjSvc
@inject IBuildEngine BuildEng
@inject Syncro.Desktop.Services.Build.ITestEngine TestEng
@inject SecurityScanner SecScanner
@inject MultiProjectScanService ContractScanner
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="gtd-shell">
    <!-- ════════════════ 1. TOP ENTERPRISE HEADER & MODE SWITCHER ════════════════ -->
    <div class="gtd-header-card">
        <div class="gtd-header-top">
            <div>
                <div class="gtd-eyebrow">S.A.N.K.A.L.P. PLATFORM · GIT TASK DISTRIBUTION &amp; TEAM CONTROL PLANE</div>
                <h1 class="gtd-title">Team Management &amp; Git File Task Distribution</h1>
                <p class="gtd-subtitle">
                    Assign developers their tasks and exact sets of Git files with collision-safe file locks—or receive your assigned Git scope, checkout your task branch, and verify before commit.
                </p>
            </div>
            <div class="gtd-kpi-strip">
                <div class="gtd-kpi-pill">
                    <span class="gtd-kpi-num text-blue">@_myTasks.Count</span>
                    <span class="gtd-kpi-lbl">My Tasks</span>
                </div>
                <div class="gtd-kpi-pill">
                    <span class="gtd-kpi-num text-purple">@(_teamRoster?.Members.Count ?? 0)</span>
                    <span class="gtd-kpi-lbl">Team Members</span>
                </div>
                <div class="gtd-kpi-pill">
                    <span class="gtd-kpi-num text-amber">@_projectFileLocks.Count</span>
                    <span class="gtd-kpi-lbl">Locked Git Files</span>
                </div>
                <button class="gtd-btn gtd-btn-outline" @onclick="RefreshAllAsync" disabled="@_isLoading">
                    <i class="bi @(_isLoading ? "bi-arrow-repeat gtd-spin" : "bi-arrow-clockwise")"></i>
                    Sync Platform
                </button>
            </div>
        </div>

        <div class="gtd-mode-tabs">
            <button class="gtd-mode-tab @(_activeMode == "receiver" ? "active" : "")"
                    @onclick='() => SwitchMode("receiver")'>
                <i class="bi bi-inbox-fill"></i>
                <span>Receiver Module — My Assigned Git Scopes</span>
                <span class="gtd-tab-badge">@_myTasks.Count</span>
            </button>
            <button class="gtd-mode-tab @(_activeMode == "dispatcher" ? "active" : "")"
                    @onclick='() => SwitchMode("dispatcher")'>
                <i class="bi bi-diagram-3-fill"></i>
                <span>Team &amp; Git Task Dispatcher — Assign People &amp; Git Files</span>
                <span class="gtd-tab-badge">@_projectTasks.Count</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_bannerMessage))
    {
        <div class="gtd-alert @(_bannerIsError ? "gtd-alert-error" : "gtd-alert-success")">
            <div>
                <i class="bi @(_bannerIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                <span>@_bannerMessage</span>
            </div>
            <button class="gtd-alert-close" @onclick='() => _bannerMessage = null'>✕</button>
        </div>
    }

    <!-- ══════════════════════════════════════════════════════════════════════════════ -->
    <!-- MODE 1: RECEIVER MODULE (DEVELOPER WORKBENCH FOR ASSIGNED TASKS & GIT FILES)   -->
    <!-- ══════════════════════════════════════════════════════════════════════════════ -->
    @if (_activeMode == "receiver")
    {
        <div class="gtd-receiver-grid">
            <!-- LEFT COLUMN: INCOMING ASSIGNED GIT TASKS -->
            <div class="gtd-card gtd-task-list-card">
                <div class="gtd-card-header">
                    <span class="gtd-card-title">INCOMING ASSIGNED TASKS</span>
                    <div class="gtd-filter-pills">
                        @foreach (var f in new[] { ("all", "All"), ("pending", "Pending"), ("in-progress", "Active"), ("completed", "Done") })
                        {
                            <button class="gtd-filter-pill @(_receiverFilter == f.Item1 ? "active" : "")"
                                    @onclick="() => _receiverFilter = f.Item1">
                                @f.Item2
                            </button>
                        }
                    </div>
                </div>

                @if (FilteredMyTasks.Count == 0)
                {
                    <div class="gtd-empty-box">
                        <i class="bi bi-check2-all"></i>
                        <div class="gtd-empty-title">No tasks in this filter</div>
                        <div class="gtd-empty-sub">Switch to the Dispatcher tab to assign a new Git task.</div>
                    </div>
                }
                else
                {
                    <div class="gtd-task-scroll">
                        @foreach (var task in FilteredMyTasks)
                        {
                            bool selected = _selectedTask?.Id == task.Id;
                            bool isActiveScope = ScopeSvc.CurrentActiveTask?.Id == task.Id;
                            <div class="gtd-task-item @(selected ? "selected" : "")" @onclick="() => SelectTaskAsync(task)">
                                <div class="gtd-task-item-top">
                                    <span class="gtd-prio-pill @GetPriorityClass(task.Priority)">@task.Priority.ToUpperInvariant()</span>
                                    <span class="gtd-status-pill @GetStatusClass(task.Status)">@task.Status</span>
                                </div>
                                <div class="gtd-task-item-title">@task.Title</div>
                                <div class="gtd-task-item-proj">
                                    <i class="bi bi-folder2"></i>
                                    <span>@(string.IsNullOrEmpty(task.ProjectTitle) ? "Syncro Project" : task.ProjectTitle)</span>
                                </div>
                                <div class="gtd-task-item-meta">
                                    <span class="gtd-branch-chip">
                                        <i class="bi bi-git"></i> @task.TargetBranch
                                    </span>
                                    <span class="gtd-files-chip">
                                        <i class="bi bi-file-earmark-code"></i> @task.AssignedFiles.Count files
                                    </span>
                                    <span class="gtd-lock-chip @(task.FileLockMode == "strict" ? "strict" : "advisory")">
                                        <i class="bi bi-shield-lock"></i> @task.FileLockMode
                                    </span>
                                </div>
                                <div class="gtd-progress-row">
                                    <div class="gtd-progress-track">
                                        <div class="gtd-progress-fill" style="width: @(task.Progress)%;"></div>
                                    </div>
                                    <span class="gtd-progress-pct">@task.Progress%</span>
                                </div>
                                <div class="gtd-task-item-foot">
                                    <span>By @task.AssignedByName</span>
                                    <span>Due @task.Deadline.ToString("dd MMM yyyy")</span>
                                </div>
                                @if (isActiveScope)
                                {
                                    <div class="gtd-active-scope-tag">
                                        <i class="bi bi-broadcast"></i> Active Guard in Repository Workbench
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- RIGHT COLUMN: RECEIVER EXECUTION & GIT SCOPE WORKBENCH -->
            <div class="gtd-receiver-detail">
                @if (_selectedTask == null)
                {
                    <div class="gtd-card gtd-empty-box" style="min-height: 460px;">
                        <i class="bi bi-inboxes" style="font-size: 40px;"></i>
                        <div class="gtd-empty-title">Select an Assigned Task</div>
                        <div class="gtd-empty-sub">Inspect your assigned Git file set, teammate file locks, and branch setup controls.</div>
                    </div>
                }
                else
                {
                    <!-- CARD A: TASK HEADER, WORKSPACE REPO BINDING & 1-CLICK RECEIVER ACTIONS -->
                    <div class="gtd-card">
                        <div class="gtd-detail-head">
                            <div>
                                <div class="gtd-detail-badges">
                                    <span class="gtd-prio-pill @GetPriorityClass(_selectedTask.Priority)">@_selectedTask.Priority.ToUpperInvariant() PRIORITY</span>
                                    <span class="gtd-status-pill @GetStatusClass(_selectedTask.Status)">@_selectedTask.Status.ToUpperInvariant()</span>
                                    <span class="gtd-lock-chip @(_selectedTask.FileLockMode == "strict" ? "strict" : "advisory")">
                                        <i class="bi bi-lock-fill"></i> LOCK MODE: @_selectedTask.FileLockMode.ToUpperInvariant()
                                    </span>
                                    <span class="gtd-branch-chip">
                                        <i class="bi bi-git"></i> @_selectedTask.BaseBranch → <b>@_selectedTask.TargetBranch</b>
                                    </span>
                                </div>
                                <h2 class="gtd-detail-title">@_selectedTask.Title</h2>
                                <p class="gtd-detail-desc">@_selectedTask.ScopeDescription</p>
                            </div>

                            <div class="gtd-detail-actions">
                                <button class="gtd-btn gtd-btn-primary"
                                        @onclick="AcceptAndSetupReceiverAsync"
                                        disabled="@_isSettingUp">
                                    <i class="bi @(_isSettingUp ? "bi-arrow-repeat gtd-spin" : "bi-terminal-plus")"></i>
                                    @(_isSettingUp ? "Configuring Repo & Branch…" : "Accept & Checkout Branch")
                                </button>
                                <button class="gtd-btn gtd-btn-outline"
                                        @onclick="OpenInScopedGitManager">
                                    <i class="bi bi-source"></i>
                                    Open Scoped Git Workbench
                                </button>
                                <button class="gtd-btn gtd-btn-emerald"
                                        @onclick="VerifyAndCompleteTaskAsync"
                                        disabled="@_isVerifyingTask">
                                    <i class="bi @(_isVerifyingTask ? "bi-arrow-repeat gtd-spin" : "bi-patch-check-fill")"></i>
                                    @(_isVerifyingTask ? "Running gates…" : "Verify & Complete")
                                </button>
                            </div>
                        </div>

                        <!-- Local Workspace Path Binding Bar -->
                        <div class="gtd-repo-bind-bar">
                            <div class="gtd-repo-bind-left">
                                <span class="gtd-field-lbl">LOCAL GIT WORKSPACE</span>
                                <input class="gtd-input"
                                       placeholder="Local repository path (e.g. D:\DeveloperAI\DEVOLOPER\Syncro.Desktop)"
                                       @bind="_receiverRepoPath" />
                                @if (_knownProjects.Count > 0)
                                {
                                    <select class="gtd-select" style="max-width: 240px;" @onchange="OnReceiverWorkspacePicked">
                                        <option value="">Switch local workspace…</option>
                                        @foreach (var kp in _knownProjects)
                                        {
                                            <option value="@kp.Path">@kp.Name — @kp.Path</option>
                                        }
                                    </select>
                                }
                                <button class="gtd-btn gtd-btn-sm gtd-btn-outline" @onclick="RefreshReceiverGitStatusAsync">
                                    <i class="bi bi-arrow-repeat"></i> Inspect Tree
                                </button>
                            </div>
                            <div class="gtd-repo-bind-right">
                                @if (_receiverGitStatus is { IsRepo: true })
                                {
                                    <span class="gtd-git-ready-pill">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Branch: <b>@_receiverGitStatus.Branch</b> · @_receiverGitStatus.Files.Count changed
                                    </span>
                                }
                                else
                                {
                                    <span class="gtd-git-warn-pill">
                                        <i class="bi bi-cloud-arrow-down"></i> Will clone on Accept
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Progress, Commit SHA & 4 SRE Verification Gates -->
                        <div class="gtd-telemetry-strip">
                            <div class="gtd-telemetry-col">
                                <label class="gtd-field-lbl">TASK STATUS &amp; PROGRESS (@_selectedTask.Progress%)</label>
                                <div class="gtd-status-progress-row">
                                    <select class="gtd-select" style="width: 145px;"
                                            value="@_selectedTask.Status"
                                            @onchange="OnReceiverStatusChangedAsync">
                                        <option value="pending">Pending</option>
                                        <option value="in-progress">In Progress</option>
                                        <option value="completed">Completed</option>
                                        <option value="delayed">Delayed</option>
                                    </select>
                                    <input type="range" min="0" max="100" step="5"
                                           class="gtd-range"
                                           @bind="_selectedTask.Progress"
                                           @bind:after="SaveReceiverProgressAsync" />
                                    <span class="gtd-pct-badge">@_selectedTask.Progress%</span>
                                </div>
                            </div>

                            <div class="gtd-telemetry-col">
                                <label class="gtd-field-lbl">VERIFICATION GATE &amp; COMMIT TELEMETRY</label>
                                <div class="gtd-gate-pills">
                                    <span class="gtd-gate-pill @GateCss(_selectedTask.VerificationGate.BuildStatus)" title="@_selectedTask.VerificationGate.BuildStatus">
                                        <i class="bi bi-hammer"></i> Build: @GateText(_selectedTask.VerificationGate.BuildStatus)
                                    </span>
                                    <span class="gtd-gate-pill @GateCss(_selectedTask.VerificationGate.TestsStatus)" title="@_selectedTask.VerificationGate.TestsStatus">
                                        <i class="bi bi-check2-square"></i> Tests: @GateText(_selectedTask.VerificationGate.TestsStatus)
                                    </span>
                                    <span class="gtd-gate-pill @GateCss(_selectedTask.VerificationGate.SastStatus)" title="@_selectedTask.VerificationGate.SastStatus">
                                        <i class="bi bi-shield-check"></i> SAST: @GateText(_selectedTask.VerificationGate.SastStatus)
                                    </span>
                                    <span class="gtd-gate-pill @GateCss(_selectedTask.VerificationGate.ContractsStatus)" title="@_selectedTask.VerificationGate.ContractsStatus">
                                        <i class="bi bi-diagram-3"></i> Contracts: @GateText(_selectedTask.VerificationGate.ContractsStatus)
                                    </span>
                                    @if (!string.IsNullOrEmpty(_selectedTask.LatestCommitSha))
                                    {
                                        <span class="gtd-sha-pill" title="Latest verified commit synced to platform">
                                            <i class="bi bi-git"></i> @_selectedTask.LatestCommitSha[..Math.Min(7, _selectedTask.LatestCommitSha.Length)]
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CARD B: 3-COLUMN GIT FILE SCOPE & LOCK INSPECTOR -->
                    <div class="gtd-three-col-scope">
                        <!-- COLUMN 1: AUTHORITATIVE ASSIGNED GIT FILES -->
                        <div class="gtd-card">
                            <div class="gtd-card-header">
                                <div>
                                    <span class="gtd-card-title text-emerald">
                                        <i class="bi bi-file-earmark-check-fill"></i>
                                        ASSIGNED GIT FILES (@_selectedTask.AssignedFiles.Count)
                                    </span>
                                    <div class="gtd-card-sub">Files you are authorized to modify in this task</div>
                                </div>
                            </div>

                            @if (_selectedTask.AssignedFiles.Count == 0 && _selectedTask.AllowedGlobs.Count == 0)
                            {
                                <div class="gtd-empty-box small">No explicit file restrictions on this task.</div>
                            }
                            else
                            {
                                <div class="gtd-file-scope-list">
                                    @foreach (var file in _selectedTask.AssignedFiles)
                                    {
                                        var localState = GetLocalFileState(file);
                                        <div class="gtd-scope-file-row in-scope">
                                            <div class="gtd-scope-file-main">
                                                <span class="gtd-scope-badge scope-in">IN SCOPE</span>
                                                <code class="gtd-file-code" title="@file">@file</code>
                                            </div>
                                            <div class="gtd-scope-file-right">
                                                <span class="gtd-git-state-tag @localState.Css">@localState.Label</span>
                                            </div>
                                        </div>
                                    }

                                    @if (_selectedTask.AllowedGlobs.Count > 0)
                                    {
                                        <div class="gtd-sub-section-lbl">ALLOWED DIRECTORY GLOBS</div>
                                        @foreach (var glob in _selectedTask.AllowedGlobs)
                                        {
                                            <div class="gtd-scope-file-row glob-row">
                                                <span class="gtd-scope-badge scope-glob">GLOB</span>
                                                <code class="gtd-file-code">@glob</code>
                                            </div>
                                        }
                                    }

                                    @if (_selectedTask.ReadOnlyFiles.Count > 0)
                                    {
                                        <div class="gtd-sub-section-lbl">READ-ONLY REFERENCE FILES</div>
                                        @foreach (var ro in _selectedTask.ReadOnlyFiles)
                                        {
                                            <div class="gtd-scope-file-row ro-row">
                                                <span class="gtd-scope-badge scope-ro">READ-ONLY</span>
                                                <code class="gtd-file-code">@ro</code>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>

                        <!-- COLUMN 2: TEAMMATE-LOCKED GIT FILES (CONFLICT PREVENTION) -->
                        <div class="gtd-card">
                            <div class="gtd-card-header">
                                <div>
                                    <span class="gtd-card-title text-crimson">
                                        <i class="bi bi-shield-lock-fill"></i>
                                        TEAMMATE-LOCKED FILES (@_selectedTask.TeammateLockedFiles.Count)
                                    </span>
                                    <div class="gtd-card-sub">Protected files claimed by other active team tasks</div>
                                </div>
                            </div>

                            @if (_selectedTask.TeammateLockedFiles.Count == 0)
                            {
                                <div class="gtd-empty-box small">
                                    <i class="bi bi-shield-check text-emerald"></i>
                                    <div>No conflicting teammate locks in this project.</div>
                                </div>
                            }
                            else
                            {
                                <div class="gtd-file-scope-list">
                                    @foreach (var lk in _selectedTask.TeammateLockedFiles)
                                    {
                                        <div class="gtd-scope-file-row locked-scope">
                                            <div class="gtd-scope-file-main">
                                                <span class="gtd-scope-badge scope-locked">
                                                    <i class="bi bi-lock-fill"></i> @lk.LockedByName
                                                </span>
                                                <code class="gtd-file-code" title="@lk.FilePath">@lk.FilePath</code>
                                            </div>
                                            <div class="gtd-lock-task-caption">
                                                Task: <b>@lk.TaskTitle</b> · Branch: <code>@lk.TargetBranch</code>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- COLUMN 3: AI SCOPED IMPLEMENTATION METHODOLOGY -->
                        <div class="gtd-card">
                            <div class="gtd-card-header">
                                <div>
                                    <span class="gtd-card-title text-purple">
                                        <i class="bi bi-stars"></i>
                                        AI SCOPED METHODOLOGY
                                    </span>
                                    <div class="gtd-card-sub">Step-by-step plan constrained to your assigned files</div>
                                </div>
                                <button class="gtd-btn gtd-btn-sm gtd-btn-outline"
                                        @onclick="GenerateScopedMethodologyAsync"
                                        disabled="@_isGeneratingPlan">
                                    <i class="bi @(_isGeneratingPlan ? "bi-arrow-repeat gtd-spin" : "bi-magic")"></i>
                                    @(_isGeneratingPlan ? "Analyzing…" : "Draft Plan")
                                </button>
                            </div>

                            @if (_methodology != null)
                            {
                                <div class="gtd-methodology-box">
                                    <pre class="gtd-methodology-pre">@_methodology.Methodology</pre>
                                </div>
                            }
                            else
                            {
                                <div class="gtd-empty-box small">
                                    <i class="bi bi-lightbulb"></i>
                                    <div>Click <b>Accept &amp; Checkout Branch</b> or <b>Draft Plan</b> to generate a step-by-step execution guide for your assigned Git file set.</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════════════════════════════════════ -->
    <!-- MODE 2: TEAM & GIT TASK DISPATCHER (ASSIGN PEOPLE THEIR TASK & GIT FILE SET)   -->
    <!-- ══════════════════════════════════════════════════════════════════════════════ -->
    @if (_activeMode == "dispatcher")
    {
        <!-- PROJECT & LOCAL REPOSITORY TREE SYNC BAR -->
        <div class="gtd-card gtd-project-bar">
            <div class="gtd-project-bar-left">
                <div class="gtd-field-group">
                    <label class="gtd-field-lbl">ACTIVE PROJECT</label>
                    <select class="gtd-select" style="min-width: 290px;"
                            value="@_selectedProjectId"
                            @onchange="OnProjectChangedAsync">
                        @foreach (var p in _projects)
                        {
                            <option value="@p.Id">@p.Title (@p.Status.ToUpperInvariant())</option>
                        }
                    </select>
                </div>

                <div class="gtd-field-group" style="flex: 1; min-width: 280px;">
                    <label class="gtd-field-lbl">LOCAL GIT REPOSITORY FOR FILE PICKER</label>
                    <div class="d-flex gap-2">
                        <input class="gtd-input"
                               placeholder="D:\DeveloperAI\DEVOLOPER\Syncro.Desktop"
                               @bind="_dispatchRepoPath" />
                        @if (_knownProjects.Count > 0)
                        {
                            <select class="gtd-select" style="max-width: 210px;" @onchange="OnDispatchWorkspacePickedAsync">
                                <option value="">Quick pick repo…</option>
                                @foreach (var kp in _knownProjects)
                                {
                                    <option value="@kp.Path">@kp.Name</option>
                                }
                            </select>
                        }
                    </div>
                </div>
            </div>

            <div class="gtd-project-bar-right">
                <button class="gtd-btn gtd-btn-outline" @onclick="LoadRepoTreeForDispatcherAsync" disabled="@_isSyncingTree">
                    <i class="bi @(_isSyncingTree ? "bi-arrow-repeat gtd-spin" : "bi-folder2-open")"></i>
                    Load Repo Files (@_repoTrackedFiles.Count)
                </button>
                <button class="gtd-btn gtd-btn-primary" @onclick="SyncRepoTreeToPlatformAsync" disabled="@_isSyncingTree">
                    <i class="bi @(_isSyncingTree ? "bi-arrow-repeat gtd-spin" : "bi-cloud-upload")"></i>
                    Sync Tree to Platform
                </button>
            </div>
        </div>

        <div class="gtd-dispatcher-grid">
            <!-- LEFT COLUMN: TEAM ROSTER, ROLES & DEFAULT MODULE OWNERSHIP -->
            <div class="gtd-card gtd-team-panel">
                <div class="gtd-card-header">
                    <div>
                        <span class="gtd-card-title">
                            <i class="bi bi-people-fill"></i>
                            PROJECT TEAM ROSTER (@(_teamRoster?.Members.Count ?? 0))
                        </span>
                        <div class="gtd-card-sub">Manage roles, owned directory globs, and pick an assignee</div>
                    </div>
                    <button class="gtd-btn gtd-btn-sm gtd-btn-outline"
                            @onclick="() => _showAddMemberForm = !_showAddMemberForm">
                        <i class="bi @(_showAddMemberForm ? "bi-x-lg" : "bi-person-plus-fill")"></i>
                        @(_showAddMemberForm ? "Close" : "+ Add Member")
                    </button>
                </div>

                @if (_showAddMemberForm)
                {
                    <div class="gtd-add-member-box">
                        <div class="gtd-sub-section-lbl">ADD OR UPDATE TEAM MEMBER</div>
                        <div class="gtd-form-grid-2">
                            <div>
                                <label class="gtd-field-lbl">FULL NAME *</label>
                                <input class="gtd-input" placeholder="e.g. Ananya Verma" @bind="_newMemberName" />
                            </div>
                            <div>
                                <label class="gtd-field-lbl">EMAIL / HANDLE *</label>
                                <input class="gtd-input" placeholder="ananya@sankalp.dev" @bind="_newMemberEmail" />
                            </div>
                            <div>
                                <label class="gtd-field-lbl">PROJECT ROLE</label>
                                <select class="gtd-select" @bind="_newMemberRole">
                                    <option value="backend">Backend Engineer</option>
                                    <option value="frontend">Frontend Engineer</option>
                                    <option value="sre">Site Reliability (SRE)</option>
                                    <option value="architect">System Architect</option>
                                    <option value="mobile">Mobile Engineer</option>
                                    <option value="qa">QA &amp; Verification</option>
                                    <option value="contributor">Contributor</option>
                                </select>
                            </div>
                            <div>
                                <label class="gtd-field-lbl">SKILLS (COMMA SEPARATED)</label>
                                <input class="gtd-input" placeholder="C#, Blazor, Git, AST" @bind="_newMemberSkills" />
                            </div>
                        </div>
                        <div class="mt-2">
                            <label class="gtd-field-lbl">DEFAULT OWNED GIT GLOBS (COMMA SEPARATED)</label>
                            <input class="gtd-input" placeholder="Services/Git/**, Components/Pages/Git/**" @bind="_newMemberOwnedGlobs" />
                        </div>
                        <button class="gtd-btn gtd-btn-primary w-100 mt-3" @onclick="SaveTeamMemberAsync">
                            <i class="bi bi-check2-circle"></i> Save Team Member &amp; Ownership Scope
                        </button>
                    </div>
                }

                @if (_teamRoster != null && !_teamRoster.FromPlatform)
                {
                    <div class="gtd-local-note" title="The web platform has no /api/mobile/projects/{id}/team endpoint yet.">
                        <i class="bi bi-hdd"></i> Team list is stored on this computer only — the platform has no team API yet.
                    </div>
                }
                <div class="gtd-member-list">
                    @if (_teamRoster != null)
                    {
                        @foreach (var member in _teamRoster.Members)
                        {
                            bool isPicked = string.Equals(_draftAssigneeId, member.UserId, StringComparison.OrdinalIgnoreCase);
                            <div class="gtd-member-card @(isPicked ? "picked" : "")">
                                <div class="gtd-member-top">
                                    <div class="gtd-avatar">@GetInitials(member.Name)</div>
                                    <div class="gtd-member-info">
                                        <div class="gtd-member-name-row">
                                            <span class="gtd-member-name">@member.Name</span>
                                            @if (member.IsLead)
                                            {
                                                <span class="gtd-role-badge lead">LEAD</span>
                                            }
                                            <span class="gtd-role-badge">@member.ProjectRole.ToUpperInvariant()</span>
                                        </div>
                                        <div class="gtd-member-email">@member.Email</div>
                                    </div>
                                    <div class="gtd-member-actions">
                                        <button class="gtd-btn gtd-btn-sm @(isPicked ? "gtd-btn-primary" : "gtd-btn-outline")"
                                                @onclick="() => PickMemberForTask(member)">
                                            @(isPicked ? "✓ Assigning" : "Assign Task →")
                                        </button>
                                        @if (!member.IsLead)
                                        {
                                            <button class="gtd-icon-btn danger" title="Remove from team"
                                                    @onclick="() => RemoveMemberAsync(member.UserId)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        }
                                    </div>
                                </div>

                                @if (member.OwnedPaths.Count > 0)
                                {
                                    <div class="gtd-owned-globs-row">
                                        <span class="gtd-owned-lbl">Owned Globs:</span>
                                        @foreach (var g in member.OwnedPaths)
                                        {
                                            <code class="gtd-glob-pill" @onclick="() => AddGlobToDraft(g)" title="Click to add to task globs">@g</code>
                                        }
                                    </div>
                                }

                                <div class="gtd-member-stats">
                                    <div class="gtd-mstat">
                                        <b>@member.ActiveTaskCount</b>
                                        <span>Active</span>
                                    </div>
                                    <div class="gtd-mstat">
                                        <b>@member.CompletedTaskCount</b>
                                        <span>Completed</span>
                                    </div>
                                    <div class="gtd-mstat">
                                        <b>@member.LockedFiles.Count</b>
                                        <span>Locked Files</span>
                                    </div>
                                    <div class="gtd-mstat">
                                        <b>@member.AvgProgress%</b>
                                        <span>Avg Progress</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- RIGHT COLUMN: VISUAL GIT FILE-SET TASK DISPATCHER + ACTIVE FILE-LOCK MATRIX -->
            <div class="gtd-dispatcher-right">
                <!-- COMPOSER CARD: ASSIGN PERSON + TASK + GIT FILES -->
                <div class="gtd-card">
                    <div class="gtd-card-header">
                        <div>
                            <span class="gtd-card-title text-blue">
                                <i class="bi bi-send-check-fill"></i>
                                DISPATCH NEW GIT-SCOPED TASK
                            </span>
                            <div class="gtd-card-sub">Select a team member, define the task, and check the exact Git files or folder globs they own</div>
                        </div>
                        @if (_draftAssignedFiles.Count > 0 || _draftAllowedGlobs.Count > 0)
                        {
                            <button class="gtd-btn gtd-btn-sm gtd-btn-outline" @onclick="ClearDraftFiles">
                                Clear Selection (@_draftAssignedFiles.Count files, @_draftAllowedGlobs.Count globs)
                            </button>
                        }
                    </div>

                    <!-- Step 1: Task & Assignee Metadata -->
                    <div class="gtd-form-grid-3">
                        <div>
                            <label class="gtd-field-lbl">1. ASSIGN TO TEAM MEMBER *</label>
                            <select class="gtd-select" value="@_draftAssigneeId" @onchange="OnDraftAssigneeSelected">
                                <option value="">Select team member…</option>
                                @if (_teamRoster != null)
                                {
                                    @foreach (var m in _teamRoster.Members)
                                    {
                                        <option value="@m.UserId">@m.Name (@m.ProjectRole · @m.ActiveTaskCount active)</option>
                                    }
                                }
                            </select>
                        </div>

                        <div>
                            <label class="gtd-field-lbl">2. PRIORITY &amp; DEADLINE *</label>
                            <div class="d-flex gap-2">
                                <select class="gtd-select" style="width: 115px;" @bind="_draftPriority">
                                    <option value="high">High</option>
                                    <option value="medium">Medium</option>
                                    <option value="low">Low</option>
                                </select>
                                <input type="date" class="gtd-input" @bind="_draftDeadline" />
                            </div>
                        </div>

                        <div>
                            <label class="gtd-field-lbl">3. GIT FILE LOCK ENFORCEMENT</label>
                            <select class="gtd-select" @bind="_draftLockMode">
                                <option value="strict">Strict Guard (Block out-of-scope commits)</option>
                                <option value="exclusive">Exclusive Lock (Block all overlapping tasks)</option>
                                <option value="advisory">Advisory Warning Only</option>
                            </select>
                        </div>
                    </div>

                    <div class="gtd-form-grid-2 mt-3">
                        <div>
                            <label class="gtd-field-lbl">TASK TITLE *</label>
                            <input class="gtd-input"
                                   placeholder="e.g. Implement JWT Role Guard & Contract Verification on Auth Endpoints"
                                   @bind="_draftTitle"
                                   @bind:event="oninput" />
                        </div>
                        <div class="gtd-form-grid-2">
                            <div>
                                <label class="gtd-field-lbl">BASE BRANCH</label>
                                <input class="gtd-input" placeholder="main" @bind="_draftBaseBranch" />
                            </div>
                            <div>
                                <label class="gtd-field-lbl">TARGET TASK BRANCH</label>
                                <input class="gtd-input"
                                       placeholder="@SuggestedTargetBranch"
                                       @bind="_draftTargetBranch" />
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="gtd-field-lbl">TASK SCOPE &amp; ACCEPTANCE INSTRUCTIONS</label>
                        <textarea class="gtd-textarea" rows="2"
                                  placeholder="Describe what the assignee should build, verify, and test within the assigned Git files…"
                                  @bind="_draftDescription"></textarea>
                    </div>

                    <!-- Step 2: Interactive Git File-Set & Directory Glob Picker -->
                    <div class="gtd-file-picker-section mt-3">
                        <div class="gtd-picker-toolbar">
                            <div class="gtd-picker-tabs">
                                <button class="gtd-picker-tab @(_pickerSource == "modified" ? "active" : "")"
                                        @onclick='() => _pickerSource = "modified"'>
                                    <i class="bi bi-file-earmark-diff"></i>
                                    Working Tree Changed (@_repoModifiedFiles.Count)
                                </button>
                                <button class="gtd-picker-tab @(_pickerSource == "all" ? "active" : "")"
                                        @onclick='() => _pickerSource = "all"'>
                                    <i class="bi bi-files"></i>
                                    All Tracked Repo Files (@_repoTrackedFiles.Count)
                                </button>
                            </div>

                            <div class="gtd-picker-search">
                                <i class="bi bi-search"></i>
                                <input class="gtd-search-input"
                                       placeholder="Filter files by path, folder, or extension (e.g. Services/Git, .razor, .ts)…"
                                       @bind="_fileSearchQuery"
                                       @bind:event="oninput" />
                            </div>

                            <div class="gtd-Manual-add">
                                <input class="gtd-input" style="width: 220px;"
                                       placeholder="Add path or glob (e.g. src/api/**)"
                                       @bind="_manualPathOrGlob" />
                                <button class="gtd-btn gtd-btn-sm gtd-btn-outline" @onclick="AddManualPathOrGlob">
                                    + Add Scope
                                </button>
                            </div>
                        </div>

                        <!-- Quick Directory Glob Bar -->
                        @if (VisibleTopDirectories.Count > 0)
                        {
                            <div class="gtd-dir-glob-bar">
                                <span class="gtd-owned-lbl">Quick Assign Directory Glob:</span>
                                @foreach (var dir in VisibleTopDirectories)
                                {
                                    string glob = $"{dir}/**";
                                    bool hasGlob = _draftAllowedGlobs.Contains(glob, StringComparer.OrdinalIgnoreCase);
                                    <button class="gtd-dir-chip @(hasGlob ? "active" : "")"
                                            @onclick="() => ToggleDraftGlob(glob)">
                                        <i class="bi @(hasGlob ? "bi-check2-square" : "bi-folder-plus")"></i>
                                        @glob
                                    </button>
                                }
                            </div>
                        }

                        <!-- File Tree Checkbox List with Live Teammate Lock Badges -->
                        <div class="gtd-picker-list">
                            @if (FilteredPickerFiles.Count == 0)
                            {
                                <div class="gtd-empty-box small">
                                    No matching files. Switch between "Working Tree Changed" and "All Tracked Repo Files" or click "Load Repo Files".
                                </div>
                            }
                            else
                            {
                                @foreach (var filePath in FilteredPickerFiles.Take(120))
                                {
                                    bool isChecked = _draftAssignedFiles.Contains(filePath, StringComparer.OrdinalIgnoreCase);
                                    var activeLock = GetExistingFileLock(filePath);
                                    bool isLockedByOther = activeLock != null &&
                                        !string.Equals(activeLock.LockedByUserId, _draftAssigneeId, StringComparison.OrdinalIgnoreCase);

                                    <div class="gtd-picker-row @(isChecked ? "checked" : "") @(isLockedByOther ? "locked-warning" : "")"
                                         @onclick="() => ToggleDraftFile(filePath)">
                                        <input type="checkbox"
                                               checked="@isChecked"
                                               @onclick:stopPropagation="true"
                                               @onchange="() => ToggleDraftFile(filePath)" />
                                        <i class="bi bi-file-earmark-code gtd-file-icon"></i>
                                        <code class="gtd-picker-path">@filePath</code>

                                        <div class="gtd-picker-row-right">
                                            @if (activeLock != null)
                                            {
                                                <span class="gtd-lock-pill @(isLockedByOther ? "conflict" : "same-owner")"
                                                      title="Task: @activeLock.TaskTitle (@activeLock.TargetBranch)">
                                                    <i class="bi bi-lock-fill"></i>
                                                    Locked by @activeLock.LockedByName (@activeLock.TaskTitle)
                                                </span>
                                            }
                                            @if (_repoModifiedSet.Contains(filePath))
                                            {
                                                <span class="gtd-mod-pill">MODIFIED</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Selected Assigned Files & Globs Summary Chips -->
                        @if (_draftAssignedFiles.Count > 0 || _draftAllowedGlobs.Count > 0)
                        {
                            <div class="gtd-selected-summary">
                                <div class="gtd-sub-section-lbl">
                                    SELECTED GIT SCOPE FOR THIS TASK (@_draftAssignedFiles.Count FILES · @_draftAllowedGlobs.Count GLOBS)
                                </div>
                                <div class="gtd-chip-wrap">
                                    @foreach (var f in _draftAssignedFiles)
                                    {
                                        <span class="gtd-sel-chip file">
                                            <i class="bi bi-file-earmark-check"></i> @f
                                            <button @onclick="() => _draftAssignedFiles.Remove(f)">✕</button>
                                        </span>
                                    }
                                    @foreach (var g in _draftAllowedGlobs)
                                    {
                                        <span class="gtd-sel-chip glob">
                                            <i class="bi bi-folder-check"></i> @g
                                            <button @onclick="() => _draftAllowedGlobs.Remove(g)">✕</button>
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Collision Warning & Override Toggle -->
                        @if (DraftCollisions.Count > 0)
                        {
                            <div class="gtd-collision-banner">
                                <div class="gtd-collision-text">
                                    <i class="bi bi-exclamation-octagon-fill"></i>
                                    <div>
                                        <b>Git File-Lock Collision Detected (@DraftCollisions.Count file(s)):</b>
                                        <span>
                                            @string.Join(", ", DraftCollisions.Select(c => $"'{c.FilePath}' (locked by {c.LockedByName})"))
                                        </span>
                                    </div>
                                </div>
                                <label class="gtd-override-chk">
                                    <input type="checkbox" @bind="_draftForceAssign" />
                                    <span>Force Override File Lock</span>
                                </label>
                            </div>
                        }

                        <div class="gtd-dispatch-submit-row">
                            <button class="gtd-btn gtd-btn-primary gtd-btn-lg"
                                    @onclick="DispatchGitTaskAsync"
                                    disabled="@_isDispatching">
                                <i class="bi @(_isDispatching ? "bi-arrow-repeat gtd-spin" : "bi-send-fill")"></i>
                                @(_isDispatching
                                    ? "Dispatching Task & Locking Git Scope…"
                                    : $"Assign Task & Lock {_draftAssignedFiles.Count} Git File(s)")
                            </button>
                        </div>
                    </div>
                </div>

                <!-- CARD 2: ACTIVE PROJECT TASKS & GIT FILE-LOCK MATRIX -->
                <div class="gtd-card">
                    <div class="gtd-card-header">
                        <div>
                            <span class="gtd-card-title">
                                <i class="bi bi-table"></i>
                                DISTRIBUTED GIT TASKS &amp; FILE-LOCK MATRIX (@_projectTasks.Count)
                            </span>
                            <div class="gtd-card-sub">Live status of every assigned task, branch, file ownership lock, and SRE verification gate</div>
                        </div>
                    </div>

                    @if (_projectTasks.Count == 0)
                    {
                        <div class="gtd-empty-box small">No tasks distributed for this project yet.</div>
                    }
                    else
                    {
                        <div class="gtd-matrix-table-wrap">
                            <table class="gtd-matrix-table">
                                <thead>
                                    <tr>
                                        <th>TASK &amp; BRANCH</th>
                                        <th>ASSIGNEE</th>
                                        <th>ASSIGNED GIT FILES &amp; GLOBS</th>
                                        <th>LOCK MODE</th>
                                        <th>PROGRESS &amp; GATES</th>
                                        <th>ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pt in _projectTasks)
                                    {
                                        <tr>
                                            <td>
                                                <div class="gtd-matrix-title">@pt.Title</div>
                                                <div class="gtd-matrix-sub">
                                                    <span class="gtd-prio-pill @GetPriorityClass(pt.Priority)">@pt.Priority</span>
                                                    <code class="ms-1">@pt.TargetBranch</code>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="gtd-matrix-user">@(string.IsNullOrEmpty(pt.AssignedToName) ? pt.AssignedTo : pt.AssignedToName)</div>
                                                <div class="gtd-matrix-sub">Due @pt.Deadline.ToString("dd MMM")</div>
                                            </td>
                                            <td>
                                                <div class="gtd-matrix-files">
                                                    @foreach (var af in pt.AssignedFiles.Take(4))
                                                    {
                                                        <code class="gtd-mini-file-pill" title="@af">@Path.GetFileName(af)</code>
                                                    }
                                                    @if (pt.AssignedFiles.Count > 4)
                                                    {
                                                        <span class="gtd-mini-more">+@(pt.AssignedFiles.Count - 4) more</span>
                                                    }
                                                    @foreach (var ag in pt.AllowedGlobs)
                                                    {
                                                        <code class="gtd-mini-glob-pill">@ag</code>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="gtd-lock-chip @(pt.FileLockMode == "strict" ? "strict" : "advisory")">
                                                    @pt.FileLockMode
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="gtd-status-pill @GetStatusClass(pt.Status)">@pt.Status</span>
                                                    <b>@pt.Progress%</b>
                                                </div>
                                                <div class="gtd-mini-gates mt-1">
                                                    <span class="@(pt.VerificationGate.BuildPassed ? "text-emerald" : "text-muted")" title="Build">● Build</span>
                                                    <span class="@(pt.VerificationGate.SastPassed ? "text-emerald" : "text-muted")" title="SAST">● SAST</span>
                                                    <span class="@(pt.VerificationGate.ContractsPassed ? "text-emerald" : "text-muted")" title="Contracts">● Contracts</span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <button class="gtd-btn gtd-btn-sm gtd-btn-outline"
                                                            title="Open in Receiver View"
                                                            @onclick="() => OpenTaskInReceiverAsync(pt)">
                                                        Inspect
                                                    </button>
                                                    <button class="gtd-icon-btn danger"
                                                            title="Delete task & release file locks"
                                                            @onclick="() => DeleteProjectTaskAsync(pt.Id)">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? TaskId { get; set; }

    private bool _isLoading = true;
    private string _activeMode = "receiver"; // "receiver" | "dispatcher"
    private string _receiverFilter = "all";
    private string? _bannerMessage;
    private bool _bannerIsError;

    // Projects & Known Local Workspaces
    private List<PlatformProjectModel> _projects = new();
    private string _selectedProjectId = "";
    private List<ProjectModel> _knownProjects = new();

    // Receiver State
    private List<AgentTaskModel> _myTasks = new();
    private AgentTaskModel? _selectedTask;
    private string _receiverRepoPath = @"D:\DeveloperAI\DEVOLOPER\Syncro.Desktop";
    private Syncro.Desktop.Services.Git.GitStatus? _receiverGitStatus;
    private bool _isSettingUp;
    private bool _isVerifyingTask;
    private bool _isGeneratingPlan;
    private LocalMcpServer.MethodologyResponse? _methodology;

    // Dispatcher & Team State
    private ProjectTeamRosterResponse? _teamRoster;
    private List<AgentTaskModel> _projectTasks = new();
    private List<GitFileLockModel> _projectFileLocks = new();
    private string _dispatchRepoPath = @"D:\DeveloperAI\DEVOLOPER\Syncro.Desktop";
    private List<string> _repoTrackedFiles = new();
    private List<string> _repoModifiedFiles = new();
    private HashSet<string> _repoModifiedSet = new(StringComparer.OrdinalIgnoreCase);
    private bool _isSyncingTree;

    // Add Member Form
    private bool _showAddMemberForm;
    private string _newMemberName = "";
    private string _newMemberEmail = "";
    private string _newMemberRole = "backend";
    private string _newMemberSkills = "C#, .NET 9, Git";
    private string _newMemberOwnedGlobs = "";

    // Task Dispatcher Form
    private string _draftAssigneeId = "";
    private string _draftAssigneeName = "";
    private string _draftTitle = "";
    private string _draftDescription = "";
    private string _draftPriority = "high";
    private DateTime _draftDeadline = DateTime.Now.AddDays(3);
    private string _draftBaseBranch = "main";
    private string _draftTargetBranch = "";
    private string _draftLockMode = "strict";
    private List<string> _draftAssignedFiles = new();
    private List<string> _draftAllowedGlobs = new();
    private bool _draftForceAssign;
    private bool _isDispatching;

    // Picker Controls
    private string _pickerSource = "modified"; // "modified" | "all"
    private string _fileSearchQuery = "";
    private string _manualPathOrGlob = "";

    private List<AgentTaskModel> FilteredMyTasks =>
        _receiverFilter == "all"
            ? _myTasks
            : _myTasks.Where(t => string.Equals(t.Status, _receiverFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    private string SuggestedTargetBranch
    {
        get
        {
            string who = !string.IsNullOrWhiteSpace(_draftAssigneeName)
                ? _draftAssigneeName.Split(' ')[0].ToLowerInvariant()
                : "dev";
            string slug = string.IsNullOrWhiteSpace(_draftTitle)
                ? "scoped-task"
                : new string(_draftTitle.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-');
            while (slug.Contains("--")) slug = slug.Replace("--", "-");
            if (slug.Length > 22) slug = slug[..22].Trim('-');
            return $"task/{who}-{slug}";
        }
    }

    private List<string> FilteredPickerFiles
    {
        get
        {
            IEnumerable<string> src = _pickerSource == "modified" && _repoModifiedFiles.Count > 0
                ? _repoModifiedFiles
                : _repoTrackedFiles;

            if (!string.IsNullOrWhiteSpace(_fileSearchQuery))
            {
                var q = _fileSearchQuery.Trim();
                src = src.Where(f => f.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            return src.ToList();
        }
    }

    private List<string> VisibleTopDirectories =>
        _repoTrackedFiles
            .Select(f => f.Contains('/') ? f[..f.IndexOf('/')] : "")
            .Where(d => !string.IsNullOrEmpty(d))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToList();

    private List<GitFileLockModel> DraftCollisions =>
        _projectFileLocks
            .Where(lk =>
                !string.Equals(lk.LockedByUserId, _draftAssigneeId, StringComparison.OrdinalIgnoreCase) &&
                _draftAssignedFiles.Any(f => GitTaskScopeService.PathsMatch(f, lk.FilePath)))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _knownProjects = ProjSvc.GetProjects() ?? new List<ProjectModel>();
        if (_knownProjects.Count > 0 && Directory.Exists(_knownProjects[0].Path))
        {
            _receiverRepoPath = _knownProjects[0].Path;
            _dispatchRepoPath = _knownProjects[0].Path;
        }

        // Check if GitManager handed off selected files for dispatch
        var handoff = ScopeSvc.ConsumePendingDispatch();
        if (handoff.Files.Count > 0)
        {
            _activeMode = "dispatcher";
            if (!string.IsNullOrWhiteSpace(handoff.RepoPath))
            {
                _dispatchRepoPath = handoff.RepoPath;
            }
            _draftAssignedFiles = handoff.Files;
            _bannerMessage = $"Loaded {handoff.Files.Count} selected file(s) from Repository Workbench for team assignment.";
            _bannerIsError = false;
        }

        await RefreshAllAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(TaskId) && _myTasks.Count > 0 && _selectedTask?.Id != TaskId)
        {
            var match = _myTasks.FirstOrDefault(t => t.Id == TaskId);
            if (match != null)
            {
                _activeMode = "receiver";
                await SelectTaskAsync(match);
            }
        }
    }

    private async Task RefreshAllAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _projects = await PixelSvc.GetProjectsAsync();
            if (string.IsNullOrEmpty(_selectedProjectId) && _projects.Count > 0)
            {
                _selectedProjectId = _projects[0].Id;
            }

            _myTasks = await PixelSvc.GetAssignedTasksAsync();
            if (_selectedTask != null)
            {
                _selectedTask = _myTasks.FirstOrDefault(t => t.Id == _selectedTask.Id) ?? _myTasks.FirstOrDefault();
            }
            else if (!string.IsNullOrEmpty(TaskId))
            {
                _selectedTask = _myTasks.FirstOrDefault(t => t.Id == TaskId) ?? _myTasks.FirstOrDefault();
            }
            else
            {
                _selectedTask = _myTasks.FirstOrDefault();
            }

            if (_selectedTask != null)
            {
                await RefreshReceiverGitStatusAsync();
            }

            if (!string.IsNullOrEmpty(_selectedProjectId))
            {
                await LoadProjectDispatchDataAsync(_selectedProjectId);
            }

            await LoadRepoTreeForDispatcherAsync();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void SwitchMode(string mode)
    {
        _activeMode = mode;
    }

    private async Task SelectTaskAsync(AgentTaskModel task)
    {
        _selectedTask = task;
        _methodology = null;

        var matchingProj = _projects.FirstOrDefault(p => p.Id == task.ProjectId);
        if (matchingProj != null && !string.IsNullOrWhiteSpace(matchingProj.LocalRepoPath) && Directory.Exists(matchingProj.LocalRepoPath))
        {
            _receiverRepoPath = matchingProj.LocalRepoPath;
        }

        await RefreshReceiverGitStatusAsync();
    }

