    /// <summary>
    /// Runs SAST, build, tests and the contract scan for real. A gate that can't run is reported as
    /// "not run" (never as passed), errors count as failures, and the task is only marked complete
    /// when every gate that ran passed and at least the build or the tests actually ran.
    /// </summary>
    private async Task VerifyAndCompleteTaskAsync()
    {
        if (_selectedTask == null) return;
        _isVerifyingTask = true;
        _bannerMessage = null;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(_receiverRepoPath) || !Directory.Exists(_receiverRepoPath))
            {
                _bannerIsError = true;
                _bannerMessage = "Nothing verified: the task's local repository folder doesn't exist. Bind a workspace path first.";
                return;
            }

            var gate = new TaskVerificationGateModel { VerifiedAt = DateTime.Now };

            // 1. SAST
            try
            {
                var sast = await SecScanner.ScanAsync(_receiverRepoPath);
                gate.SastPassed = sast.GatePassed;
                gate.SastStatus = sast.GatePassed ? "passed" : $"failed: {sast.Findings.Count} finding(s)";
            }
            catch (Exception ex) { gate.SastStatus = "failed: " + ex.Message; }

            // 2. Build
            try
            {
                var b = await BuildEng.BuildAsync(_receiverRepoPath);
                if (b.Stack == Syncro.Desktop.Services.Build.BuildStack.Unknown) gate.BuildStatus = "not run: no build system detected";
                else { gate.BuildPassed = b.Ok; gate.BuildStatus = b.Ok ? "passed" : $"failed: {b.ErrorCount} error(s)"; }
            }
            catch (Exception ex) { gate.BuildStatus = "failed: " + ex.Message; }

            // 3. Tests (run for real — not copied from the build)
            try
            {
                var t = await TestEng.TestAsync(_receiverRepoPath);
                if (t.Skipped || t.TotalCount == 0) gate.TestsStatus = "not run: no test suite found";
                else { gate.TestsPassed = t.Ok; gate.TestsStatus = t.Ok ? $"passed: {t.PassedCount}/{t.TotalCount}" : $"failed: {t.PassedCount}/{t.TotalCount}"; }
            }
            catch (Exception ex) { gate.TestsStatus = "failed: " + ex.Message; }

            // 4. Contracts across sibling projects
            try
            {
                var parentDir = Directory.GetParent(_receiverRepoPath)?.FullName ?? _receiverRepoPath;
                var c = await ContractScanner.ScanAsync(parentDir);
                if (c.Projects.Count == 0) gate.ContractsStatus = "not run: no projects found";
                else { gate.ContractsPassed = c.Missing == 0; gate.ContractsStatus = c.Missing == 0 ? $"passed: {c.Matched} matched" : $"failed: {c.Missing} broken call(s)"; }
            }
            catch (Exception ex) { gate.ContractsStatus = "failed: " + ex.Message; }

            string latestSha = _selectedTask.LatestCommitSha;
            var commits = await Git.LogAsync(_receiverRepoPath, 1);
            if (commits.Count > 0) latestSha = commits[0].ShortSha;

            var statuses = new[] { gate.SastStatus, gate.BuildStatus, gate.TestsStatus, gate.ContractsStatus };
            bool anyFailed = statuses.Any(x => x.StartsWith("failed"));
            bool somethingProved = gate.BuildStatus.StartsWith("passed") || gate.TestsStatus.StartsWith("passed");
            bool complete = !anyFailed && somethingProved;

            var summary = $"Build: {gate.BuildStatus} · Tests: {gate.TestsStatus} · SAST: {gate.SastStatus} · Contracts: {gate.ContractsStatus}";
            _selectedTask.VerificationGate = gate;
            _selectedTask.LatestCommitSha = latestSha;

            // Persist evidence before asking the platform to create a PR; its endpoint independently
            // enforces these gates and will refuse an unverified task.
            await PixelSvc.UpdateGitTaskAsync(_selectedTask.Id, new UpdateGitTaskRequest
            {
                LatestCommitSha = latestSha,
                VerificationGate = gate
            });

            if (!complete)
            {
                _bannerIsError = true;
                _bannerMessage = $"Task '{_selectedTask.Title}' not completed — " +
                    (anyFailed ? "a gate failed. " : "neither the build nor the tests could run, so nothing proves it works. ") + summary;
                return;
            }

            // Phase 3: only committed work on the assigned task branch may be pushed.
            var status = await Git.StatusAsync(_receiverRepoPath);
            if (!status.IsRepo)
            {
                _bannerIsError = true;
                _bannerMessage = "Verification passed, but this workspace is not a Git repository. Nothing was pushed.";
                return;
            }
            if (!status.IsClean)
            {
                _bannerIsError = true;
                _bannerMessage = $"Verification passed, but {status.Files.Count} uncommitted change(s) remain. Commit them in the scoped Git workbench, then verify again.";
                return;
            }
            if (!string.Equals(status.Branch, _selectedTask.TargetBranch, StringComparison.OrdinalIgnoreCase))
            {
                _bannerIsError = true;
                _bannerMessage = $"Verification passed, but branch '{status.Branch}' is active instead of assigned branch '{_selectedTask.TargetBranch}'. Nothing was pushed.";
                return;
            }

            var push = await Git.PushAsync(_receiverRepoPath, setUpstream: string.IsNullOrWhiteSpace(status.Upstream));
            if (!push.Ok)
            {
                _bannerIsError = true;
                _bannerMessage = "Verification passed, but Git push failed. Check this PC's GitHub credentials and retry. " +
                    (string.IsNullOrWhiteSpace(push.Error) ? push.Output : push.Error);
                return;
            }

            var pr = await PixelSvc.OpenTaskPullRequestAsync(_selectedTask.Id);
            if (!pr.Success)
            {
                _bannerIsError = true;
                _bannerMessage = $"Branch '{_selectedTask.TargetBranch}' was pushed, but the platform could not open its pull request: {pr.Error}";
                return;
            }

            _selectedTask.PullRequestUrl = pr.Url;
            _selectedTask.Progress = 100;
            _selectedTask.Status = "completed";
            await PixelSvc.UpdateGitTaskAsync(_selectedTask.Id, new UpdateGitTaskRequest
            {
                Status = "completed",
                Progress = 100,
                PullRequestUrl = pr.Url
            });
            await LoadProjectDispatchDataAsync(_selectedTask.ProjectId);

            _bannerIsError = false;
            _bannerMessage = $"Task '{_selectedTask.Title}' verified, pushed, and opened as PR #{pr.Number}. {summary}";
        }
        catch (Exception ex)
        {
            _bannerIsError = true;
            _bannerMessage = $"Verification error: {ex.Message}";
        }
        finally
        {
            _isVerifyingTask = false;
            StateHasChanged();
        }
    }

    private static string GateCss(string status) =>
        status.StartsWith("passed") ? "pass" : status.StartsWith("failed") ? "fail" : "neutral";

    private static string GateText(string status, string never = "Not verified") =>
        string.IsNullOrEmpty(status) ? never : status;

    private (string Label, string Css) GetLocalFileState(string relativePath)
    {
        if (_receiverGitStatus == null || !_receiverGitStatus.IsRepo)
            return ("Tracked", "state-clean");

        var match = _receiverGitStatus.Files.FirstOrDefault(f =>
            GitTaskScopeService.PathsMatch(f.Path, relativePath));
        if (match == null)
            return ("Clean", "state-clean");

        return match.State switch
        {
            "M" => ("Modified", "state-mod"),
            "A" or "??" => ("Added", "state-add"),
            "D" => ("Deleted", "state-del"),
            _ => (match.State, "state-mod")
        };
    }

