@page "/ide"
@using System
@using System.Collections.Generic
@using System.IO
@using System.Linq
@using Microsoft.JSInterop
@using Syncro.Desktop.Services
@using Syncro.Desktop.Services.Ide
@using Syncro.Desktop.Services.Ide.Models
@using Syncro.Desktop.Services.AgentCli.Models
@using Syncro.Desktop.SyncroUI.Components.Layout
@using Syncro.Desktop.SyncroUI.Components.Primitives
@inject IdeWorkspaceState State
@inject IdeLaunchContext LaunchCtx
@inject ProjectService ProjService
@inject FileService FileSvc
@inject NavigationManager Nav
@inject Syncro.Desktop.Services.Ide.IdeWindowService IdeWin
@inject Syncro.Desktop.Services.Ide.Engines.IEditorEngine Editor
@inject Syncro.Desktop.Services.Ide.Engines.ITerminalEngine Terminal
@inject Syncro.Desktop.Services.Ide.Engines.IRoslynLanguageService Roslyn
@inject Syncro.Desktop.Services.AgentCli.Nlp.TaskRouter Router
@inject Syncro.Desktop.Services.AgentCli.Loop.TaskStore Tasks
@inject Syncro.Desktop.Services.AgentCli.Loop.TaskLoopEngine Loop
@inject IJSRuntime JS
@inject Syncro.Desktop.Services.Ide.Host.IdeHostResolver Hosts
@inject Syncro.Desktop.Services.Ide.Host.IdeHostOptions HostOpts
@using Syncro.Desktop.Services.Ide.Host
@inject Syncro.Desktop.Services.Workspace.IWorkspaceOrchestrator Orchestrator
@inject Syncro.Desktop.Services.Workspace.Diagnostics.IProblemsHub Problems
@inject Syncro.Desktop.Services.Connector.Scan.MultiProjectScanService MultiScanner
@using Syncro.Desktop.Services.Workspace.Diagnostics
@using Syncro.Desktop.Services.Connector.Scan
@using Syncro.Desktop.Services.Connector.ProjectDomain
@implements IDisposable

<div class="ide-root">
    <!-- Title bar with Dual-Mode Switcher (Editor | Agent Mission Control | Universe Map) -->
    <SuiTitleBar Title="@(State.ActiveTab is { } t ? System.IO.Path.GetFileName(t.FilePath) : State.Current?.Name ?? "Multi-Project Workspace")">
        <CenterContent>
            <div class="ide-mode-switcher">
                <button class="ide-mode-btn @(_ideMode == "editor" ? "active" : "")" @onclick='() => SwitchIdeMode("editor")'>
                    <i class="bi bi-code-square"></i>
                    <span>IDE Editor</span>
                </button>
                <button class="ide-mode-btn @(_ideMode == "agent" ? "active" : "")" @onclick='() => SwitchIdeMode("agent")'>
                    <i class="bi bi-stars"></i>
                    <span>Agent Mission Control</span>
                    @if (_scanReport is { Missing: > 0 })
                    {
                        <span class="ide-mode-pill warn">@_scanReport.Missing</span>
                    }
                </button>
                <button class="ide-mode-btn @(_ideMode == "universe" ? "active" : "")" @onclick='() => SwitchIdeMode("universe")'>
                    <i class="bi bi-diagram-3"></i>
                    <span>Universe Map</span>
                    @if (_scanReport is { ProjectCount: > 0 })
                    {
                        <span class="ide-mode-pill ok">@_scanReport.ProjectCount</span>
                    }
                </button>
            </div>
        </CenterContent>
        <RightContent>
            <div class="ide-title-actions">
                @if (_scanReport != null)
                {
                    <span class="ide-contract-pill @(_scanReport.Missing > 0 ? "broken" : "ok")"
                          title="Zero-GPU AST Contract Status"
                          @onclick='() => SwitchIdeMode("universe")'>
                        <i class="bi @(_scanReport.Missing > 0 ? "bi-exclamation-Octagon-fill" : "bi-shield-check")"></i>
                        @_scanReport.Matched Matched · @_scanReport.Missing Broken
                    </span>
                }
                <button class="ide-top-btn" title="Open Workspace Folder…" @onclick="PickFolderAsync">
                    <i class="bi bi-folder2-open"></i> Open
                </button>
                <button class="ide-top-btn" title="Run Multi-Project AST Scan (Zero-GPU)" @onclick="TriggerMultiProjectScanAsync" disabled="@_scanningUniverse">
                    <i class="bi @(_scanningUniverse ? "bi-arrow-repeat" : "bi-radar")"></i> @(_scanningUniverse ? "Scanning…" : "AST Scan")
                </button>
            </div>
        </RightContent>
    </SuiTitleBar>

    <div class="ide-body">
        <!-- Activity bar -->
        <SuiActivityBar 
            TopItems="_topItems" 
            BottomItems="_bottomItems" 
            ActiveId="@_activeActivityId"
            ActiveIdChanged="OnActivityClick" />

        <!-- 1. EDITOR MODE (GoldenLayout + Code-OSS / Monaco + Right Agent Dock) -->
        <div id="ide-layout-container" class="ide-workbench" style="display:@(_ideMode == "editor" ? "block" : "none");"></div>

        <!-- 2. AGENT MISSION CONTROL MODE (Antigravity 2.0 / Claude Code / Cursor Autonomous Workbench) -->
        @if (_ideMode == "agent")
        {
            <div class="ide-workbench">
                <AgentMissionControl WorkspaceRoot="@(State.Current?.RootPath)"
                                     ScanReport="@_scanReport"
                                     ScanReportChanged="OnScanReportUpdated"
                                     OnPickFolder="PickFolderAsync"
                                     OnOpenProjectInEditor="OpenProjectInEditorModeAsync" />
            </div>
        }

        <!-- 3. UNIVERSE GRAPH MODE (Interactive Multi-Project Contract & Data Layer Inspector) -->
        @if (_ideMode == "universe")
        {
            <div class="ide-workbench ide-universe-canvas">
                <div class="uv-header">
                    <div>
                        <div class="uv-title"><i class="bi bi-diagram-3-fill" style="color:var(--accent);"></i> Multi-Project Contract &amp; Auth Topology</div>
                        <div class="uv-sub">Zero-GPU deterministic AST graph across all discovered projects in <code>@(State.Current?.RootPath ?? "workspace")</code></div>
                    </div>
                    <div style="display:flex; gap:8px;">
                        <button class="ghost-btn" style="margin:0;" @onclick="TriggerMultiProjectScanAsync" disabled="@_scanningUniverse">
                            <i class="bi bi-radar"></i> @(_scanningUniverse ? "Scanning…" : "Rescan All Projects")
                        </button>
                        <button class="ghost-btn" style="margin:0;" @onclick='() => SwitchIdeMode("agent")'>
                            <i class="bi bi-magic"></i> Open in Agent Mission Control →
                        </button>
                    </div>
                </div>

                @if (_scanReport == null || _scanReport.Projects.Count == 0)
                {
                    <div class="muted pad">
                        No multi-project scan report loaded yet. Open a root folder containing your projects (Web, Flutter, MAUI, Rust, Go, C++ Crow, etc.) and click <b>AST Scan</b>.
                    </div>
                }
                else
                {
                    <div class="uv-grid">
                        @foreach (var p in _scanReport.Projects)
                        {
                            <div class="uv-proj-card">
                                <div class="uv-proj-head">
                                    <span class="uv-dot" style="background:@DomainDetector.GetColor(p.Domain)"></span>
                                    <b>@p.Name</b>
                                    <span class="uv-badge">@p.Stack · @p.Role</span>
                                </div>
                                <div class="uv-proj-stats">
                                    <span><b>@p.Routes</b> Routes</span>
                                    <span><b>@p.Calls</b> Outbound Calls</span>
                                    <span><b>@p.Data.Models.Count</b> Models / DTOs</span>
                                </div>
                                <div class="uv-proj-foot">
                                    <button class="mc-link-btn" @onclick="() => OpenProjectInEditorModeAsync(p.Path)">Open in Editor →</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="uv-table-wrap">
                        <div class="uv-sec-lbl">CROSS-PROJECT ENDPOINT CONNECTIONS &amp; BREAKAGES (@_scanReport.Connections.Count)</div>
                        <table class="uv-table">
                            <thead>
                                <tr>
                                    <th>Consumer Project</th>
                                    <th>Method</th>
                                    <th>Client Call Path</th>
                                    <th>Producer Project</th>
                                    <th>Matched Route</th>
                                    <th>Contract Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var edge in _scanReport.Connections)
                                {
                                    <tr>
                                        <td><b>@edge.FromProject</b></td>
                                        <td><code>@edge.Method</code></td>
                                        <td><code>@edge.CallPath</code></td>
                                        <td>@(edge.ToProject ?? "—")</td>
                                        <td><code>@(edge.RoutePath ?? "—")</code></td>
                                        <td>
                                            <span class="uv-state @edge.State.ToLowerInvariant()">@edge.State</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ════════════════ Hidden portals (JS moves them into panels) ════════════════ -->

    <!-- CODE-OSS EDITOR — served by the IIdeHost abstraction (real VS Code OSS via serve-web) -->
    <div id="blazor-codeoss-portal" class="portal" style="display:none; padding:0; overflow:hidden; height:100%;">
        @if (!string.IsNullOrEmpty(_codeOssUrl))
        {
            @* @key forces a fresh element when the folder changes, so the iframe actually navigates
               instead of Blazor patching src on a live frame and the old workspace lingering. *@
            <iframe @key="_codeOssUrl" src="@_codeOssUrl" style="width:100%; height:100%; border:none; background:transparent;"></iframe>
        }
        else
        {
            <div class="muted pad" style="padding:18px; max-width:640px;">
                <div style="font-weight:600; margin-bottom:6px;">VS Code OSS editor</div>
                <div style="margin-bottom:10px;">@(_codeOssStatus ?? "Not started.")</div>
                @if (!string.IsNullOrEmpty(_codeOssRemedy))
                {
                    <pre style="white-space:pre-wrap; background:rgba(127,127,127,.12); padding:10px; border-radius:6px; font-size:12px;">@_codeOssRemedy</pre>
                }
                <div style="display:flex; gap:8px; margin-top:10px;">
                    <button class="ghost-btn" @onclick="StartCodeOssAsync" disabled="@_codeOssBusy">@(_codeOssBusy ? "Starting…" : "Start / retry")</button>
                    <button class="ghost-btn" @onclick="ToggleDefaultEditor">
                        @(HostOpts.Kind == IdeHostKind.CodeOss ? "✓ Default editor: VS Code OSS" : "Make default editor")
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- EXPLORER (Multi-Project Aware) -->
    <div id="blazor-explorer-portal" class="portal" style="display:none;">
        <SuiPanel Title="EXPLORER" SubTitle="@(State.Current?.Name)">
            <HeaderRightContent>
                <button class="ghost-btn" style="margin:0; padding:2px 7px;" title="Rescan Multi-Project Ecosystem" @onclick="TriggerMultiProjectScanAsync">
                    <i class="bi bi-radar"></i>
                </button>
                <button class="ghost-btn" style="margin:0; padding:2px 7px;" title="Open Folder…" @onclick="PickFolderAsync">
                    <i class="bi bi-folder2-open"></i>
                </button>
            </HeaderRightContent>
            <ChildContent>
                @if (State.Current == null)
                {
                    <div class="muted pad">
                        No folder opened.<br />
                        <button class="ghost-btn" @onclick="PickFolderAsync">Open Folder…</button>
                        <button class="ghost-btn" @onclick="FocusWelcome">Recent projects →</button>
                    </div>
                }
                else
                {
                    @if (_scanReport != null && _scanReport.Projects.Count > 1)
                    {
                        <div class="mp-strip">
                            <div class="mp-strip-hdr">ECOSYSTEM PROJECTS (@_scanReport.Projects.Count)</div>
                            @foreach (var sp in _scanReport.Projects)
                            {
                                <div class="mp-chip" @onclick="() => OpenWorkspace(sp.Path)" title="@sp.Path">
                                    <span class="mp-dot" style="background:@DomainDetector.GetColor(sp.Domain)"></span>
                                    <span class="mp-name">@sp.Name</span>
                                    <span class="mp-meta">@sp.Stack</span>
                                </div>
                            }
                        </div>
                    }
                    <FileTree RootPath="@State.Current.RootPath" OnOpenFile="OpenFile" />
                }
            </ChildContent>
        </SuiPanel>
    </div>

    <!-- WELCOME -->
    <div id="blazor-welcome-portal" class="portal welcome" style="display:none;">
        <div class="welcome-scroll">
            <div class="welcome-cols">
                <div class="welcome-col">
                    <div class="welcome-h">Start</div>
                    <button class="start-link" @onclick="FocusExplorerOrAnalyze"><i class="bi bi-folder-plus"></i> New Project…</button>
                    <button class="start-link" @onclick="PickFolderAsync"><i class="bi bi-folder2-open"></i> Open Folder…</button>
                    <button class="start-link" @onclick="AnalyzeCurrent"><i class="bi bi-bar-chart-line-fill"></i> Analyze Project…</button>
                    <button class="start-link" @onclick='() => Focus("blazor-ai-portal")'><i class="bi bi-robot"></i> Ask the Agent…</button>
                </div>
                <div class="welcome-col">
                    <div class="welcome-h">Recent</div>
                    @if (_projects.Count == 0)
                    {
                        <div class="start-empty">No recent projects.</div>
                    }
                    else
                    {
                        @foreach (var p in _projects.Take(8))
                        {
                            <button class="recent-link" @onclick="() => OpenWorkspace(p.Path)">
                                <span class="recent-name">@p.Name</span>
                                <span class="recent-path">@p.Path</span>
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- TERMINAL -->
    <div id="blazor-terminal-portal" class="portal" style="display:none;">
        <div id="xterm-mount" style="flex:1; min-height:0; padding:6px 8px;"></div>
    </div>

    <!-- PROBLEMS — unified hub: Roslyn/LSP + security + contract drift + build + agent -->
    <div id="blazor-problems-portal" class="portal" style="display:none;">
        <SuiPanel Title="PROBLEMS" SubTitle="@ProblemsSubTitle">
            @{
                var all = Problems.All;
            }
            @if (all.Count == 0)
            {
                <div class="muted pad"><i class="bi bi-check-circle" style="color:#10b981"></i> No problems detected in the workspace.</div>
            }
            else
            {
                <div class="list-body">
                    @foreach (var pr in all)
                    {
                        <div class="prob-row">
                            <i class="bi @SeverityIcon(pr.Severity)" style="color:@SeverityColor(pr.Severity)"></i>
                            <span class="prob-src">@pr.SourceTag</span>
                            <span class="prob-msg">@pr.Message</span>
                            @if (!string.IsNullOrEmpty(pr.Location))
                            {
                                <span class="prob-loc">@pr.Location</span>
                            }
                        </div>
                    }
                </div>
            }
        </SuiPanel>
    </div>

    <!-- OUTPUT -->
    <div id="blazor-output-portal" class="portal" style="display:none;">
        <SuiPanel Title="OUTPUT" SubTitle="Syncro">
            <div class="output-body">
                @foreach (var line in _output)
                {
                    <div class="out-line">@line</div>
                }
            </div>
        </SuiPanel>
    </div>

    <!-- AI AGENT -->
    <div id="blazor-ai-portal" class="portal" style="display:none;">
        <SuiPanel Title="AI AGENT" Icon="bi bi-robot">
            <HeaderRightContent>
                <span class="ai-dot"></span>
            </HeaderRightContent>
            <ChildContent>
                <div class="ai-messages">
                    @foreach (var m in _aiMessages)
                    {
                        <div class="ai-msg @m.Role">
                            <div class="ai-who">@(m.Role == "user" ? "You" : "Syncro Agent")</div>
                            <div class="ai-text">@m.Text</div>
                        </div>
                    }
                </div>
                <div class="ai-composer">
                    <textarea class="ai-input" rows="2" placeholder="Ask the agent to scaffold, fix, analyze…"
                              @bind="_aiInput" @bind:event="oninput" @onkeydown="AiKeyDown" disabled="@_aiBusy"></textarea>
                    <button class="ai-send" @onclick="SendAi" disabled="@(string.IsNullOrWhiteSpace(_aiInput) || _aiBusy)">
                        <i class="bi @(_aiBusy ? "bi-hourglass-split" : "bi-send-fill")"></i>
                    </button>
                </div>
            </ChildContent>
        </SuiPanel>
    </div>

    <!-- HINDSIGHT -->
    <div id="blazor-hindsight-portal" class="portal" style="display:none;">
        <SuiPanel Title="HINDSIGHT" SubTitle="memory">
            <div class="hind-body">
                <div class="hind-item"><div class="hind-dot ok"></div><div><b>RAG memory online</b><div class="muted2">Past fixes &amp; root-causes are matched against new errors.</div></div></div>
                <div class="hind-item"><div class="hind-dot"></div><div><b>AST index</b><div class="muted2">Symbols, imports &amp; the dependency graph feed the editor.</div></div></div>
                <div class="hind-item"><div class="hind-dot"></div><div><b>Timeline</b><div class="muted2">Edit, patch &amp; revert history for the workspace.</div></div></div>
            </div>
        </SuiPanel>
    </div>

    <!-- SETTINGS -->
    <div id="blazor-settings-portal" class="portal" style="display:none;">
        <SettingsPanel />
    </div>

    <!-- Status bar -->
    <SuiStatusBar 
        HasWorkspace="State.Current != null"
        WorkspaceName="@(State.Current?.Name ?? "")"
        Errors="Problems.ErrorCount"
        HasActiveFile="State.ActiveTab != null"
        Line="_ln"
        Column="_col"
        Language="@(State.ActiveTab?.Language ?? "plaintext")"
        OnProblemsClick='() => Focus("blazor-problems-portal")' />
</div>

<style>
    /* Neutral VS Code-grade theme, driven by Syncro.UI tokens (wwwroot/css/tokens.css). Flat — no gradients/glows. */
    .ide-root { display:flex; flex-direction:column; height:100vh; width:100%; background:var(--bg-editor); color:var(--text);
        font-family:var(--font-ui); font-size:var(--fs-ui); overflow:hidden; }

    /* Body */
    .ide-body { flex:1; display:flex; min-height:0; }
    .ide-workbench { flex:1; position:relative; overflow:hidden; min-width:0; }

    /* Shared portal chrome */
    .portal { display:flex; flex-direction:column; background:var(--bg-side); height:100%; }
    .muted { color:var(--text-muted); font-size:12px; line-height:1.6; }
    .muted2 { color:var(--text-faint); font-size:11px; line-height:1.5; margin-top:2px; }
    .pad { padding:14px; }
    .ghost-btn { margin-top:10px; background:transparent; color:var(--accent); border:1px solid var(--border-soft);
        padding:5px 11px; border-radius:var(--radius); cursor:pointer; font-size:12px; }
    .ghost-btn:hover { background:var(--hover); }

    /* Welcome — quiet Start/Recent (no hero, no gradient) */
    .welcome { background:var(--bg-editor); }
    .welcome-scroll { flex:1; overflow-y:auto; padding:48px 56px; }
    .welcome-cols { display:flex; gap:64px; max-width:820px; }
    .welcome-col { flex:1; min-width:0; }
    .welcome-h { font-size:14px; color:var(--text); font-weight:600; margin-bottom:14px; }
    .start-link, .recent-link { display:flex; width:100%; text-align:left; background:transparent; border:0;
        color:var(--accent); cursor:pointer; padding:5px 0; font-size:13px; font-family:inherit; align-items:center; gap:8px; }
    .start-link:hover, .recent-link:hover { color:var(--accent-hover); }
    .start-link .bi { color:var(--text-muted); font-size:14px; }
    .recent-link { flex-direction:column; align-items:flex-start; gap:1px; }
    .recent-name { color:var(--accent); font-size:13px; }
    .recent-path { color:var(--text-faint); font-size:11px; font-family:var(--font-mono);
        overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:100%; }
    .start-empty { color:var(--text-muted); font-size:12px; }
    kbd { background:var(--bg-input); border:1px solid var(--border-soft); border-radius:3px; padding:1px 5px;
        font-size:11px; font-family:var(--font-mono); color:var(--text); }

    /* Problems / Output */
    .list-body, .output-body, .hind-body, .ai-messages { flex:1; overflow-y:auto; padding:8px 10px; }
    .prob-row { display:flex; gap:8px; align-items:center; padding:5px 8px; font-size:12px; color:var(--text); border-radius:var(--radius); }
    .prob-row:hover { background:var(--hover); }
    .prob-src { font-size:10px; letter-spacing:.04em; text-transform:uppercase; color:var(--text-faint);
        border:1px solid var(--border-soft); border-radius:3px; padding:0 5px; flex:none; }
    .prob-msg { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .prob-loc { font-family:var(--font-mono); font-size:11px; color:var(--text-faint); flex:none; }
    .output-body { font-family:var(--font-mono); font-size:11.5px; color:var(--text-muted); line-height:1.7; }
    .out-line { white-space:pre-wrap; word-break:break-all; }
    .out-line:before { content:"›"; color:var(--text-faint); margin-right:8px; }

    /* AI panel */
    .ai-dot { width:8px; height:8px; border-radius:50%; background:var(--ok); }
    .ai-messages { display:flex; flex-direction:column; gap:10px; }
    .ai-msg { border-radius:var(--radius-lg); padding:9px 11px; font-size:12.5px; line-height:1.5; border:1px solid var(--border); }
    .ai-msg.assistant { background:var(--hover); }
    .ai-msg.user { background:transparent; }
    .ai-who { font-size:10px; letter-spacing:.06em; text-transform:uppercase; color:var(--text-muted); margin-bottom:4px; }
    .ai-msg.assistant .ai-who { color:var(--accent); }
    .ai-text { color:var(--text); white-space:pre-wrap; }
    .ai-composer { border-top:1px solid var(--border); padding:8px; display:flex; gap:8px; align-items:flex-end; }
    .ai-input { flex:1; resize:none; background:var(--bg-input); border:1px solid var(--border-soft); border-radius:var(--radius); color:var(--text);
        font-family:inherit; font-size:12.5px; padding:8px 10px; outline:none; }
    .ai-input:focus { border-color:var(--accent); }
    .ai-send { width:36px; height:36px; border:0; border-radius:var(--radius); background:var(--accent);
        color:var(--on-accent); cursor:pointer; font-size:14px; }
    .ai-send:disabled { opacity:.35; cursor:default; }

    /* Hindsight */
    .hind-item { display:flex; gap:10px; align-items:flex-start; padding:10px 6px; border-bottom:1px solid var(--border); }
    .hind-item b { font-size:12.5px; color:var(--text); }
    .hind-dot { width:9px; height:9px; border-radius:50%; background:var(--text-faint); margin-top:4px; flex:none; }
    .hind-dot.ok { background:var(--ok); }

    /* GoldenLayout theme overrides */
    .lm_header { background:var(--bg-side) !important; height:30px !important; }
    .lm_tab { background:var(--bg-tab-inactive) !important; color:var(--text-muted) !important; border:none !important; margin-right:1px !important;
        padding:0 14px !important; height:30px !important; line-height:30px !important; display:flex !important; align-items:center !important; }
    .lm_tab.lm_active { background:var(--bg-tab-active) !important; color:var(--text-strong) !important; box-shadow:inset 0 -1px 0 var(--accent) !important; }
    .lm_splitter { background:var(--border) !important; }
    .lm_splitter:hover { background:var(--accent) !important; }
    .lm_content { background:var(--bg-editor) !important; border:none !important; }
    .lm_controls { right:8px !important; }
    .lm_title { color:inherit !important; font-size:12px !important; font-family:var(--font-ui) !important; }
    .lm_close_tab { width:12px !important; height:12px !important; background-image:none !important; opacity:.5; }
    .lm_close_tab:before { content:"×"; font-size:16px; color:var(--text); line-height:12px; }
    .lm_close_tab:hover { opacity:1; }
    .lm_maximise { opacity:.5; }
    .lm_maximise:hover { opacity:1; }

    /* File tree */
    .ftn-row { display:flex; align-items:center; gap:6px; padding:3px 10px; cursor:pointer; white-space:nowrap; font-size:13px; color:var(--text); }
    .ftn-row:hover { background:var(--hover); }
    .ftn-caret { width:12px; display:inline-block; color:var(--text-muted); text-align:center; flex:none; }
