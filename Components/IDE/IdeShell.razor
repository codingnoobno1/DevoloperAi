@code {
    [Parameter] public string? Token { get; set; }
    private DotNetObjectReference<IdeShell>? _objRef;

    private List<ProjectModel> _projects = new();
    private bool _layoutReady;
    private int _ln = 1, _col = 1;
    private string _aiInput = "";
    private readonly List<(string Role, string Text)> _aiMessages = new();
    private readonly List<Syncro.Desktop.Services.Ide.Engines.DiagnosticDto> _problems = new();
    private readonly List<string> _output = new();

    private List<SuiActivityBar.ActivityItem> _topItems = new();
    private List<SuiActivityBar.ActivityItem> _bottomItems = new();
    private string _activeActivityId = "explorer";

    // Dual-Mode IDE state ("editor" | "agent" | "universe")
    private string _ideMode = "editor";
    private MultiProjectScanReport? _scanReport;
    private bool _scanningUniverse;

    // code-oss host state (bound to the code-oss portal)
    private string? _codeOssUrl;
    private string? _codeOssStatus;
    private string? _codeOssRemedy;
    private bool _codeOssBusy;

    private async Task SwitchIdeMode(string mode)
    {
        _ideMode = mode;
        await InvokeAsync(StateHasChanged);
        if (mode == "editor")
        {
            try { await JS.InvokeVoidAsync("window.SyncroIde.resizeLayout"); } catch { }
        }
        else if ((mode == "agent" || mode == "universe") && _scanReport == null && !string.IsNullOrWhiteSpace(State.Current?.RootPath))
        {
            await TriggerMultiProjectScanAsync();
        }
    }

    private async Task TriggerMultiProjectScanAsync()
    {
        var root = State.Current?.RootPath;
        if (string.IsNullOrWhiteSpace(root) || _scanningUniverse) return;
        _scanningUniverse = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _scanReport = await MultiScanner.ScanAsync(root);
            Log($"Multi-project AST scan complete: {_scanReport.ProjectCount} project(s), {_scanReport.Matched} matched, {_scanReport.Missing} broken.");
        }
        catch (Exception ex)
        {
            Log($"Multi-project scan failed: {ex.Message}");
        }
        finally
        {
            _scanningUniverse = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnScanReportUpdated(MultiProjectScanReport report)
    {
        _scanReport = report;
        StateHasChanged();
    }

    private async Task OpenProjectInEditorModeAsync(string projectPath)
    {
        await OpenWorkspace(projectPath);
        await SwitchIdeMode("editor");
    }

    private async Task StartCodeOssAsync()
    {
        if (_codeOssBusy) return;
        _codeOssBusy = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var session = await Hosts.Get(IdeHostKind.CodeOss).StartAsync(State.Current?.RootPath);
            _codeOssUrl = session.Mode == IdeHostMode.WebUrl ? session.Url : null;
            _codeOssStatus = session.Status;
            _codeOssRemedy = session.Remedy;

            // Code-OSS is the primary editor (idearchitecture.md), but never strand the user: if it
            // can't start (checkout missing / not compiled), fall back to the built-in Monaco viewer.
            if (session.Mode == IdeHostMode.Unavailable)
            {
                HostOpts.Kind = IdeHostKind.Monaco;
                _codeOssStatus = $"{session.Status} Using the built-in editor for now — retry once VS Code OSS is built.";
                Log($"VS Code OSS unavailable: {session.Status} Falling back to built-in editor.");
            }
        }
        catch (Exception ex)
        {
            _codeOssUrl = null;
            _codeOssStatus = $"Could not start VS Code OSS: {ex.Message}";
        }
        finally
        {
            _codeOssBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleDefaultEditor()
    {
        HostOpts.Kind = HostOpts.Kind == IdeHostKind.CodeOss ? IdeHostKind.Monaco : IdeHostKind.CodeOss;
        if (HostOpts.Kind == IdeHostKind.CodeOss)
            await StartCodeOssAsync();
        else
            await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        Problems.Changed += OnProblemsChanged;
        Terminal.OnOutputDataReceived += OnTerminalDataReceived;
        _projects = ProjService.GetProjects();

        // Claim the shared code-oss host for this window; released in Dispose.
        Hosts.Get(IdeHostKind.CodeOss).Acquire();

        _topItems = new List<SuiActivityBar.ActivityItem>
        {
            new() { Id = "explorer", Title = "Explorer", Icon = "bi bi-files" },
            new() { Id = "editor", Title = "Editor Mode", Icon = "bi bi-code-slash" },
            new() { Id = "mission", Title = "Agent Mission Control", Icon = "bi bi-stars" },
            new() { Id = "universe", Title = "Multi-Project Universe Graph", Icon = "bi bi-diagram-3" },
            new() { Id = "git", Title = "Source Control", Icon = "bi bi-git" },
            new() { Id = "hindsight", Title = "Hindsight", Icon = "bi bi-eye-fill" },
            new() { Id = "ai", Title = "AI Quick Dock", Icon = "bi bi-robot" },
            new() { Id = "terminal", Title = "Terminal", Icon = "bi bi-terminal-fill" }
        };

        _bottomItems = new List<SuiActivityBar.ActivityItem>
        {
            new() { Id = "analyze", Title = "Analyze project", Icon = "bi bi-bar-chart-line-fill" },
            new() { Id = "settings", Title = "Settings", Icon = "bi bi-gear-fill" }
        };

        string? path = null;
        if (Token != null && LaunchCtx.TryClaim(Token, out var req))
            path = req.WorkspacePath;

        if (!string.IsNullOrEmpty(path))
        {
            await State.OpenWorkspaceAsync(path);
            Orchestrator.Open(path);
            _ = TriggerMultiProjectScanAsync();
        }

        // If VS Code OSS is the chosen editor, boot it in the background (heavy port-wait — don't block init).
        if (HostOpts.Kind == IdeHostKind.CodeOss)
            _ = StartCodeOssAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _objRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("window.SyncroIde.initLayout", "ide-layout-container", _objRef);
    }

    [JSInvokable]
    public async Task OnLayoutReadyJS()
    {
        _layoutReady = true;
        await JS.InvokeVoidAsync("window.SyncroIde.mountTerminal", "xterm-mount");
        await Terminal.StartAsync(State.Current?.RootPath ?? "");
        _ = Roslyn.LoadWorkspaceAsync(State.Current?.RootPath ?? "");

        // Re-open any tabs restored from the previous session
        foreach (var tab in State.Tabs)
        {
            var content = await FileSvc.ReadAsync(tab.FilePath);
            await Editor.OpenAsync(tab.Uri, content, tab.Language, Path.GetFileName(tab.FilePath));
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenWorkspace(string path)
    {
        await State.OpenWorkspaceAsync(path);
        Orchestrator.Open(path);   // fires WorkspaceOpened → FS watcher + contract reverify subscribe
        Log($"Opened workspace: {path}");
        _ = TriggerMultiProjectScanAsync();
        await Terminal.StartAsync(path);
        _ = Roslyn.LoadWorkspaceAsync(path);

        // Re-point the editor at the new folder. The iframe URL carries ?folder=…, so without this
        // the workspace opens everywhere EXCEPT the editor — which is the whole point of opening it.
        // StartAsync reuses the running server and just rebuilds the URL, so this is cheap.
        if (HostOpts.Kind == IdeHostKind.CodeOss)
            await StartCodeOssAsync();

        await Focus("blazor-explorer-portal");
        foreach (var tab in State.Tabs)
        {
            var content = await FileSvc.ReadAsync(tab.FilePath);
            await Editor.OpenAsync(tab.Uri, content, tab.Language, Path.GetFileName(tab.FilePath));
        }
    }

    private async Task PickFolderAsync()
    {
        try
        {
            var result = await Microsoft.Maui.ApplicationModel.MainThread.InvokeOnMainThreadAsync(
                () => CommunityToolkit.Maui.Storage.FolderPicker.Default.PickAsync());
                
            if (result.IsSuccessful && result.Folder != null && !string.IsNullOrEmpty(result.Folder.Path))
            {
                var folderPath = result.Folder.Path;
                ProjService.ImportProject(folderPath); // Register in recent projects
                await OpenWorkspace(folderPath);
            }
        }
        catch (Exception ex)
        {
            Log($"Failed to pick folder: {ex.Message}");
        }
    }

    private async Task OpenFile(string filePath)
    {
        var tab = State.OpenFile(filePath);
        var content = await FileSvc.ReadAsync(filePath);
        await Editor.OpenAsync(tab.Uri, content, tab.Language, Path.GetFileName(filePath));
        Log($"Open file: {Path.GetFileName(filePath)}");
    }

    private void AnalyzeCurrent() => IdeWin.OpenAnalysis(State.Current?.RootPath);
    private Task FocusWelcome() => Focus("blazor-welcome-portal");
    private Task FocusExplorerOrAnalyze() => Focus("blazor-explorer-portal");
    private async Task Focus(string portalId)
    {
        try { await JS.InvokeVoidAsync("window.SyncroIde.focusPanel", portalId); } catch { }
    }

    private async Task OnActivityClick(string id)
    {
        _activeActivityId = id;
        switch (id)
        {
            case "mission":
                await SwitchIdeMode("agent");
                break;
            case "universe":
                await SwitchIdeMode("universe");
                break;
            case "explorer":
                await SwitchIdeMode("editor");
                await Focus("blazor-explorer-portal");
                break;
            case "editor":
                await SwitchIdeMode("editor");
                await Focus("blazor-codeoss-portal");
                break;
            case "git":
                await SwitchIdeMode("editor");
                await Focus("blazor-codeoss-portal");
                if (HostOpts.Kind != IdeHostKind.CodeOss)
                    Log("Source control is provided by VS Code OSS — start it from the editor panel.");
                break;
            case "welcome":
                await SwitchIdeMode("editor");
                await Focus("blazor-welcome-portal");
                break;
            case "hindsight":
                await SwitchIdeMode("editor");
                await Focus("blazor-hindsight-portal");
                break;
            case "ai":
                await SwitchIdeMode("editor");
                await Focus("blazor-ai-portal");
                break;
            case "terminal":
                await SwitchIdeMode("editor");
                await Focus("blazor-terminal-portal");
                break;
            case "analyze":
                AnalyzeCurrent();
                break;
            case "settings":
                await SwitchIdeMode("editor");
                await Focus("blazor-settings-portal");
                break;
        }
    }

    private async Task AiKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await SendAi();
    }

    private bool _aiBusy;

    private async Task SendAi()
    {
        var msg = _aiInput.Trim();
        if (string.IsNullOrEmpty(msg) || _aiBusy) return;
        _aiBusy = true;
        _aiMessages.Add(("user", msg));
        _aiInput = "";
        Log($"AI prompt: {msg}");
        await InvokeAsync(StateHasChanged);

        try
        {
            // 1. Route the goal through the Software-Understanding pipeline → a plan.
            var projectPath = State.Current?.RootPath ?? "";
            var plan = await Router.RouteAsync(msg, projectPath);

            var steps = plan.Steps.Count == 0 ? "  • (no steps)" : string.Join("\n", plan.Steps.Select(s => $"  • {s}"));
            _aiMessages.Add(("assistant", $"Intent: {plan.Intent} ({plan.Confidence:P0})\nPlan:\n{steps}"));
            await InvokeAsync(StateHasChanged);

            // 2. Enqueue a task and drive the loop live, streaming each transition.
            var rec = new TaskRecord
            {
                Title = msg,
                ProjectId = State.Current?.Id ?? "ide",
                Intent = MapIntent(plan.Intent)
            };
            await Tasks.EnqueueAsync(rec);

            _aiMessages.Add(("assistant", $"Task {rec.TaskId} enqueued…"));
            int statusIdx = _aiMessages.Count - 1;
            await InvokeAsync(StateHasChanged);

            int guard = 0;
            while (rec.Status != LoopStatus.Done && rec.Status != LoopStatus.NeedsHuman && guard++ < 20)
            {
                rec = await Loop.StepAsync(rec);
                var trail = string.Join(" → ", rec.History.TakeLast(6).Select(h => h.Status.ToString().ToLowerInvariant()));
                _aiMessages[statusIdx] = ("assistant", $"Task {rec.TaskId}\n{trail}");
                await InvokeAsync(StateHasChanged);
            }

            var note = rec.History.LastOrDefault()?.Note ?? rec.NextAction ?? "";
            _aiMessages.Add(("assistant", $"Final: {rec.Status}{(string.IsNullOrEmpty(note) ? "" : $" — {note}")}"));
            Log($"Task {rec.TaskId} → {rec.Status}");
        }
        catch (Exception ex)
        {
            _aiMessages.Add(("assistant", $"Routing error: {ex.Message}"));
        }
        finally
        {
            _aiBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static TaskKind MapIntent(string? intent) => (intent ?? "").ToLowerInvariant() switch
    {
        "generate" => TaskKind.Generate,
        "patch" => TaskKind.LlmFix,
        "analyse" or "analyze" => TaskKind.Analyse,
        "explain" => TaskKind.Show,
        "refactor" => TaskKind.EditCode,
        "test" => TaskKind.RunScript,
        "clone" => TaskKind.Clone,
        "report" => TaskKind.Report,
        _ => TaskKind.Custom
    };

    [JSInvokable]
    public async Task OnTerminalCommandJS(string command)
    {
        Log($"$ {command}");
        await Terminal.WriteAsync(command);
    }

    private void OnTerminalDataReceived(string data)
    {
        // The data has \r\n appended by the engine.
        // But termWrite uses writeln which adds another newline, wait.
        // Let's use termWrite if it uses write or writeln.
        InvokeAsync(() => JS.InvokeVoidAsync("window.SyncroIde.termWrite", data));
    }

    [JSInvokable]
    public void OnCursorJS(int line, int col)
    {
        _ln = line; _col = col;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnTabClosedJS(string uri)
    {
        State.CloseTab(uri);
        Problems.Clear(ProblemSource.Language, uri);   // a closed document has no compiler problems
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnEditorChangedJS(string uri, string newContent)
    {
        State.Buffers[uri] = newContent;
        State.MarkDirty(uri, true);
        _ = Roslyn.UpdateDocumentAsync(uri, newContent);
        _ = DebounceDiagnosticsAsync(uri);
    }

    [JSInvokable]
    public async Task OnEditorSaveJS(string uri, string content)
    {
        var tab = State.Tabs.FirstOrDefault(t => t.Uri == uri);
        if (tab == null) return;
        await FileSvc.WriteAsync(tab.FilePath, content);
        State.Buffers[uri] = content;
        State.MarkDirty(uri, false);
        Log($"Saved: {Path.GetFileName(tab.FilePath)}");
        await InvokeAsync(StateHasChanged);
    }

    private void Log(string line)
    {
        _output.Add(line);
        if (_output.Count > 200) _output.RemoveAt(0);
    }

    private System.Threading.CancellationTokenSource? _diagnosticsCts;
    private async Task DebounceDiagnosticsAsync(string uri)
    {
        _diagnosticsCts?.Cancel();
        _diagnosticsCts = new System.Threading.CancellationTokenSource();
        try
        {
            await Task.Delay(500, _diagnosticsCts.Token);
            var diags = await Roslyn.GetDiagnosticsAsync(uri);
            _problems.Clear();
            _problems.AddRange(diags);

            // Push compiler diagnostics into the unified hub, bucketed per document so other
            // sources (security, contract drift) survive a per-keystroke refresh.
            Problems.Report(ProblemSource.Language, uri, diags.Select(d => new Problem(
                Source: ProblemSource.Language,
                Severity: MapMonacoSeverity(d.Severity),
                Message: d.Message,
                FilePath: State.Tabs.FirstOrDefault(t => t.Uri == uri)?.FilePath ?? uri,
                Line: d.StartLineNumber,
                Column: d.StartColumn,
                Code: d.Id)));

            await JS.InvokeVoidAsync("window.SyncroMonaco.setDiagnostics", uri, diags);
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    [JSInvokable]
    public Task<IEnumerable<Syncro.Desktop.Services.Ide.Engines.CompletionItemDto>> GetCompletionsJS(string uri, int line, int column)
        => Roslyn.GetCompletionsAsync(uri, line, column);

    [JSInvokable]
    public Task<Syncro.Desktop.Services.Ide.Engines.HoverDto?> GetHoverJS(string uri, int line, int column)
        => Roslyn.GetHoverAsync(uri, line, column);

    [JSInvokable]
    public Task<Syncro.Desktop.Services.Ide.Engines.DefinitionDto?> GetDefinitionJS(string uri, int line, int column)
        => Roslyn.GetDefinitionAsync(uri, line, column);

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // ── Problems Hub rendering ────────────────────────────────────────────────
    private string ProblemsSubTitle
    {
        get
        {
            var e = Problems.ErrorCount;
            var w = Problems.WarningCount;
            return e == 0 && w == 0 ? "0" : $"{e} errors, {w} warnings";
        }
    }

    private static string SeverityIcon(ProblemSeverity s) => s switch
    {
        ProblemSeverity.Error => "bi-x-circle-fill",
        ProblemSeverity.Warning => "bi-exclamation-triangle-fill",
        ProblemSeverity.Info => "bi-info-circle-fill",
        _ => "bi-lightbulb"
    };

    private static string SeverityColor(ProblemSeverity s) => s switch
    {
        ProblemSeverity.Error => "#ef4444",
        ProblemSeverity.Warning => "#f59e0b",
        ProblemSeverity.Info => "#3b82f6",
        _ => "var(--text-faint)"
    };

    private void OnProblemsChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Monaco MarkerSeverity (Hint=1, Info=2, Warning=4, Error=8) → unified severity.</summary>
    private static ProblemSeverity MapMonacoSeverity(int monacoSeverity) => monacoSeverity switch
    {
        8 => ProblemSeverity.Error,
        4 => ProblemSeverity.Warning,
        2 => ProblemSeverity.Info,
        _ => ProblemSeverity.Hint
    };

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Problems.Changed -= OnProblemsChanged;
        Terminal.OnOutputDataReceived -= OnTerminalDataReceived;
        _objRef?.Dispose();
        // Release this window's claim — the server stays up for any other open IDE window and
        // shuts down only when the last one closes.
        _ = Hosts.Get(IdeHostKind.CodeOss).ReleaseAsync();
    }
}
