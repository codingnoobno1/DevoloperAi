@code {
    [Parameter] public string? WorkspaceRoot { get; set; }
    [Parameter] public MultiProjectScanReport? ScanReport { get; set; }
    [Parameter] public EventCallback<MultiProjectScanReport> ScanReportChanged { get; set; }
    [Parameter] public EventCallback OnPickFolder { get; set; }
    [Parameter] public EventCallback<string> OnOpenProjectInEditor { get; set; }

    private readonly HashSet<string> _scopedProjects = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<string> _contextTags = new();
    private readonly List<MissionStreamEntry> _entries = new();

    private string _prompt = "";
    private string _executionStyle = "agent";
    private bool _scanning;
    private bool _busy;

    private IEnumerable<CrossEdge> BrokenEdges =>
        ScanReport?.Connections.Where(c => !string.Equals(c.State, "Matched", StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<CrossEdge>();

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(WorkspaceRoot) && ScanReport == null && !_scanning)
        {
            await RunUniverseScanAsync();
        }
    }

    public async Task RunUniverseScanAsync()
    {
        if (string.IsNullOrWhiteSpace(WorkspaceRoot) || _scanning) return;
        _scanning = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var report = await Scanner.ScanAsync(WorkspaceRoot);
            ScanReport = report;
            _scopedProjects.Clear();
            foreach (var p in report.Projects)
                _scopedProjects.Add(p.Name);

            await ScanReportChanged.InvokeAsync(report);
        }
        catch (Exception ex)
        {
            _entries.Add(new MissionStreamEntry
            {
                Role = "tool",
                Icon = "bi-exclamation-triangle-fill",
                Title = "AST Multi-Scan Error",
                Body = ex.Message
            });
        }
        finally
        {
            _scanning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleProjectScope(ProjectScan proj)
    {
        if (!_scopedProjects.Remove(proj.Name))
            _scopedProjects.Add(proj.Name);
    }

    private void AddContextTag(string tag)
    {
        if (string.IsNullOrWhiteSpace(tag)) return;
        var normalized = tag.StartsWith('@') ? tag : "@" + tag;
        if (!_contextTags.Contains(normalized, StringComparer.OrdinalIgnoreCase))
            _contextTags.Add(normalized);
    }

    private void SetPrompt(string text)
    {
        _prompt = text;
    }

    private async Task QueueAllBreaksIntoAgent()
    {
        var breaks = BrokenEdges.Take(10).ToList();
        if (breaks.Count == 0) return;

        var summary = string.Join("\n", breaks.Select(b => $"- {b.FromProject} calls {b.Method} {b.CallPath} -> {b.State} (target: {b.ToProject ?? "none"})"));
        _prompt = $"Resolve these {breaks.Count} cross-project contract/auth breakages detected by the AST scanner:\n{summary}";
        await ExecuteMissionAsync();
    }

    private void QueueSingleBreakIntoAgent(CrossEdge edge)
    {
        AddContextTag("@" + edge.FromProject);
        if (!string.IsNullOrEmpty(edge.ToProject))
            AddContextTag("@" + edge.ToProject);

        _prompt = $"Fix the {edge.State} break where '{edge.FromProject}' calls '{edge.Method} {edge.CallPath}' (expected producer: {edge.ToProject ?? "missing backend route"}). Check route path, method, DTO schema, and Auth headers.";
    }

    private async Task InvokeToolQuick(string toolName)
    {
        var root = WorkspaceRoot ?? "";
        _entries.Add(new MissionStreamEntry
        {
            Role = "tool",
            Icon = "bi-terminal-fill",
            Title = $"MCP Tool: {toolName}",
            Body = $"Executing {toolName} against '{root}'…"
        });
        await InvokeAsync(StateHasChanged);

        var payload = $"{{\"path\":{System.Text.Json.JsonSerializer.Serialize(root)},\"rootPath\":{System.Text.Json.JsonSerializer.Serialize(root)}}}";
        var output = await Mcp.ExecuteToolAsync(toolName, payload);

        _entries[^1].Body = output.Length > 1600 ? output[..1600] + "\n… (truncated)" : output;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnComposerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await ExecuteMissionAsync();
    }

    private async Task ExecuteMissionAsync()
    {
        var goal = _prompt.Trim();
        if (string.IsNullOrEmpty(goal) || _busy) return;

        _busy = true;
        var ctxPrefix = _contextTags.Count > 0 ? $"[Context: {string.Join(", ", _contextTags)}]\n" : "";
        _entries.Add(new MissionStreamEntry
        {
            Role = "user",
            Icon = "bi-person-fill",
            Title = "You",
            Body = ctxPrefix + goal
        });
        _prompt = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            var root = WorkspaceRoot ?? "";

            // Step 1: Always run the zero-GPU NLP TaskRouter to extract intent & structured plan
            var plan = await Router.RouteAsync(goal, root);
            var planEntry = new MissionStreamEntry
            {
                Role = "tool",
                Icon = "bi-diagram-3-fill",
                Title = $"Execution Plan · Intent: {plan.Intent} ({plan.Confidence:P0})",
                Body = $"Scoped Projects: {(_scopedProjects.Count > 0 ? string.Join(", ", _scopedProjects) : "Workspace")}",
                Steps = plan.Steps.Select(s => new MissionStep { Text = s, Done = false }).ToList()
            };
            _entries.Add(planEntry);
            await InvokeAsync(StateHasChanged);

            if (_executionStyle == "deterministic")
            {
                // Zero-GPU deterministic task loop
                var rec = new TaskRecord
                {
                    Title = goal,
                    ProjectId = string.IsNullOrEmpty(root) ? "ide" : Path.GetFileName(root),
                    Intent = TaskKind.Analyse
                };
                await Tasks.EnqueueAsync(rec);

                int guard = 0;
                while (rec.Status != LoopStatus.Done && rec.Status != LoopStatus.NeedsHuman && guard++ < 15)
                {
                    rec = await Loop.StepAsync(rec);
                    for (int i = 0; i < planEntry.Steps.Count; i++)
                        planEntry.Steps[i].Done = true;
                    await InvokeAsync(StateHasChanged);
                }

                var finalNote = rec.History.LastOrDefault()?.Note ?? rec.NextAction ?? "Deterministic task completed.";
                _entries.Add(new MissionStreamEntry
                {
                    Role = "agent",
                    Icon = "bi-check2-all",
                    Title = $"Syncro Deterministic Engine ({rec.Status})",
                    Body = finalNote
                });
            }
            else
            {
                // Full MCP + LLM Agent Loop with Multi-Project Context
                var scanCtx = ScanReport == null
                    ? $"Workspace Root: {root}"
                    : $"Workspace Root: {root}\nDiscovered Projects ({ScanReport.ProjectCount}): " +
                      string.Join(", ", ScanReport.Projects.Select(p => $"{p.Name} ({p.Stack}, {p.Routes} routes, {p.Calls} calls)")) +
                      $"\nMatched Connections: {ScanReport.Matched}, Missing/Broken: {ScanReport.Missing}";

                var sysPrompt =
                    "You are Syncro Agent (Antigravity 2.0 / Claude Code grade multi-project architect). " +
                    "Use registered MCP tools to inspect files, map contracts, and verify changes. " +
                    "Current Multi-Project Universe Context:\n" + scanCtx;

                var response = await Mcp.RunAgentAsync(sysPrompt, ctxPrefix + goal);
                foreach (var s in planEntry.Steps) s.Done = true;

                _entries.Add(new MissionStreamEntry
                {
                    Role = "agent",
                    Icon = "bi-stars",
                    Title = "Syncro Agent Response",
                    Body = response
                });
            }
        }
        catch (Exception ex)
        {
            _entries.Add(new MissionStreamEntry
            {
                Role = "tool",
                Icon = "bi-x-octagon-fill",
                Title = "Execution Error",
                Body = ex.Message
            });
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private sealed class MissionStreamEntry
    {
        public string Role { get; set; } = "agent";
        public string Icon { get; set; } = "bi-robot";
        public string Title { get; set; } = "";
        public string Body { get; set; } = "";
        public string Timestamp { get; set; } = DateTime.Now.ToString("HH:mm:ss");
        public List<MissionStep> Steps { get; set; } = new();
    }

    private sealed class MissionStep
    {
        public string Text { get; set; } = "";
        public bool Done { get; set; }
    }
}
