@using DeveloperAI.BusinessLogic
@inject EnvironmentManager EnvManager

<div>
    <div class="d-flex align-center justify-space-between mb-4 px-2">
        <MudText Typo="Typo.h6" Style="font-weight: 700; font-size: 16px;">Development Environments</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Refresh" 
                   Size="Size.Small" 
                   Color="Color.Primary" 
                   Variant="Variant.Text" 
                   OnClick="RefreshEnvironments"
                   Disabled="@_loading">
            Refresh
        </MudButton>
    </div>

    @if (_loading)
    {
        <div class="d-flex justify-center pa-10">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var env in _environments)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <div class="env-installer-card">
                        <div class="env-card-header">
                            <div class="env-icon-wrapper @(env.IsAvailable ? "available" : "unavailable")">
                                <MudIcon Icon="@GetIconForEnv(env.Name)" Size="Size.Medium" />
                            </div>
                            <MudChip T="string" Color="@(env.IsAvailable ? Color.Success : Color.Error)" 
                                     Size="Size.Small" 
                                     Variant="Variant.Filled" 
                                     Class="env-status-chip">
                                @(env.IsAvailable ? "INSTALLED" : "MISSING")
                            </MudChip>
                        </div>
                        
                        <div class="env-card-body">
                            <h3 class="env-title">@env.Name</h3>
                            <p class="env-version">
                                @(env.IsAvailable ? env.Version : "Not found in system path")
                            </p>
                            @if (env.IsAvailable && !string.IsNullOrEmpty(env.Path))
                            {
                                <MudTooltip Text="@env.Path">
                                    <span class="env-path">@env.Path</span>
                                </MudTooltip>
                            }
                        </div>
                        
                        <div class="env-card-footer">
                            <button class="env-action-btn" @onclick="@(() => RunSetup(env.Name))">
                                @(env.IsAvailable ? "Configure" : "Setup") <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </MudItem>
            }
        </MudGrid>
    }
</div>

<style>
    .env-installer-card {
        background: #FFFFFF;
        border-radius: 16px;
        padding: 20px;
        border: 1px solid rgba(226, 232, 240, 0.8);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .env-installer-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
    }

    .env-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
    }

    .env-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .env-icon-wrapper.available {
        background: rgba(16, 185, 129, 0.1);
        color: #10B981;
    }
    .env-icon-wrapper.unavailable {
        background: rgba(239, 68, 68, 0.1);
        color: #EF4444;
    }
    
    .env-status-chip {
        margin: 0 !important;
        font-weight: 700;
        font-size: 10px;
        height: 22px;
    }

    .env-card-body {
        flex-grow: 1;
        margin-bottom: 20px;
    }

    .env-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 4px 0;
    }

    .env-version {
        font-size: 13px;
        color: var(--text-secondary);
        margin: 0;
    }

    .env-path {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: #94A3B8;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin-top: 8px;
    }

    .env-card-footer {
        display: flex;
        justify-content: flex-end;
    }

    .env-action-btn {
        background: transparent;
        border: none;
        color: #0EA5E9;
        font-weight: 600;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        transition: background 0.2s;
    }
    
    .env-action-btn:hover {
        background: rgba(14, 165, 233, 0.08);
    }
</style>

@code {
    private List<EnvironmentInfo> _environments = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await RefreshEnvironments();
    }

    private async Task RefreshEnvironments()
    {
        _loading = true;
        StateHasChanged();
        _environments = await EnvManager.CheckAllEnvironments();
        _loading = false;
        StateHasChanged();
    }

    private async Task RunSetup(string envName)
    {
        var defaultDir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "SyncroProjects", envName);
        if (!Directory.Exists(defaultDir)) Directory.CreateDirectory(defaultDir);
        
        var script = EnvManager.GetEnvironmentSetupScript(envName, defaultDir);
        await EnvManager.ExecuteSetupScript(script, defaultDir);
    }

    private string GetIconForEnv(string name)
    {
        return name.ToLower() switch
        {
            "python" => Icons.Custom.Brands.GitHub, // Placeholder, MudBlazor doesn't have lang icons by default
            "node.js" => Icons.Material.Filled.Javascript,
            "java" => Icons.Material.Filled.Coffee,
            "c#/.net" => Icons.Material.Filled.Code,
            "go" => Icons.Material.Filled.Bolt,
            "rust" => Icons.Material.Filled.Settings,
            "kotlin" => Icons.Material.Filled.Android,
            "dart" => Icons.Material.Filled.FlutterDash,
            "flutter" => Icons.Material.Filled.FlutterDash,
            _ => Icons.Material.Filled.Terminal
        };
    }
}
