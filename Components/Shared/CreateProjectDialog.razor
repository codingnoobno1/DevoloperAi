@using Syncro.Desktop.Services
@using MudBlazor
@using System.IO
@using Syncro.Desktop.Services.projectgenerator.Registry
@inject ISnackbar Snackbar
@inject DeveloperAI.BusinessLogic.EnvironmentManager EnvManager
@inject Syncro.Desktop.Services.projectgenerator.IProjectCreationService CreationService
@inject StackRegistry StackRegistry

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Create New Project</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            @if (_isCreating)
            {
                <div class="d-flex flex-column align-center py-8">
                    <div class="terminal-animation mb-6">
                        <div class="terminal-header">
                            <div class="dot red"></div>
                            <div class="dot yellow"></div>
                            <div class="dot green"></div>
                            <span class="ml-2">syncro-cli --init @SelectedType</span>
                        </div>
                        <div class="terminal-body" style="max-height: 200px; overflow-y: auto; width: 100%;">
                            @foreach (var log in _generatorLogs)
                            {
                                <code>@log</code>
                            }
                            <code class="cursor">_</code>
                        </div>
                    </div>
                    <MudText Typo="Typo.h6" Class="mb-2">Creating Your Project</MudText>
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    <MudText Typo="Typo.caption" Class="mt-4">This may take a few moments for CLI setup.</MudText>
                </div>
            }
            else if (_step == 1)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-4">Step 1: Select Project Type</MudText>
                <MudGrid Spacing="2">
                    @foreach (var type in _projectTypes)
                    {
                        <MudItem xs="6">
                            <MudPaper Elevation="0" 
                                      Class="@GetCardClass(type.Name)" 
                                      @onclick="() => SelectType(type.Name)">
                                <MudIcon Icon="@type.Icon" Color="@(SelectedType == type.Name ? Color.Primary : Color.Default)" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@type.Name</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">@type.Description</MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
            else if (_step == 2)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-4">Step 2: Configuration (@SelectedType)</MudText>
                <MudTextField T="string" Label="Project Name" @bind-Value="ProjectName" Required="true" RequiredError="Name is required" Variant="Variant.Outlined" Class="mb-4" />
                
                @if (SelectedType == "Mobile App")
                {
                    <MudSelect T="string" Label="Mobile Framework" @bind-Value="_mobileFramework" Variant="Variant.Outlined" Class="mb-4">
                        @foreach (var stack in _mobileStacks)
                        {
                            <MudSelectItem Value="@stack.Id">@stack.Label (@stack.Language)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" Label="Package Name" @bind-Value="_packageName" Placeholder="com.example.app" Required="true" Variant="Variant.Outlined" Class="mb-4" />
                    @if (_mobileFramework == "flutter" && !_isFlutterInstalled)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-2">
                            Flutter not detected. Syncro will help you install it in the next step.
                        </MudAlert>
                    }
                }
                else if (SelectedType == "Group Stack")
                {
                    <MudText Typo="Typo.body2" Class="mb-2 font-weight-bold">Select services to include in the Group Stack:</MudText>
                    <div class="d-flex flex-column gap-2 mb-4 group-stack-list">
                        @foreach (var stack in _groupEligibleStacks)
                        {
                            <MudCheckBox T="bool" 
                                         Value="@IsComponentSelected(stack.Id)" 
                                         ValueChanged="@((b) => ToggleComponent(stack.Id, b))" 
                                         Color="Color.Primary" 
                                         Label="@($"{stack.Label} {stack.Kind} (/{stack.Subfolder})")" />
                        }
                    </div>
                }
                else if (SelectedType == "Python")
                {
                    <MudSelect T="string" Label="Python Framework" @bind-Value="_pythonFramework" Variant="Variant.Outlined" Class="mb-4">
                        @foreach (var stack in _pythonStacks)
                        {
                            <MudSelectItem Value="@stack.Id">@stack.Label (Port: @stack.DefaultPort)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" Label="Description" @bind-Value="Description" Lines="2" Variant="Variant.Outlined" Class="mb-4" />
                }
                else if (SelectedType == "Node.js")
                {
                    <MudSelect T="string" Label="Node.js Framework" @bind-Value="_nodeFramework" Variant="Variant.Outlined" Class="mb-4">
                        @foreach (var stack in _nodeStacks)
                        {
                            <MudSelectItem Value="@stack.Id">@stack.Label (@stack.Language)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" Label="Description" @bind-Value="Description" Lines="2" Variant="Variant.Outlined" Class="mb-4" />
                }
                else if (SelectedType == "API Service")
                {
                    <MudSelect T="string" Label="Backend Framework" @bind-Value="_apiFramework" Variant="Variant.Outlined" Class="mb-4">
                        @foreach (var stack in _apiStacks)
                        {
                            <MudSelectItem Value="@stack.Id">@stack.Label (@stack.Language)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" Label="Description" @bind-Value="Description" Lines="2" Variant="Variant.Outlined" Class="mb-4" />
                }
                else
                {
                    <MudTextField T="string" Label="Description" @bind-Value="Description" Lines="2" Variant="Variant.Outlined" Class="mb-4" />
                }

                <MudCheckBox T="bool" @bind-Value="_useNativeCli" Color="Color.Primary" Label="Use Native CLI Scaffolding (npm, npx, flutter, django-admin if installed)" Class="mb-4" />
            }
            else if (_step == 3)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-4">Step 3: Location & Agent Storage</MudText>
                <MudTextField T="string" Label="Project Path" @bind-Value="ProjectPath" Required="true" RequiredError="Path is required" Variant="Variant.Outlined" Class="mb-4" 
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Folder" OnAdornmentClick="BrowseFolder" />
                
                <MudDivider Class="my-4" />
                <div class="d-flex align-center justify-space-between">
                    <div>
                        <MudText Typo="Typo.body2" Class="font-weight-bold">Sync with Syncro Agent</MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">Allows AI to index your code for better assistance.</MudText>
                    </div>
                    <MudSwitch T="bool" @bind-Value="_syncWithAgent" Color="Color.Primary" />
                </div>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        @if (_step > 1)
        {
            <MudButton OnClick="PrevStep" Variant="Variant.Text" Color="Color.Secondary">Back</MudButton>
        }
        <MudSpacer />
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        @if (_step < 3)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="NextStep" Disabled="!CanGoNext()">Next</MudButton>
        }
        else
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="!_isValid">Create Project</MudButton>
        }
    </DialogActions>
</MudDialog>

<style>
    .type-card {
        padding: 24px;
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        background: linear-gradient(145deg, var(--mud-palette-surface), rgba(255,255,255,0.02));
    }

    .type-card:hover {
        border-color: var(--accent-primary);
        background: linear-gradient(145deg, rgba(99, 102, 241, 0.05), rgba(99, 102, 241, 0.01));
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    .type-card.selected {
        border-color: var(--accent-primary);
        background: rgba(99, 102, 241, 0.08);
        border-width: 2px;
    }

    .group-stack-list {
        max-height: 250px;
        overflow-y: auto;
        padding-right: 8px;
    }

    .terminal-animation {
        width: 100%;
        max-width: 400px;
        background: #0f172a;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }
    .terminal-header {
        background: #1e293b;
        padding: 8px 12px;
        display: flex;
        align-items: center;
        font-family: monospace;
        font-size: 12px;
        color: #94a3b8;
    }
    .dot { width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; }
    .red { background: #ef4444; }
    .yellow { background: #f59e0b; }
    .green { background: #10b981; }
    .terminal-body {
        padding: 16px;
        font-family: 'Cascadia Code', 'Fira Code', monospace;
        font-size: 13px;
        color: #e2e8f0;
        text-align: left;
    }
    .terminal-body code { display: block; margin-bottom: 4px; }
    .cursor {
        display: inline-block;
        width: 8px;
        height: 16px;
        background: #6366f1;
        animation: blink 1s infinite;
    }
    @@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
</style>

@code {
    [CascadingParameter] MudBlazor.IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] IDialogService DialogService { get; set; } = default!;

    private MudForm _form = default!;
    private bool _isValid;
    private int _step = 1;
    private string _packageName = "com.example.app";
    private bool _syncWithAgent = true;
    private bool _isCreating = false;
    private bool _isFlutterInstalled = false;
    private bool _useNativeCli = false;
    private List<string> _generatorLogs = new();
    
    // Dynamic stack lists
    private List<StackArchetype> _pythonStacks = new();
    private List<StackArchetype> _nodeStacks = new();
    private List<StackArchetype> _apiStacks = new();
    private List<StackArchetype> _mobileStacks = new();
    private List<StackArchetype> _groupEligibleStacks = new();
    
    private List<string> _selectedGroupComponents = new();
    private string _pythonFramework = "";
    private string _nodeFramework = "";
    private string _apiFramework = "";
    private string _mobileFramework = "";

    public string ProjectName { get; set; } = "";
    public string SelectedType { get; set; } = "Python";
    public string ProjectPath { get; set; } = "";
    public string Description { get; set; } = "";

    private List<ProjectType> _projectTypes = new()
    {
        new("Python", Icons.Material.Filled.Terminal, "Scripts, Data Science, AI"),
        new("Node.js", Icons.Material.Filled.Code, "Web Apps, Backend, Tooling"),
        new("Mobile App", Icons.Material.Filled.Smartphone, "Native Apps"),
        new("API Service", Icons.Material.Filled.Cloud, "REST, GraphQL, Microservices"),
        new("Group Stack", Icons.Material.Filled.Layers, "Multi-service backend & frontend stack")
    };

    protected override async Task OnInitializedAsync()
    {
        await CheckFlutter();
        ProjectPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "SyncroProjects");
        
        // Load dynamically from registry
        var allStacks = StackRegistry.GetAllStacks();
        
        _pythonStacks = allStacks.Where(s => s.Language == "Python").ToList();
        _nodeStacks = allStacks.Where(s => s.Language == "JavaScript" || s.Language == "TypeScript").ToList();
        _apiStacks = allStacks.Where(s => s.Kind == StackKind.Backend && s.Language != "Python" && s.Language != "JavaScript" && s.Language != "TypeScript").ToList();
        _mobileStacks = allStacks.Where(s => s.Kind == StackKind.Mobile).ToList();
        
        // Group stack allows anything that isn't mobile, including databases
        _groupEligibleStacks = allStacks.Where(s => s.Kind != StackKind.Mobile).ToList();

        // Set defaults
        if (_pythonStacks.Any()) _pythonFramework = _pythonStacks.First().Id;
        if (_nodeStacks.Any()) _nodeFramework = _nodeStacks.First().Id;
        if (_apiStacks.Any()) _apiFramework = _apiStacks.First().Id;
        if (_mobileStacks.Any()) _mobileFramework = _mobileStacks.First().Id;
        
        // Pre-select a default group stack (e.g., nextjs + fastapi)
        var next = allStacks.FirstOrDefault(s => s.Id == "nextjs");
        var api = allStacks.FirstOrDefault(s => s.Id == "fastapi");
        if (next != null) _selectedGroupComponents.Add(next.Id);
        if (api != null) _selectedGroupComponents.Add(api.Id);
    }

    private async Task CheckFlutter()
    {
        var envs = await EnvManager.CheckAllEnvironments();
        _isFlutterInstalled = envs.Any(e => e.Name == "Flutter" && e.IsAvailable);
    }

    private string GetCardClass(string type) => $"type-card {(SelectedType == type ? "selected" : "")}";

    private void SelectType(string type)
    {
        SelectedType = type;
        UpdatePath();
    }

    private void UpdatePath()
    {
        var baseDir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "SyncroProjects");
        ProjectPath = Path.Combine(baseDir, ProjectName);
    }

    private bool CanGoNext()
    {
        if (_step == 1) return !string.IsNullOrEmpty(SelectedType);
        if (_step == 2) return !string.IsNullOrEmpty(ProjectName);
        return true;
    }

    private void NextStep() 
    {
        UpdatePath();
        _step++;
    }
    
    private void PrevStep() => _step--;

    private void Cancel() => MudDialog.Cancel();

    private bool IsComponentSelected(string id)
    {
        return _selectedGroupComponents.Contains(id);
    }

    private void ToggleComponent(string id, bool isSelected)
    {
        if (isSelected)
        {
            if (!_selectedGroupComponents.Contains(id)) _selectedGroupComponents.Add(id);
        }
        else
        {
            _selectedGroupComponents.Remove(id);
        }
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        if (SelectedType == "Mobile App" && _mobileFramework == "flutter" && !_isFlutterInstalled)
        {
            var dialog = await DialogService.ShowAsync<Syncro.Desktop.Components.Dashboard.FlutterSetupView>("Setup Flutter");
            var result = await dialog?.Result;
            if (result == null || result.Canceled) return;
            
            await CheckFlutter();
            if (!_isFlutterInstalled)
            {
                Snackbar.Add("Flutter installation failed or was skipped. Mobile project cannot be initialized.", Severity.Error);
                return;
            }
        }

        _isCreating = true;
        _generatorLogs.Clear();
        StateHasChanged();

        var request = BuildCreationRequest();
        var progress = new Progress<string>(line => InvokeAsync(() => { _generatorLogs.Add(line); StateHasChanged(); }));
        var creationResult = await CreationService.CreateAsync(request, progress);

        _isCreating = false;
        StateHasChanged();

        if (creationResult.Success && creationResult.Project != null)
        {
            Snackbar.Add($"Project '{ProjectName}' initialized with AST memory index!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(creationResult.Project));
        }
        else
        {
            Snackbar.Add(creationResult.Error ?? "Failed to initialize project. Please check the logs.", Severity.Error);
        }
    }

    private Syncro.Desktop.Services.projectgenerator.Models.ProjectCreationRequest BuildCreationRequest()
    {
        if (SelectedType == "Group Stack")
        {
            return new Syncro.Desktop.Services.projectgenerator.Models.ProjectCreationRequest
            {
                Name = ProjectName,
                Path = ProjectPath,
                Kind = Syncro.Desktop.Services.projectgenerator.Models.CreationKind.Group,
                GroupComponents = _selectedGroupComponents,
                UseNativeCli = _useNativeCli,
                SyncWithAgent = _syncWithAgent
            };
        }

        string actualType = SelectedType switch
        {
            "Python" => _pythonFramework,
            "Node.js" => _nodeFramework,
            "Mobile App" => _mobileFramework,
            "API Service" => _apiFramework,
            _ => SelectedType
        };

        return new Syncro.Desktop.Services.projectgenerator.Models.ProjectCreationRequest
        {
            Name = ProjectName,
            Path = ProjectPath,
            Kind = Syncro.Desktop.Services.projectgenerator.Models.CreationKind.Single,
            Type = actualType,
            UseNativeCli = _useNativeCli,
            SyncWithAgent = _syncWithAgent
        };
    }

    private void BrowseFolder()
    {
        UpdatePath();
    }

    public class ProjectType
    {
        public string Name { get; set; }
        public string Icon { get; set; }
        public string Description { get; set; }
        public ProjectType(string n, string i, string d) { Name = n; Icon = i; Description = d; }
    }
}
