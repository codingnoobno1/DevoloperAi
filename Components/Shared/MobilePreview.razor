        border-left: 1px solid #1f2937;
        display: flex;
        flex-direction: column;
    }

    .terminal-sidebar-header {
        padding: 10px 16px;
        background: #111827;
        color: #10b981; /* Emerald Green */
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #1f2937;
        font-family: 'Cascadia Code', monospace;
