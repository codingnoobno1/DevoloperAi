@using MudBlazor
@using Syncro.Desktop.Services
@using Syncro.Desktop.Services.ProgramLogic
@using DeveloperAI.BusinessLogic
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@using System.IO
@using Syncro.Desktop.Services.Engine.Core
@using Syncro.Desktop.Services.Engine.Context
@inject ILLMProvider LlmProvider
@inject ContextBuilder CtxBuilder
@inject ISessionManager SessionMgr
@inject IWorkspaceManager WorkspaceMgr
@inject ISnackbar Snackbar
@inject FlutterService FlutterSvc
@implements IDisposable

<MudDialog Class="mobile-preview-dialog">
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100 pr-4">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Smartphone" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Syncro Quick Preview</MudText>
                @if (!_isReady)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text">BUILDING...</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">LIVE</MudChip>
                }
            </div>
            <div class="d-flex align-center gap-2">
                <MudIconButton Icon="@Icons.Material.Filled.Bolt" Color="Color.Warning" Title="Hot Reload (r)" OnClick="TriggerHotReload" />
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Title="Hot Restart (R)" OnClick="TriggerHotRestart" />

                <MudToggleIconButton @bind-Toggled="_showAiAssistant"
                                    Icon="@Icons.Material.Filled.AutoAwesome"
                                    ToggledIcon="@Icons.Material.Filled.AutoAwesome"
                                    Color="Color.Default"
                                    ToggledColor="Color.Primary"
                                    Title="AI Assistant" />

                <MudToggleIconButton @bind-Toggled="_showTerminal"
                                    Icon="@Icons.Material.Filled.Terminal"
                                    ToggledIcon="@Icons.Material.Filled.Terminal"
                                    Color="Color.Default"
                                    ToggledColor="Color.Primary"
                                    Title="Show Terminal" />
                
                <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                    <MudButton OnClick='() => SetDevice("iphone")' Class="@(SelectedDevice == "iphone" ? "active" : "")">iPhone</MudButton>
                    <MudButton OnClick='() => SetDevice("pixel")' Class="@(SelectedDevice == "pixel" ? "active" : "")">Pixel</MudButton>
                    <MudButton OnClick='() => SetDevice("tablet")' Class="@(SelectedDevice == "tablet" ? "active" : "")">Tablet</MudButton>
                </MudButtonGroup>
                <MudToggleIconButton @bind-Toggled="_isLandscape"
                                    Icon="@Icons.Material.Filled.StayCurrentPortrait"
                                    ToggledIcon="@Icons.Material.Filled.StayCurrentLandscape"
                                    Color="Color.Default"
                                    ToggledColor="Color.Primary"
                                    Title="Portrait"
                                    ToggledTitle="Landscape" />
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="preview-layout">
            <div class="device-container">
                <div class="@GetDeviceClass()" style="@GetDeviceStyle()">
                    <!-- Notch / Camera Area -->
                    <div class="device-header">
                        <div class="speaker"></div>
                        <div class="camera"></div>
                    </div>

                    <!-- Status Bar -->
                    <div class="status-bar">
                        <span class="time">@DateTime.Now.ToString("HH:mm")</span>
                        <div class="icons">
                            <MudIcon Icon="@Icons.Material.Filled.NetworkCell" Size="Size.Small" />
                            <MudIcon Icon="@Icons.Material.Filled.Wifi" Size="Size.Small" />
                            <MudIcon Icon="@Icons.Material.Filled.BatteryFull" Size="Size.Small" />
                        </div>
                    </div>

                    <!-- Web Content (IFrame) -->
                    <div class="screen-content">
                        @if (_hasError)
                        {
                            <div class="d-flex flex-column align-center justify-center h-100 pa-6 text-center">
                                <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.subtitle1" Color="Color.Error" Class="font-weight-bold">Build Error</MudText>
                                <MudText Typo="Typo.caption" Class="mb-4">@_errorMessage</MudText>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Build" OnClick="RepairAndRetry">
                                    Repair & Retry
                                </MudButton>
                            </div>
                        }
                        else if (!_isReady)
                        {
                            <div class="d-flex flex-column align-center justify-center h-100 pa-8 text-center">
                                <div class="terminal-animation mb-6">
                                    <div class="terminal-header">
                                        <div class="dot red"></div>
                                        <div class="dot yellow"></div>
                                        <div class="dot green"></div>
                                        <span class="ml-2">flutter run -d web-server</span>
                                    </div>
                                    <div class="terminal-body" style="font-size: 10px;">
                                        @foreach (var log in _logs.TakeLast(5))
                                        {
                                            <code>@log</code>
                                        }
                                        <code class="cursor">_</code>
                                    </div>
                                </div>
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-4" />
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Compiling Flutter Web...</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">This usually takes 20-40 seconds for the first build.</MudText>
                            </div>
                        }
                        else
                        {
                            <iframe src="@PreviewUrl" class="mobile-iframe"></iframe>
                        }
                    </div>

                    <!-- Navigation Bar -->
                    <div class="nav-bar">
                        <MudIcon Icon="@Icons.Material.Filled.ArrowBackIosNew" Size="Size.Small" />
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" />
                        <MudIcon Icon="@Icons.Material.Filled.Square" Size="Size.Small" />
                    </div>
                </div>
            </div>

            @if (_showAiAssistant)
            {
                <div class="ai-sidebar">
                    <div class="ai-sidebar-header">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.button">AI Assistant</MudText>
                    </div>
                    <div class="ai-sidebar-body">
                        <MudTextField @bind-Value="_aiPrompt" Label="What should I build?"
                                    Variant="Variant.Outlined" Lines="4"
                                    Placeholder="e.g. Add a dark theme toggle..." />
                        
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   FullWidth="true" Class="mt-4"
                                   OnClick="ProcessAiRequest"
                                   Loading="_isAiLoading"
                                   StartIcon="@Icons.Material.Filled.AutoAwesome">
                            Generate & Apply
                        </MudButton>

                        @if (!string.IsNullOrEmpty(_aiStatus))
                        {
                            <MudAlert Severity="@(_aiError ? Severity.Error : Severity.Info)" Class="mt-4" Dense="true">
                                @_aiStatus
                            </MudAlert>
                        }

                        @if (_aiFilesGenerated > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mt-2 d-block">
                                ✅ Modified @_aiFilesGenerated files. Reloading...
                            </MudText>
                        }
                    </div>
                </div>
            }

            @if (_showTerminal)
            {
                <div class="terminal-sidebar">
                    <div class="terminal-sidebar-header">
                        <MudText Typo="Typo.button">Build Output</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.ClearAll" Size="Size.Small" OnClick="() => _logs.Clear()" />
                    </div>
                    <div class="terminal-sidebar-body" id="terminal-body">
                        @foreach (var log in _logs)
                        {
                            <div class="log-entry @GetLogClass(log)">@log</div>
                        }
                    </div>
                </div>
            }
        </div>
    </DialogContent>
</MudDialog>

<style>
