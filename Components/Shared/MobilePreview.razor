@code {
    [CascadingParameter] MudBlazor.IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string PreviewUrl { get; set; } = "";
    [Parameter] public string ProjectPath { get; set; } = "";

    private string SelectedDevice = "iphone";
    private bool _isLandscape = false;
    private bool _showTerminal = true;
    private bool _showAiAssistant = true;
    private bool _isReady = false;
    private bool _hasError = false;
    private string _errorMessage = "";
    private List<string> _logs = new();
    private System.Threading.Timer? _checkTimer;

    // AI Variables
    private string _aiPrompt = "";
    private string _aiStatus = "";
    private bool _isAiLoading = false;
    private bool _aiError = false;
    private int _aiFilesGenerated = 0;

    protected override void OnInitialized()
    {
        FlutterSvc.OnOutput += HandleOutput;
        
        // Start polling for URL readiness
        _checkTimer = new System.Threading.Timer(async _ => await CheckUrl(), null, 2000, 2000);
    }

    private async Task ProcessAiRequest()
    {
        if (string.IsNullOrWhiteSpace(_aiPrompt)) return;

        _isAiLoading = true;
        _aiStatus = "AI is thinking...";
        _aiError = false;
        _aiFilesGenerated = 0;
        StateHasChanged();

        try
        {
            // Initialize Workspace & Session if not already done
            WorkspaceMgr.SetWorkspace(ProjectPath);
            await SessionMgr.InitializeSessionAsync(ProjectPath);

            // Record the user prompt to memory
            await SessionMgr.RecordInteractionAsync(_aiPrompt, "Processing requested feature...");

            // Build Context (Hindsight + Workspace summary)
            string systemContext = await CtxBuilder.BuildSystemPromptAsync(ProjectPath);
            
            // Append format instruction strictly since we need JSON
            systemContext += "\nCRITICAL: Respond ONLY with VALID JSON matching this schema: { \"explanation\": \"summary\", \"changes\": [ { \"type\": \"modify|create|delete\", \"path\": \"relative/path\", \"content\": \"...\" } ] }. DO NOT return markdown.";

            // Call Groq / LLM natively
            string response = await LlmProvider.GenerateResponseAsync(systemContext, _aiPrompt);
            
            // Record the LLM response to memory
            await SessionMgr.RecordInteractionAsync("LLM Output Received", "Parsed response successfully.");

            if (string.IsNullOrEmpty(response))
            {
                _aiStatus = "AI returned empty response.";
                _aiError = true;
                return;
            }

            // Clean the response (extract JSON from markdown or extra text)
            string cleanedResponse = response.Trim();
            
            // Find the first '{' and last '}'
            int firstBrace = cleanedResponse.IndexOf('{');
            int lastBrace = cleanedResponse.LastIndexOf('}');
            
            if (firstBrace >= 0 && lastBrace > firstBrace)
            {
                cleanedResponse = cleanedResponse.Substring(firstBrace, (lastBrace - firstBrace) + 1);
            }
            else 
            {
                // Fallback to existing cleaning if braces not found or malformed
                if (cleanedResponse.StartsWith("```json"))
                {
                    cleanedResponse = cleanedResponse.Substring(7);
                    if (cleanedResponse.EndsWith("```")) cleanedResponse = cleanedResponse.Substring(0, cleanedResponse.Length - 3);
                }
                else if (cleanedResponse.StartsWith("```"))
                {
                    cleanedResponse = cleanedResponse.Substring(3);
                    if (cleanedResponse.EndsWith("```")) cleanedResponse = cleanedResponse.Substring(0, cleanedResponse.Length - 3);
                }
            }
            cleanedResponse = cleanedResponse.Trim();

            // 1. Parse and Validate JSON
            JObject json;
            try 
            {
                json = JObject.Parse(cleanedResponse);
                if (!ValidateAiResponse(json))
                {
                    _aiStatus = "AI returned an invalid JSON structure.";
                    _aiError = true;
                    _logs.Add("ERR: Invalid JSON structure from AI.");
                    _logs.Add($"DEBUG: {cleanedResponse}");
                    return;
                }
            }
            catch (JsonException ex)
            {
                _aiStatus = $"JSON Parse Error: {ex.Message}";
                _aiError = true;
                _logs.Add($"ERR: JSON Parsing failed. {ex.Message}");
                _logs.Add($"DEBUG: {cleanedResponse}");
                return;
            }

            var changes = json["changes"] as JArray;
            var changedFiles = new List<string>();

            if (changes != null)
            {
                // 2. Transactional Write (all or nothing - simulated by writing to disk)
                foreach (var change in changes)
                {
                    var type = change["type"]?.ToString();
                    var path = change["path"]?.ToString();
                    var content = change["content"]?.ToString();

                    if (!string.IsNullOrEmpty(path))
                    {
                        var fullPath = Path.Combine(ProjectPath, path);
                        
                        if (type == "delete")
                        {
                            if (File.Exists(fullPath)) File.Delete(fullPath);
                        }
                        else if (content != null)
                        {
                            var directory = Path.GetDirectoryName(fullPath);
                            if (!Directory.Exists(directory)) Directory.CreateDirectory(directory!);
                            await File.WriteAllTextAsync(fullPath, content);
                        }

                        changedFiles.Add(path);
                        _aiFilesGenerated++;
                    }
                }

                _aiStatus = json["explanation"]?.ToString() ?? "Applied changes successfully.";
                
                // 3. Smart Reload
                await FlutterSvc.SmartReload(changedFiles);
            }
        }
        catch (Exception ex)
        {
            _aiStatus = $"System Error: {ex.Message}";
            _aiError = true;
        }
        finally
        {
            _isAiLoading = false;
            StateHasChanged();
        }
    }

    private bool ValidateAiResponse(JObject json)
    {
        // Check core structure
        if (json["changes"] == null || json["changes"] is not JArray) return false;
        
        var changes = json["changes"] as JArray;
        foreach (var change in changes!)
        {
            // Validate each change item
            var type = change["type"]?.ToString();
            var path = change["path"]?.ToString();
            
            if (string.IsNullOrEmpty(type) || string.IsNullOrEmpty(path)) return false;
            
            // For modify/create, content is required
            if (type != "delete" && change["content"] == null) return false;
        }

        return true;
    }

    private async Task TriggerHotReload() => await FlutterSvc.HotReload();
    private async Task TriggerHotRestart() => await FlutterSvc.HotRestart();

    private string GetLogClass(string log)
    {
        if (log.Contains("ERR:", StringComparison.OrdinalIgnoreCase)) return "error";
        if (log.Contains("Reload", StringComparison.OrdinalIgnoreCase)) return "reload";
        if (log.Contains("Restart", StringComparison.OrdinalIgnoreCase)) return "restart";
        if (log.Contains("✅") || log.Contains("success", StringComparison.OrdinalIgnoreCase)) return "success";
        if (log.Contains("🔥") || log.Contains("🔄")) return "special";
        return "";
    }

    private void HandleOutput(string message)
    {
        InvokeAsync(() =>
        {
            _logs.Add(message);
            if (_logs.Count > 100) _logs.RemoveAt(0);
            
            if (message.Contains("localhost:5000") || message.Contains("is now available"))
            {
                _isReady = true;
            }

            if (message.Contains("failed to delete a directory") || message.Contains("cannot access the file"))
            {
                _hasError = true;
                _errorMessage = "Build folder is locked. Click Repair to fix.";
            }

            StateHasChanged();
        });
    }

    private async Task RepairAndRetry()
    {
        _hasError = false;
        _logs.Clear();
        _logs.Add("Attempting repair...");
        
        await FlutterSvc.CleanProject(ProjectPath);
        await FlutterSvc.RunProject(ProjectPath, "web");
        
        StateHasChanged();
    }

    private async Task CheckUrl()
    {
        if (_isReady) return;

        try
        {
            using var client = new System.Net.Http.HttpClient();
            client.Timeout = TimeSpan.FromSeconds(1);
            var response = await client.GetAsync(PreviewUrl);
            if (response.IsSuccessStatusCode)
            {
                _isReady = true;
                await InvokeAsync(StateHasChanged);
                _checkTimer?.Dispose();
            }
        }
        catch { /* Not ready yet */ }
    }

    private void SetDevice(string device) => SelectedDevice = device;

    private string GetDeviceClass() => $"device-frame";

    private string GetDeviceStyle()
    {
        int w = 375, h = 812;
        
        switch (SelectedDevice)
        {
            case "iphone": w = 375; h = 812; break;
            case "pixel": w = 412; h = 915; break;
            case "tablet": w = 768; h = 1024; break;
        }

        if (_isLandscape)
        {
            var temp = w;
            w = h;
            h = temp;
        }

        return $"width: {w}px; height: {h}px;";
    }

    public void Dispose()
    {
        FlutterSvc.OnOutput -= HandleOutput;
        _checkTimer?.Dispose();
    }
}
