    .log-entry.reload { color: #fbbf24; } /* Amber for reload */
    .log-entry.restart { color: #60a5fa; } /* Blue for restart */
    .log-entry.success { color: #34d399; } /* Green for success */
    .log-entry.special { color: #818cf8; font-weight: bold; }

